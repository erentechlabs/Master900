# -----------------------------------------------------------------------------
# Microsoft Fundamentals Academy - environment variables
# Copy to .env and adjust. Never commit real secrets.
# -----------------------------------------------------------------------------

# PostgreSQL connection string.
# - `npm run db:start` (embedded PostgreSQL, no Docker):  postgresql://academy:academy@localhost:5433/fundamentals_academy
# - `docker compose up db`:                               postgresql://academy:academy@localhost:5432/fundamentals_academy
DATABASE_URL="postgresql://academy:academy@localhost:5433/fundamentals_academy"

# NextAuth / Auth.js. Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
# Public base URL of the app (used for links and calendar exports)
APP_URL="http://localhost:3000"
# Session lifetime in hours
SESSION_MAX_AGE_HOURS="8"

# AI tutor provider: "mock" (local, grounded, no external calls) or "openai" (any OpenAI-compatible endpoint,
# e.g. OpenAI, Azure OpenAI v1 endpoint, Ollama or LM Studio). The key is only read from the environment.
AI_PROVIDER="mock"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"
AI_TIMEOUT_MS="20000"

# Object storage for uploaded media: "local" writes to STORAGE_LOCAL_DIR
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

# Logging: debug | info | warn | error
LOG_LEVEL="info"

# Allow new learner registrations
REGISTRATION_ENABLED="true"

# Seeding (npm run db:seed)
# SEED_DEMO_USERS="false"        # skip demo accounts/activity (recommended for real deployments)
# SEED_MODE="if-empty"           # only seed when the database has no catalog yet (never overwrites CMS edits)
# ADMIN_EMAIL="admin@your-org.example"   # bootstrap administrator when demo users are disabled
# ADMIN_PASSWORD=""              # 12+ characters; remove after the first run
