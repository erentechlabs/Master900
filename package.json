{
  "name": "fundamentals-academy",
  "version": "0.1.0",
  "private": true,
  "description": "Microsoft Fundamentals Academy - an independent learning and exam-preparation platform for Microsoft foundational-level certifications.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "tsx scripts/dev-db.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "worker": "tsx --require ./scripts/server-only-shim.cjs scripts/worker.ts",
    "content:validate": "tsx scripts/validate-content.ts",
    "postinstall": "prisma generate",
    "test:flows": "tsx --require ./scripts/server-only-shim.cjs scripts/integration-flows.ts",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "prisma": {
    "seed": "tsx --require ./scripts/server-only-shim.cjs prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "bcryptjs": "3.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "next": "16.3.6",
    "next-auth": "4.24.15",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "2.6.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "optionalDependencies": {
    "embedded-postgres": "17.10.0-beta.17"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true,
    "@embedded-postgres/windows-x64@17.10.0-beta.17": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
