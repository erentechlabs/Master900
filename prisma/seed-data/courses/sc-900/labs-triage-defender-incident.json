,"Incidents","Assets"],"navItem":"incidents","commands":[{"id":"disable-user","label":"Mark user as compromised","icon":"UserX","variant":"danger","action":{"type":"navigate","page":"disable-user-page"}}],"components":[{"kind":"properties","title":"User details","items":[{"label":"User","value":"{{$sel.asset.name}}"},{"label":"Risk","value":"{{$sel.asset.risk}}"},{"label":"Status","value":"{{$sel.asset.status}}"},{"label":"Mail","value":"maya@contoso.example"}]}]},{"id":"disable-user-page","title":"Mark user as compromised","subtitle":"{{$sel.asset.name}}","icon":"UserX","requires":"asset","url":"/users/{{$sel.asset.name | slug}}/compromised","navItem":"incidents","components":[{"kind":"form","id":"disable-user-form","title":"Mark user as compromised","fields":[{"id":"disableAccount","label":"Disable user in Microsoft Entra ID","control":"toggle","required":true,"defaultValue":true},{"id":"comment","label":"Comment","control":"textarea","required":true,"defaultValue":"User opened the phishing attachment; disable pending password reset and review."}],"submit":{"label":"Confirm","checks":[{"rule":{"type":"equals","path":"$form.disableAccount","value":true},"message":"Disable the user account."}],"actions":[{"type":"update","path":"incidents","where":{"id":"INC-2026-0930-004"},"set":{"response.userDisabled":true,"assets.1.status":"Disabled"}},{"type":"notify","title":"User marked as compromised","message":"Maya is disabled pending recovery."},{"type":"navigate","page":"incident-assets"}]}}]},{"id":"email-page","title":"{{$sel.email.name}}","subtitle":"Email entity","icon":"Mail","requires":"email","url":"/emailentity/{{$sel.email.id}}","breadcrumb":["Home","Incidents","Evidence and response"],"navItem":"incidents","commands":[{"id":"email-soft-delete","label":"Soft delete","icon":"Trash2","variant":"danger","action":{"type":"sequence","actions":[{"type":"update","path":"incidents","where":{"id":"INC-2026-0930-004"},"set":{"response.emailRemoved":true,"evidence.0.action":"Soft deleted"}},{"type":"notify","title":"Email remediated","message":"The phishing email was soft-deleted."}]}}],"components":[{"kind":"properties","title":"Email details","items":[{"label":"Subject","value":"{{$sel.email.name}}"},{"label":"Sender","value":"billing@fabrikam.example"},{"label":"Latest delivery location","value":"Inbox"},{"label":"Attachment","value":"invoice-review.docm"},{"label":"Verdict","value":"{{$sel.email.verdict}}"}]}]},{"id":"resolve-page","title":"Resolve incident","subtitle":"{{$sel.incident.id}}","icon":"CircleCheck","requires":"incident","url":"/incidents/{{$sel.incident.id}}/resolve","navItem":"incidents","components":[{"kind":"form","id":"resolve-form","title":"Resolve incident","fields":[{"id":"classification","label":"Classification","control":"select","required":true,"defaultValue":"True positive","options":[{"value":"True positive","label":"True positive"},{"value":"False positive","label":"False positive"},{"value":"Informational, expected activity","label":"Informational, expected activity"}]},{"id":"determination","label":"Determination","control":"select","required":true,"defaultValue":"Phishing","options":[{"value":"Phishing","label":"Phishing"},{"value":"Malware","label":"Malware"},{"value":"Security testing","label":"Security testing"}]},{"id":"comment","label":"Comment","control":"textarea","required":true,"minLength":20,"defaultValue":"Contained device, disabled compromised user, and soft-deleted phishing email."}],"submit":{"label":"Resolve","checks":[{"rule":{"type":"equals","path":"$form.classification","value":"True positive"},"message":"This incident contains confirmed malicious activity."},{"rule":{"type":"equals","path":"$form.determination","value":"Phishing"},"message":"Use Phishing for this email-led incident."}],"actions":[{"type":"update","path":"incidents","where":{"id":"INC-2026-0930-004"},"set":{"status":"Resolved","classification":"True positive","determination":"Phishing","resolved":true,"resolutionComment":"{{$form.comment}}"}},{"type":"notify","title":"Incident resolved","message":"Incident INC-2026-0930-004 is resolved."},{"type":"navigate","page":"incident-summary"}]}}]},{"id":"incident-activities","title":"{{$sel.incident.title}} | Activities","requires":"incident","url":"/incidents/{{$sel.incident.id}}/activities","navItem":"incidents","components":[{"kind":"table","id":"activity-list","source":"$sel.incident.activities","rowKey":"id","columns":[{"key":"time","label":"Time"},{"key":"activity","label":"Activity"},{"key":"actor","label":"Performed by"}]}]},{"id":"alerts","title":"Alerts","url":"/alerts","components":[{"kind":"callout","variant":"info","text":"Use the incident queue for this lab."}]},{"id":"secure-score","title":"Secure Score","url":"/securescore","components":[{"kind":"callout","variant":"info","text":"Secure Score summarizes posture improvements; incident containment is the priority."}]}],"initialState":{"incidents":[{"id":"INC-2026-0930-001","title":"Unfamiliar sign-in followed by inbox rule creation","severity":"Medium","status":"New","assignedTo":"Unassigned","classification":"Not set","determination":"Not set","assigned":false,"resolved":false,"alerts":[{"id":"A-101","name":"Suspicious inbox rule","severity":"Medium","source":"Defender for Office 365","status":"New"}],"assets":[{"name":"Nora","type":"User","risk":"Medium","status":"Active"}],"evidence":[],"response":{},"activities":[]},{"id":"INC-2026-0930-002","title":"Impossible travel sign-in blocked by conditional access","severity":"Low","status":"Resolved","assignedTo":"Priya","classification":"True positive","determination":"Suspicious activity","assigned":true,"resolved":true,"alerts":[{"id":"A-201","name":"Risky sign-in","severity":"Low","source":"Microsoft Entra ID Protection","status":"Resolved"}],"assets":[{"name":"Ibrahim","type":"User","risk":"Low","status":"Active"}],"evidence":[],"response":{},"activities":[]},{"id":"INC-2026-0930-003","title":"Cloud app OAuth consent anomaly","severity":"Medium","status":"In progress","assignedTo":"Alex","classification":"Not set","determination":"Not set","assigned":true,"resolved":false,"alerts":[{"id":"A-301","name":"Suspicious OAuth app","severity":"Medium","source":"Defender for Cloud Apps","status":"In progress"}],"assets":[{"name":"App: Contoso Reports","type":"Cloud app","risk":"Medium","status":"Investigating"}],"evidence":[],"response":{},"activities":[]},{"id":"INC-2026-0930-004","title":"Multi-stage phishing and endpoint activity","severity":"High","status":"New","assignedTo":"Unassigned","classification":"Not set","determination":"Not set","assigned":false,"resolved":false,"alerts":[{"id":"A-401","name":"Phish delivered to mailbox","severity":"High","source":"Defender for Office 365","status":"New"},{"id":"A-402","name":"Suspicious attachment opened","severity":"High","source":"Defender for Office 365","status":"New"},{"id":"A-403","name":"Suspicious PowerShell command line","severity":"High","source":"Defender for Endpoint","status":"New"},{"id":"A-404","name":"Connection to suspicious documentation-range IP","severity":"Medium","source":"Defender for Endpoint","status":"New"}],"assets":[{"name":"DESKTOP-FIN-07","type":"Device","risk":"High","status":"Active"},{"name":"Maya","type":"User","risk":"High","status":"Active"},{"name":"Maya mailbox","type":"Mailbox","risk":"Medium","status":"Active"}],"evidence":[{"id":"MSG-880214","name":"Invoice review needed","entityType":"Email","verdict":"Phish","action":"No action"},{"id":"FILE-1940","name":"invoice-review.docm","entityType":"File","verdict":"Suspicious","action":"Contained by device isolation"},{"id":"IP-203-0-113-50","name":"203.0.113.50","entityType":"IP address","verdict":"Suspicious","action":"Blocked by isolation"}],"response":{"deviceIsolated":false,"userDisabled":false,"emailRemoved":false},"activities":[{"id":"ACT-1","time":"11:00","activity":"Incident created from correlated alerts","actor":"Microsoft Defender XDR"}]},{"id":"INC-2026-0930-005","title":"Endpoint malware remediation completed","severity":"Medium","status":"Resolved","assignedTo":"Mehmet","classification":"True positive","determination":"Malware","assigned":true,"resolved":true,"alerts":[{"id":"A-501","name":"Suspicious file quarantined","severity":"Medium","source":"Defender for Endpoint","status":"Resolved"}],"assets":[{"name":"LAPTOP-SALES-12","type":"Device","risk":"Low","status":"Remediated"}],"evidence":[],"response":{},"activities":[]}]}},"steps":[{"key":"open-incident","title":"Open the high-severity incident","instruction":"Open **Incidents**, then select **Multi-stage phishing and endpoint activity** from the incident queue.","hint":"Choose the High severity incident with multiple related alerts.","explanation":"Incidents correlate related alerts into one investigation story.","targetId":"incident-queue","rules":[{"key":"visited-incident","description":"Incident summary opened","rule":{"type":"visited","page":"incident-summary"}}]},{"key":"assign-progress","title":"Assign and set the incident in progress","instruction":"Select **Assign to me**, then **Set status: In progress**.","hint":"Ownership and status help the SOC coordinate work.","explanation":"Assigning an incident makes accountability clear; In progress shows active triage.","targetId":"assign-me","rules":[{"key":"assigned-progress","description":"Incident assigned to Alex","rule":{"type":"arrayContains","path":"incidents","match":{"id":"INC-2026-0930-004","assignedTo":"Alex","assigned":true}},"failureFeedback":"Assign the incident to yourself before continuing."}]},{"key":"review-tabs","title":"Review alerts, assets, and evidence","instruction":"Review the **Alerts**, **Assets**, and **Evidence and response** tabs to understand the attack story and affected entities.","hint":"The tabs show alert chronology, impacted users/devices/mailboxes, and response-ready evidence.","explanation":"A Defender XDR incident brings together alerts, assets, evidence, and response actions in one context.","targetId":"alert-list","rules":[{"key":"reviewed-tabs","description":"Reviewed incident investigation tabs","rule":{"type":"allOf","rules":[{"type":"visited","page":"incident-alerts"},{"type":"visited","page":"incident-assets"},{"type":"visited","page":"incident-evidence"}]},"failureFeedback":"Visit Alerts, Assets, and Evidence and response."}]},{"key":"isolate-device","title":"Isolate the impacted device","instruction":"On **Assets**, open **DESKTOP-FIN-07**, select **Isolate device**, choose **Full isolation**, add a comment, and confirm.","hint":"Contain the endpoint before resolving.","explanation":"Device isolation helps stop command-and-control and lateral movement.","targetId":"isolate-device","rules":[{"key":"device-isolated","description":"DESKTOP-FIN-07 is isolated","rule":{"type":"arrayContains","path":"incidents","match":{"id":"INC-2026-0930-004","response.deviceIsolated":true}},"failureFeedback":"Open DESKTOP-FIN-07 and confirm Full isolation."}]},{"key":"contain-user-email","title":"Contain the user and phishing email","instruction":"Open the **Maya** user asset and select **Mark user as compromised** with **Disable user in Microsoft Entra ID** on. Then open the phishing email evidence **Invoice review needed** and select **Soft delete**.","hint":"The user and email are separate entities.","explanation":"Contain compromised identity access and remove the malicious message before closing the case.","targetId":"disable-user","rules":[{"key":"user-email-contained","description":"User disabled and phishing email soft-deleted","rule":{"type":"arrayContains","path":"incidents","match":{"id":"INC-2026-0930-004","response.userDisabled":true,"response.emailRemoved":true}},"failureFeedback":"Disable Maya and soft-delete the phishing email."}]},{"key":"resolve","title":"Resolve with the correct classification","instruction":"Return to the incident summary, select **Resolve incident**, set **Classification** to **True positive**, **Determination** to **Phishing**, add a comment, and select **Resolve**.","hint":"False positive is wrong because the incident has confirmed malicious activity.","explanation":"Resolution records the incident outcome for metrics, tuning, and later review.","targetId":"resolve-incident","rules":[{"key":"resolved-true-positive","description":"Incident resolved as true positive phishing","rule":{"type":"arrayContains","path":"incidents","match":{"id":"INC-2026-0930-004","status":"Resolved","classification":"True positive","determination":"Phishing","resolved":true}},"failureFeedback":"Resolve only after containment, and classify as True positive / Phishing."}]}],"finalRules":[{"key":"final-contained-resolved","description":"Device isolated, incident assigned, and incident resolved as true positive","rule":{"type":"arrayContains","path":"incidents","match":{"id":"INC-2026-0930-004","assignedTo":"Alex","response.deviceIsolated":true,"status":"Resolved","classification":"True positive"}},"successFeedback":"The incident was contained and resolved correctly.","failureFeedback":"Assign the incident, isolate the device, and resolve as True positive."},{"key":"final-user-email","description":"Compromised user disabled and phishing email removed","rule":{"type":"arrayContains","path":"incidents","match":{"id":"INC-2026-0930-004","response.userDisabled":true,"response.emailRemoved":true}},"successFeedback":"Identity and email containment actions are complete.","failureFeedback":"Disable the user and soft-delete the phishing email before resolving."}],"solution":"1. Open **Incidents** and select **Multi-stage phishing and endpoint activity**.\n2. Select **Assign to me**, then **Set status: In progress**.\n3. Review **Alerts**, **Assets**, and **Evidence and response**.\n4. On **Assets**, open **DESKTOP-FIN-07**, select **Isolate device**, choose **Full isolation**, enter a comment, and select **Confirm**.\n5. On **Assets**, open **Maya**, select **Mark user as compromised**, keep **Disable user in Microsoft Entra ID** on, enter a comment, and select **Confirm**.\n6. On **Evidence and response**, open **Invoice review needed** and select **Soft delete**.\n7. Return to the incident summary, select **Resolve incident**, choose **True positive** and **Phishing**, add a containment comment, and select **Resolve**."}]}
