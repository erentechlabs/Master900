{"labs":[{"slug":"triage-defender-incident","type":"UI_SIMULATION","title":"Triage and resolve a Microsoft Defender XDR incident","summary":"Use a simulated Microsoft Defender portal to assign, investigate, contain, and resolve a high-severity multi-stage incident.","scenario":"Contoso's security operations team received a high-severity Microsoft Defender XDR incident that correlates a phishing email, a user opening an attachment, suspicious PowerShell on **DESKTOP-FIN-07**, and a connection to **203.0.113.50**. In the **simulated Microsoft Defender portal**, open the incident, assign it to yourself, set it in progress, review alerts, assets, and evidence, isolate the device with full isolation, disable the compromised user, soft-delete the phishing email, then resolve as a true positive phishing incident.","domainKey":"security-solutions","objectiveCode":"3.4","complexity":"INTERMEDIATE","estimatedMinutes":35,"learningObjectives":["Triage a correlated Microsoft Defender XDR incident","Use incident tabs to review alerts, assets, evidence, and response context","Contain impacted entities before resolving an incident as a true positive"],"prerequisites":["Know that Microsoft Defender XDR correlates signals across endpoints, identity, email, cloud apps, and collaboration workloads."],"sources":[{"title":"Investigate incidents in the Microsoft Defender portal","url":"https://learn.microsoft.com/en-us/defender-xdr/investigate-incidents"},{"title":"Investigate incident cases in the Microsoft Defender portal","url":"https://learn.microsoft.com/en-us/defender-xdr/investigate-incident-cases"},{"title":"Take response actions on a device","url":"https://learn.microsoft.com/en-us/defender-endpoint/respond-machine-alerts"},{"title":"The Email entity page in Defender for Office 365","url":"https://learn.microsoft.com/en-us/defender-office-365/mdo-email-entity-page"}],"config":{"portal":{"name":"Microsoft Defender","theme":"defender","user":"alex@contoso.example","tenant":"Contoso (contoso.example)","url":"https://security.microsoft.com","searchPlaceholder":"Search Microsoft Defender"},"vm":{"name":"LAB-VM-01","os":"windows","apps":["browser"]},"clock":{"start":"2026-09-30T11:00:00Z"},"startPage":"home","navigation":[{"page":"home","label":"Home","icon":"Home"},{"page":"incidents","label":"Incidents","icon":"Siren","section":"Investigation & response > Incidents & alerts"},{"page":"alerts","label":"Alerts","icon":"Bell","section":"Investigation & response > Incidents & alerts"},{"page":"secure-score","label":"Secure Score","icon":"Gauge","section":"Exposure management"}],"pages":[{"id":"home","title":"Home","url":"/home","components":[{"kind":"tiles","id":"defender-home","title":"Security operations","items":[{"id":"incidents-tile","label":"Incidents","description":"Correlated alerts and evidence across Microsoft Defender XDR.","icon":"Siren","action":{"type":"navigate","page":"incidents"}},{"id":"advanced-hunting","label":"Advanced hunting","description":"Query security data across workloads.","icon":"Search","action":{"type":"message","tone":"info","text":"Advanced hunting is not required."}},{"id":"sentinel","label":"Microsoft Sentinel","description":"SIEM and SOAR for cloud-native security operations.","icon":"Shield","action":{"type":"message","tone":"info","text":"Microsoft Sentinel is SIEM/SOAR; this lab focuses on Defender XDR."}}]}]},{"id":"incidents","title":"Incidents","subtitle":"Incidents & alerts","icon":"Siren","url":"/incidents","breadcrumb":["Home","Investigation & response","Incidents & alerts"],"navItem":"incidents","commands":[{"id":"incidents-refresh","label":"Refresh","icon":"RefreshCw","action":{"type":"message","tone":"info","text":"Incident queue refreshed."}}],"components":[{"kind":"table","id":"incident-queue","title":"Incident queue","source":"incidents","rowKey":"id","searchable":true,"columns":[{"key":"title","label":"Incident name","format":"link"},{"key":"severity","label":"Severity","format":"badge"},{"key":"