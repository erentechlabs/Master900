{
  "labs": [
    {
      "slug": "conditional-access-require-mfa",
      "type": "UI_SIMULATION",
      "title": "Require MFA with a Conditional Access policy",
      "summary": "Build and test a report-only Conditional Access policy that requires MFA while excluding emergency access accounts.",
      "scenario": "Contoso wants finance users to use multifactor authentication when accessing cloud resources, but the security team must avoid locking out emergency access accounts. In the **simulated Microsoft Entra admin center** on your lab VM, create a Conditional Access policy named **CA-Finance-Require-MFA**. Include **All finance users**, exclude **Emergency Access Accounts**, target **All resources (formerly 'All cloud apps')**, require the built-in **Multifactor authentication strength**, and leave the policy in **Report-only** while it is tested. Then use **What If** to simulate access for Mira.",
      "domainKey": "microsoft-entra",
      "objectiveCode": "2.2",
      "complexity": "BASIC",
      "estimatedMinutes": 25,
      "learningObjectives": [
        "Explain how Conditional Access uses signals, decisions, and enforcement controls",
        "Create an MFA policy in report-only mode before enforcing it",
        "Protect emergency access accounts from accidental lockout"
      ],
      "prerequisites": ["Know that security defaults are broad tenant protections and Conditional Access is policy-based access control"],
      "sources": [
        { "title": "Require MFA for all users with Conditional Access", "url": "https://learn.microsoft.com/en-us/entra/identity/conditional-access/policy-all-users-mfa-strength" },
        { "title": "The Conditional Access What If tool", "url": "https://learn.microsoft.com/en-us/entra/identity/conditional-access/what-if-tool" },
        { "title": "Manage emergency access admin accounts", "url": "https://learn.microsoft.com/en-us/entra/identity/role-based-access-control/security-emergency-access" }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Entra admin center",
          "theme": "entra",
          "user": "alex@contoso.example",
          "tenant": "Contoso (contoso.example)",
          "url": "https://entra.microsoft.com",
          "searchPlaceholder": "Search resources, services, and docs"
        },
        "vm": { "name": "LAB-VM-01", "os": "windows", "apps": ["browser"] },
        "clock": { "start": "2026-09-30T10:00:00Z" },
        "startPage": "home",
