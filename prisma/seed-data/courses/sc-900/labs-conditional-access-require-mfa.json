          {
            "id": "policy-create",
            "title": "New Conditional Access policy",
            "icon": "ShieldPlus",
            "url": "/#view/Microsoft_AAD_ConditionalAccess/PolicyBlade/~/NewPolicy",
            "navItem": "conditional-access",
            "breadcrumb": ["Home", "Protection", "Conditional Access", "Policies"],
            "components": [
              {
                "kind": "wizard",
                "id": "ca-policy-wizard",
                "description": "Define assignments, target resources, controls, and policy state. Report-only mode records policy impact without enforcing access.",
                "reviewLabel": "Create",
                "tabs": [
                  { "id": "name", "label": "Name", "fields": [{ "id": "name", "label": "Name", "control": "text", "required": true, "defaultValue": "CA-Finance-Require-MFA", "unique": { "path": "conditionalAccessPolicies", "key": "name", "message": "A Conditional Access policy with this name already exists." } }] },
                  {
                    "id": "users",
                    "label": "Users",
                    "description": "Select who the policy applies to and who is excluded.",
                    "fields": [
                      { "id": "include", "label": "Include", "control": "radio", "required": true, "defaultValue": "All finance users", "options": [{ "value": "All users", "label": "All users" }, { "value": "All finance users", "label": "Select users and groups > All finance users" }, { "value": "Selected admins", "label": "Selected admins only" }] },
                      { "id": "excludeEmergency", "label": "Exclude Emergency Access Accounts", "control": "toggle", "defaultValue": false, "help": "Emergency access accounts are break-glass accounts monitored outside normal sign-in policy paths." },
                      { "id": "excludedGroup", "label": "Excluded group", "control": "select", "required": true, "visibleWhen": { "type": "equals", "path": "$form.excludeEmergency", "value": true }, "defaultValue": "Emergency Access Accounts", "optionsFrom": { "path": "groups", "value": "name", "label": "name" } }
                    ]
                  },
                  {
                    "id": "resources",
                    "label": "Target resources",
                    "fields": [
                      { "id": "targetResources", "label": "Resources (formerly cloud apps)", "control": "radio", "required": true, "defaultValue": "All resources", "options": [{ "value": "All resources", "label": "All resources (formerly 'All cloud apps')" }, { "value": "Office 365", "label": "Office 365" }, { "value": "Microsoft Admin Portals", "label": "Microsoft Admin Portals" }] }
                    ]
                  },
                  {
                    "id": "conditions",
                    "label": "Conditions",
                    "description": "Conditions are optional in this baseline finance policy. They can add signals such as locations or device platforms.",
                    "fields": [
                      { "id": "devicePlatforms", "label": "Device platforms", "control": "select", "required": true, "defaultValue": "Any device", "options": [{ "value": "Any device", "label": "Any device" }, { "value": "Windows", "label": "Windows" }, { "value": "iOS and Android", "label": "iOS and Android" }] },
                      { "id": "locations", "label": "Locations", "control": "select", "required": true, "defaultValue": "Any location", "options": [{ "value": "Any location", "label": "Any location" }, { "value": "All trusted locations", "label": "All trusted locations" }, { "value": "Selected locations", "label": "Selected locations" }] }
                    ]
                  },
                  {
                    "id": "grant",
                    "label": "Grant",
                    "fields": [
                      { "id": "grantDecision", "label": "Grant", "control": "radio", "required": true, "defaultValue": "Grant access", "options": [{ "value": "Grant access", "label": "Grant access" }, { "value": "Block access", "label": "Block access" }] },
                      { "id": "grantControl", "label": "Require", "control": "select", "required": true, "defaultValue": "Require authentication strength: Multifactor authentication", "options": [{ "value": "Require authentication strength: Multifactor authentication", "label": "Require authentication strength: Multifactor authentication" }, { "value": "Require multifactor authentication", "label": "Require multifactor authentication" }, { "value": "Require compliant device", "label": "Require compliant device" }] }
                    ]
                  },
                  {
                    "id": "session",
                    "label": "Session",
                    "description": "Session controls are optional for this lab.",
                    "fields": [
                      { "id": "signInFrequency", "label": "Sign-in frequency", "control": "select", "required": true, "defaultValue": "Not configured", "options": [{ "value": "Not configured", "label": "Not configured" }, { "value": "Every time", "label": "Every time" }, { "value": "Every 8 hours", "label": "Every 8 hours" }] }
                    ]
                  },
                  {
                    "id": "enable",
                    "label": "Enable policy",
                    "fields": [
                      { "id": "state", "label": "Enable policy", "control": "radio", "required": true, "defaultValue": "Report-only", "options": [{ "value": "Off", "label": "Off" }, { "value": "Report-only", "label": "Report-only" }, { "value": "On", "label": "On" }] }
                    ]
                  }
                ],
                "submit": {
                  "label": "Create",
                  "checks": [
                    { "rule": { "type": "equals", "path": "$form.include", "value": "All finance users" }, "message": "Target the All finance users group for this scenario rather than every user in the tenant." },
                    { "rule": { "type": "equals", "path": "$form.excludeEmergency", "value": true }, "message": "Exclude Emergency Access Accounts to avoid accidental lockout." },
                    { "rule": { "type": "equals", "path": "$form.excludedGroup", "value": "Emergency Access Accounts" }, "message": "Choose Emergency Access Accounts as the excluded group." },
                    { "rule": { "type": "equals", "path": "$form.targetResources", "value": "All resources" }, "message": "Use All resources (formerly 'All cloud apps') for the baseline finance MFA policy." },
                    { "rule": { "type": "equals", "path": "$form.grantDecision", "value": "Grant access" }, "message": "Grant access and require MFA. Blocking access would deny the finance users entirely." },
                    { "rule": { "type": "oneOf", "path": "$form.grantControl", "values": ["Require authentication strength: Multifactor authentication", "Require multifactor authentication"] }, "message": "Require MFA using authentication strength or the MFA grant control." },
                    { "rule": { "type": "equals", "path": "$form.state", "value": "Report-only" }, "message": "The security team wants to test first. Use Report-only, not On." }
                  ],
                  "actions": [
                    { "type": "append", "path": "conditionalAccessPolicies", "unique": "name", "value": { "name": "{{$form.name}}", "include": "{{$form.include}}", "exclude": "{{$form.excludedGroup}}", "excludeEmergency": "{{$form.excludeEmergency}}", "targetResources": "{{$form.targetResources}}", "devicePlatforms": "{{$form.devicePlatforms}}", "locations": "{{$form.locations}}", "grant": "{{$form.grantControl}}", "grantDecision": "{{$form.grantDecision}}", "session": "{{$form.signInFrequency}}", "state": "{{$form.state}}", "createdAt": "{{$now}}" } },
                    { "type": "notify", "title": "Policy created in report-only mode", "message": "{{$form.name}} will be evaluated but not enforced until enabled." },
                    { "type": "navigate", "page": "conditional-access" }
                  ]
                }
              }
            ]
