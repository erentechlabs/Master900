                  },
                  {
                    "label": "Status",
                    "value": "{{$sel.case.status}}",
                    "format": "status"
                  }
                ]
              },
              {
                "kind": "table",
                "id": "sources-table",
                "title": "Case data sources",
                "source": "eDiscoverySources",
                "where": {
                  "caseId": "{{$sel.case.id}}"
                },
                "rowKey": "name",
                "columns": [
                  {
                    "key": "name",
                    "label": "Name"
                  },
                  {
                    "key": "sourceType",
                    "label": "Type",
                    "format": "badge"
                  },
                  {
                    "key": "locations",
                    "label": "Locations"
                  }
                ]
              },
              {
                "kind": "form",
                "id": "add-sources",
                "title": "Add data sources",
                "fields": [
                  {
                    "id": "custodians",
                    "label": "Custodians",
                    "control": "checkboxes",
                    "required": true,
                    "options": [
                      {
                        "value": "Mira Ileri",
                        "label": "Mira Ileri - mailbox and OneDrive"
                      },
                      {
                        "value": "Adele Vance",
                        "label": "Adele Vance - mailbox and OneDrive"
                      },
                      {
                        "value": "All employees",
                        "label": "All employees"
                      }
                    ]
                  },
                  {
                    "id": "site",
                    "label": "Teams or SharePoint site",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Payroll Review Team",
                    "options": [
                      {
                        "value": "Payroll Review Team",
                        "label": "Payroll Review Team (Teams site)"
                      },
                      {
                        "value": "All SharePoint sites",
                        "label": "All SharePoint sites"
                      }
                    ]
                  },
                  {
                    "id": "includeMailbox",
                    "label": "Include Exchange mailboxes",
                    "control": "toggle",
                    "defaultValue": true
                  },
                  {
                    "id": "includeOneDrive",
                    "label": "Include OneDrive sites",
                    "control": "toggle",
                    "defaultValue": true
                  }
                ],
                "submit": {
                  "label": "Add",
                  "checks": [
                    {
                      "rule": {
                        "type": "not",
                        "rule": {
                          "type": "includes",
                          "path": "$form.custodians",
                          "value": "All employees"
                        }
                      },
                      "message": "Do not scope the investigation to all employees."
                    },
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.site",
                        "value": "All SharePoint sites"
                      },
                      "message": "All SharePoint sites is too broad."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.includeMailbox",
                        "value": true
                      },
                      "message": "Include mailboxes."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.includeOneDrive",
                        "value": true
                      },
                      "message": "Include OneDrive sites."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "eDiscoverySources",
                      "unique": "name",
                      "value": {
                        "caseId": "{{$sel.case.id}}",
                        "name": "Mira Ileri",
                        "sourceType": "Custodian",
                        "locations": "Mailbox, OneDrive"
                      }
                    },
                    {
                      "type": "append",
                      "path": "eDiscoverySources",
                      "unique": "name",
                      "value": {
                        "caseId": "{{$sel.case.id}}",
                        "name": "Adele Vance",
                        "sourceType": "Custodian",
                        "locations": "Mailbox, OneDrive"
                      }
                    },
                    {
                      "type": "append",
                      "path": "eDiscoverySources",
                      "unique": "name",
                      "value": {
                        "caseId": "{{$sel.case.id}}",
                        "name": "Payroll Review Team",
                        "sourceType": "Teams site",
                        "locations": "Teams messages, SharePoint site"
                      }
                    }
                  ]
                }
              },
              {
                "kind": "table",
                "id": "searches-table",
                "title": "Search statistics",
                "source": "eDiscoverySearches",
                "where": {
                  "caseId": "{{$sel.case.id}}"
                },
                "rowKey": "name",
                "columns": [
                  {
                    "key": "name",
                    "label": "Search"
                  },
                  {
                    "key": "status",
                    "label": "Status",
                    "format": "status"
                  },
                  {
                    "key": "items",
                    "label": "Items",
                    "format": "count"
                  },
                  {
                    "key": "estimatedSize",
                    "label": "Estimated size"
                  },
                  {
                    "key": "locations",
                    "label": "Locations"
                  }
                ]
              },
              {
                "kind": "form",
                "id": "create-search",
                "title": "Create search and review statistics",
                "fields": [
                  {
                    "id": "name",
                    "label": "Search name",
                    "control": "text",
                    "required": true,
                    "defaultValue": "Payroll adjustment communications"
                  },
                  {
                    "id": "query",
                    "label": "Keywords / KQL",
                    "control": "text",
                    "required": true,
                    "defaultValue": "(\"payroll adjustment\" OR bonus OR compensation)"
                  },
                  {
                    "id": "dateRange",
                    "label": "Date range",
                    "control": "select",
                    "required": true,
                    "defaultValue": "2026-09-01 to 2026-10-02",
                    "options": [
                      {
                        "value": "2026-09-01 to 2026-10-02",
                        "label": "2026-09-01 to 2026-10-02"
                      },
                      {
                        "value": "All time",
                        "label": "All time"
                      }
                    ]
                  },
                  {
                    "id": "locations",
                    "label": "Locations",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Case data sources",
                    "options": [
                      {
                        "value": "Case data sources",
                        "label": "Case data sources"
                      },
                      {
                        "value": "Whole organization",
                        "label": "Whole organization"
                      }
                    ]
                  },
                  {
                    "id": "reviewed",
                    "label": "Statistics reviewed",
                    "control": "toggle",
                    "defaultValue": true
                  }
                ],
                "submit": {
                  "label": "Run search",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.locations",
                        "value": "Case data sources"
                      },
                      "message": "Searching the whole organization is too broad for this case."
                    },
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.dateRange",
                        "value": "All time"
                      },
                      "message": "Use the requested date range."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.reviewed",
                        "value": true
                      },
                      "message": "Review the statistics before continuing."
                    },
                    {
                      "rule": {
                        "type": "arrayContains",
                        "path": "eDiscoverySources",
                        "match": {
                          "caseId": "{{$sel.case.id}}",
                          "name": "Payroll Review Team"
                        }
                      },
                      "message": "Add custodians and Teams site first."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "eDiscoverySearches",
                      "unique": "name",
                      "value": {
                        "caseId": "{{$sel.case.id}}",
                        "name": "{{$form.name}}",
                        "query": "{{$form.query}}",
                        "dateRange": "{{$form.dateRange}}",
                        "locations": "{{$form.locations}}",
                        "status": "Completed",
                        "items": [
                          "Mail",
                          "Teams",
                          "OneDrive"
                        ],
                        "estimatedSize": "18 MB",
                        "statisticsReviewed": "{{$form.reviewed}}"
                      }
                    }
                  ]
                }
              },
              {
                "kind": "table",
                "id": "holds-table",
                "title": "Holds",
                "source": "eDiscoveryHolds",
                "where": {
                  "caseId": "{{$sel.case.id}}"
                },
                "rowKey": "name",
                "columns": [
                  {
                    "key": "name",
                    "label": "Name"
                  },
                  {
                    "key": "scope",
                    "label": "Scope"
                  },
                  {
                    "key": "status",
                    "label": "Status",
                    "format": "status"
                  }
                ]
              },
              {
                "kind": "form",
                "id": "create-hold",
                "title": "Create hold",
                "fields": [
                  {
                    "id": "name",
                    "label": "Hold name",
                    "control": "text",
                    "required": true,
                    "defaultValue": "HR payroll preservation hold"
                  },
                  {
                    "id": "scope",
                    "label": "Hold scope",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Selected case data sources",
                    "options": [
                      {
                        "value": "Selected case data sources",
                        "label": "Selected case data sources"
                      },
                      {
                        "value": "Whole organization",
                        "label": "Whole organization"
                      }
                    ]
                  },
                  {
                    "id": "query",
                    "label": "Hold query",
                    "control": "text",
                    "required": true,
                    "defaultValue": "(\"payroll adjustment\" OR bonus OR compensation)"
                  },
                  {
                    "id": "preserveTeams",
                    "label": "Include Teams site content",
                    "control": "toggle",
                    "defaultValue": true
                  }
                ],
                "submit": {
                  "label": "Create hold",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.scope",
                        "value": "Selected case data sources"
                      },
                      "message": "A whole-organization hold is too broad."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.preserveTeams",
                        "value": true
                      },
                      "message": "Include the Teams site."
                    },
                    {
                      "rule": {
                        "type": "arrayContains",
                        "path": "eDiscoverySearches",
                        "match": {
                          "caseId": "{{$sel.case.id}}",
                          "statisticsReviewed": true
                        }
                      },
                      "message": "Run and review the search before placing the hold."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "eDiscoveryHolds",
                      "unique": "name",
                      "value": {
                        "caseId": "{{$sel.case.id}}",
                        "name": "{{$form.name}}",
                        "scope": "{{$form.scope}}",
                        "query": "{{$form.query}}",
                        "status": "On hold"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "audit",
            "title": "Audit",
            "subtitle": "Solutions",
            "icon": "Search",
            "url": "/audit/search",
            "components": [
              {
                "kind": "form",
                "id": "audit-search-form",
                "title": "New audit search",
                "fields": [
                  {
                    "id": "activity",
                    "label": "Activities",
                    "control": "select",
                    "required": true,
                    "defaultValue": "FileAccessed",
                    "options": [
                      {
                        "value": "FileAccessed",
                        "label": "FileAccessed"
                      },
                      {
                        "value": "UserLoggedIn",
                        "label": "UserLoggedIn"
                      }
                    ]
                  },
                  {
                    "id": "user",
                    "label": "Users",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Mira Ileri",
                    "options": [
                      {
                        "value": "Mira Ileri",
                        "label": "Mira Ileri"
                      },
                      {
                        "value": "All users",
                        "label": "All users"
                      }
                    ]
                  },
                  {
                    "id": "dateRange",
                    "label": "Date and time range",
                    "control": "select",
                    "required": true,
                    "defaultValue": "2026-09-01 to 2026-10-02",
                    "options": [
                      {
                        "value": "2026-09-01 to 2026-10-02",
                        "label": "2026-09-01 to 2026-10-02"
                      },
                      {
                        "value": "All time",
                        "label": "All time"
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Search",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.activity",
                        "value": "FileAccessed"
                      },
                      "message": "Search FileAccessed activity."
                    },
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.user",
                        "value": "All users"
                      },
                      "message": "All users is too broad."
                    },
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.dateRange",
                        "value": "All time"
                      },
                      "message": "Use the case date range."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "auditSearches",
                      "unique": "name",
                      "value": {
                        "name": "Payroll file access audit",
                        "activity": "{{$form.activity}}",
                        "user": "{{$form.user}}",
