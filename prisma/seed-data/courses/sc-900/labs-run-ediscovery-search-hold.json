{
  "labs": [
    {
      "slug": "run-ediscovery-search-hold",
      "type": "UI_SIMULATION",
      "title": "Run an eDiscovery search and hold in Microsoft Purview",
      "summary": "Create an eDiscovery case, add scoped data sources, run a keyword/date search, preserve sources with a hold, and complement it with an Audit search.",
      "scenario": "Fabrikam HR asks the compliance team to preserve and find content for a fictional payroll investigation. In the **simulated Microsoft Purview portal** on your lab VM, create a scoped eDiscovery case, add relevant custodians and collaboration locations, run a keyword/date search, review statistics, place only those sources on hold, and run an Audit search for supporting activity. Done means the investigation is preserved without searching or holding the whole organization.",
      "domainKey": "compliance-solutions",
      "objectiveCode": "4.4",
      "complexity": "INTERMEDIATE",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Create a Microsoft Purview eDiscovery case for an investigation",
        "Add user, OneDrive, mailbox, Teams, and SharePoint data sources with limited scope",
        "Build a KQL-style keyword and date search and review statistics",
        "Place selected sources on hold and use Audit search as complementary evidence"
      ],
      "prerequisites": [
        "Know that eDiscovery preserves and searches Microsoft 365 content for investigations"
      ],
      "sources": [
        {
          "title": "Get started with eDiscovery",
          "url": "https://learn.microsoft.com/en-us/purview/edisc-get-started"
        },
        {
          "title": "Create and manage cases in eDiscovery",
          "url": "https://learn.microsoft.com/en-us/purview/edisc-cases-manage"
        },
        {
          "title": "Data sources in eDiscovery",
          "url": "https://learn.microsoft.com/en-us/purview/edisc-data-sources"
        },
        {
          "title": "Search the audit log",
          "url": "https://learn.microsoft.com/en-us/purview/audit-search"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Purview portal",
          "theme": "purview",
          "user": "alex@contoso.example",
          "tenant": "Fabrikam (fabrikam.example)",
          "url": "https://purview.microsoft.com",
          "searchPlaceholder": "Search Purview solutions, policies, cases, and activities"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser"
          ]
        },
        "clock": {
          "start": "2026-10-02T09:00:00Z"
        },
        "startPage": "home",
        "navigation": [
          {
            "page": "home",
            "label": "Home",
            "icon": "Home"
          },
          {
            "page": "cases",
            "label": "Cases",
            "icon": "Briefcase",
            "section": "eDiscovery"
          },
          {
            "page": "audit",
            "label": "Audit",
            "icon": "Search",
            "section": "Solutions"
          }
        ],
        "pages": [
          {
            "id": "home",
            "title": "Home",
            "url": "/",
            "components": [
              {
                "kind": "tiles",
                "id": "home-tiles",
                "title": "Microsoft Purview solutions",
                "size": "md",
                "items": [
                  {
                    "id": "tile-cases",
                    "label": "eDiscovery",
                    "icon": "Briefcase",
                    "action": {
                      "type": "navigate",
                      "page": "cases"
                    }
                  },
                  {
                    "id": "tile-audit",
                    "label": "Audit",
                    "icon": "Search",
                    "action": {
                      "type": "navigate",
                      "page": "audit"
                    }
                  }
                ]
              },
              {
                "kind": "callout",
                "variant": "info",
                "text": "Everything is simulated. Scope case membership, searches, holds, and audit queries to the HR matter."
              }
            ]
          },
          {
            "id": "cases",
            "title": "Cases",
            "subtitle": "eDiscovery",
            "icon": "Briefcase",
            "url": "/ediscovery/cases",
            "components": [
              {
                "kind": "table",
                "id": "cases-table",
                "title": "Cases",
                "source": "cases",
                "rowKey": "name",
                "columns": [
                  {
                    "key": "name",
                    "label": "Name",
                    "format": "link"
                  },
                  {
                    "key": "caseType",
                    "label": "Case type",
                    "format": "badge"
                  },
                  {
                    "key": "status",
                    "label": "Status",
                    "format": "status"
                  }
                ],
                "rowAction": {
                  "type": "navigate",
                  "page": "case-overview",
                  "select": {
                    "as": "case",
                    "path": "cases",
                    "key": "name",
                    "value": "{{$row.name}}"
                  }
                }
              },
              {
                "kind": "form",
                "id": "case-form",
                "title": "Create case",
                "fields": [
                  {
                    "id": "name",
                    "label": "Case name",
                    "control": "text",
                    "required": true,
                    "defaultValue": "HR-2026-payroll-review",
                    "unique": {
                      "path": "cases",
                      "key": "name"
                    }
                  },
                  {
                    "id": "caseType",
                    "label": "Case type",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Premium",
                    "options": [
                      {
                        "value": "Premium",
                        "label": "Premium"
                      },
                      {
                        "value": "Standard",
                        "label": "Standard"
                      }
                    ]
                  },
                  {
                    "id": "members",
                    "label": "Case members",
                    "control": "checkboxes",
                    "required": true,
                    "options": [
                      {
                        "value": "Alex Wilber",
                        "label": "Alex Wilber"
                      },
                      {
                        "value": "All compliance admins",
                        "label": "All compliance admins"
                      }
                    ]
                  },
                  {
                    "id": "description",
                    "label": "Description",
                    "control": "textarea",
                    "required": true,
                    "defaultValue": "Fictional HR investigation into payroll-adjustment communications."
                  }
                ],
                "submit": {
                  "label": "Create",
                  "checks": [
                    {
                      "rule": {
                        "type": "includes",
                        "path": "$form.members",
                        "value": "Alex Wilber"
                      },
                      "message": "Add yourself as a scoped case member."
                    },
                    {
                      "rule": {
                        "type": "not",
                        "rule": {
                          "type": "includes",
                          "path": "$form.members",
                          "value": "All compliance admins"
                        }
                      },
                      "message": "Do not add broad administrator groups to a sensitive HR case."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "cases",
                      "unique": "name",
                      "value": {
                        "id": "case-hr-2026",
                        "name": "{{$form.name}}",
                        "caseType": "{{$form.caseType}}",
                        "status": "Active",
                        "members": "{{$form.members | list}}",
                        "description": "{{$form.description}}"
                      }
                    },
                    {
                      "type": "navigate",
                      "page": "case-overview",
                      "select": {
                        "as": "case",
                        "path": "cases",
                        "key": "name",
                        "value": "{{$form.name}}"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "case-overview",
            "title": "{{$sel.case.name}}",
            "subtitle": "eDiscovery case",
            "icon": "Briefcase",
            "requires": "case",
            "navItem": "cases",
            "components": [
              {
                "kind": "properties",
                "title": "Case summary",
                "items": [
                  {
                    "label": "Case type",
                    "value": "{{$sel.case.caseType}}",
