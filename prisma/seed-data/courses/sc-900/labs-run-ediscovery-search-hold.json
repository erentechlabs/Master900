                  },
                  {
                    "key": "activity",
                    "label": "Activity"
                  },
                  {
                    "key": "user",
                    "label": "User"
                  },
                  {
                    "key": "status",
                    "label": "Status",
                    "format": "status"
                  },
                  {
                    "key": "results",
                    "label": "Results",
                    "format": "count"
                  }
                ]
              }
            ]
          }
        ],
        "initialState": {
          "cases": [
            {
              "id": "case-privacy-2026",
              "name": "Privacy access review",
              "caseType": "Standard",
              "status": "Closed",
              "members": [
                "Alex Wilber"
              ]
            }
          ],
          "eDiscoverySources": [],
          "eDiscoverySearches": [],
          "eDiscoveryHolds": [],
          "auditSearches": []
        }
      },
      "steps": [
        {
          "key": "create-case",
          "title": "Create a scoped eDiscovery case",
          "instruction": "Open **Cases** and use **Create case** to create **HR-2026-payroll-review** as a **Premium** case. Add **Alex Wilber** as a case member and do not add **All compliance admins**.",
          "hint": "Case membership is access control for the matter. Add only people who need to work the case.",
          "explanation": "eDiscovery cases group sources, searches, holds, and review activity so an investigation has a defensible boundary.",
          "targetId": "case-form",
          "rules": [
            {
              "key": "case-created",
              "description": "The HR payroll eDiscovery case exists with scoped membership",
              "rule": {
                "type": "arrayContains",
                "path": "cases",
                "match": {
                  "name": "HR-2026-payroll-review",
                  "caseType": "Premium",
                  "status": "Active",
                  "members.0": "Alex Wilber"
                }
              }
            }
          ]
        },
        {
          "key": "add-sources",
          "title": "Add relevant custodians and collaboration source",
          "instruction": "In the case, use **Add data sources** to add **Mira Ileri**, **Adele Vance**, and **Payroll Review Team**. Include mailboxes and OneDrive sites.",
          "hint": "Do not choose **All employees** or **All SharePoint sites**.",
          "explanation": "Data sources define where eDiscovery searches and holds apply. Narrow source selection is part of least privilege.",
          "targetId": "add-sources",
          "rules": [
            {
              "key": "sources-added",
              "description": "The case has the required sources",
              "rule": {
                "type": "allOf",
                "rules": [
                  {
                    "type": "arrayContains",
                    "path": "eDiscoverySources",
                    "match": {
                      "name": "Mira Ileri"
                    }
                  },
                  {
                    "type": "arrayContains",
                    "path": "eDiscoverySources",
                    "match": {
                      "name": "Adele Vance"
                    }
                  },
                  {
                    "type": "arrayContains",
                    "path": "eDiscoverySources",
                    "match": {
                      "name": "Payroll Review Team"
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "key": "run-search",
          "title": "Run a keyword and date search",
