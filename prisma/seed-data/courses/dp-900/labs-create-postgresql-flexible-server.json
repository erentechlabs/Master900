{
  "labs": [
    {
      "slug": "create-postgresql-flexible-server",
      "type": "UI_SIMULATION",
      "title": "Create and query an Azure Database for PostgreSQL flexible server",
      "summary": "Create a PostgreSQL flexible server with secure authentication and networking, connect with psql from Cloud Shell, and run relational SQL queries.",
      "scenario": "Wide World Importers is moving a small open-source order service to Azure. In the **simulated Azure portal** on your lab VM, create an Azure Database for PostgreSQL flexible server named **pg-flex-orders-01** in **rg-open-source-data**. Use Microsoft Entra-based authentication, allow only the current lab client IP on public access, deploy the server, connect from Cloud Shell with `psql`, and run portable SQL to create, insert, and aggregate order rows.",
      "domainKey": "relational-data",
      "objectiveCode": "2.2",
      "complexity": "INTERMEDIATE",
      "estimatedMinutes": 35,
      "learningObjectives": [
        "Create an Azure Database for PostgreSQL flexible server with the Azure portal wizard",
        "Choose secure authentication and networking settings for an open-source relational database",
        "Connect with psql from Cloud Shell and run portable SQL statements",
        "Explain when PostgreSQL on Azure is a relational PaaS option compared with Azure SQL Database"
      ],
      "prerequisites": [
        "Know that PostgreSQL is an open-source relational database that stores rows in tables"
      ],
      "sources": [
        {
          "title": "Quickstart: Create an Azure Database for PostgreSQL flexible server",
          "url": "https://learn.microsoft.com/en-us/azure/postgresql/configure-maintain/quickstart-create-server"
        },
        {
          "title": "Connect and Query Overview in Azure Database for PostgreSQL Flexible Server",
          "url": "https://learn.microsoft.com/en-us/azure/postgresql/connectivity/how-to-connect-query-guide"
        },
        {
          "title": "Networking with Public Access in Azure Database for PostgreSQL Flexible Server",
          "url": "https://learn.microsoft.com/en-us/azure/postgresql/network/concepts-networking-public"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Azure",
          "theme": "azure",
          "user": "alex@contoso.example",
          "tenant": "Contoso Learning (contoso.example)",
          "url": "https://portal.azure.com",
          "searchPlaceholder": "Search resources, services, and docs (G+/)"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser",
            "terminal"
          ]
        },
        "clock": {
          "start": "2026-09-30T09:00:00Z"
        },
        "terminal": {
          "title": "Cloud Shell (Bash)",
          "prompt": "alex@Azure:~$",
          "surface": "both",
          "welcome": "Welcome to Azure Cloud Shell (simulation). Use psql to connect to the PostgreSQL flexible server created in this lab.",
          "commands": [
            {
              "id": "psql-connect",
              "pattern": "^psql \"host=pg-flex-orders-01\\.postgres\\.database\\.azure\\.com port=5432 dbname=postgres user=alex@contoso\\.example sslmode=require\"$",
              "help": "psql \"host=<server>.postgres.database.azure.com port=5432 dbname=postgres user=<user> sslmode=require\"",
              "actions": [
                {
                  "type": "set",
                  "path": "psql.connected",
                  "value": true
                }
              ],
              "output": "psql (simulation)\nSSL connection established.\nUse the PostgreSQL query worksheet for SQL statements."
            },
            {
              "id": "psql-missing",
              "pattern": "^psql .*$",
              "error": "Use the exact psql command for pg-flex-orders-01."
            }
          ],
          "fallback": "Command not recognized in this lab. Connect with the exact psql command shown in the instructions."
        },
