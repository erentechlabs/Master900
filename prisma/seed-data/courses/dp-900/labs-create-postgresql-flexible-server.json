            "id": "pg-create",
            "title": "Create Azure Database for PostgreSQL flexible server",
            "subtitle": "Flexible server",
            "icon": "Database",
            "url": "/#create/Microsoft.PostgreSQLServer",
            "navItem": "postgres-servers",
            "breadcrumb": [
              "Home",
              "Azure Database for PostgreSQL"
            ],
            "components": [
              {
                "kind": "wizard",
                "id": "pg-wizard",
                "description": "Create a managed PostgreSQL flexible server.",
                "reviewLabel": "Review + create",
                "tabs": [
                  {
                    "id": "basics",
                    "label": "Basics",
                    "fields": [
                      {
                        "id": "subscription",
                        "label": "Subscription",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Contoso Learning (simulated)",
                        "options": [
                          {
                            "value": "Contoso Learning (simulated)",
                            "label": "Contoso Learning (simulated)"
                          }
                        ]
                      },
                      {
                        "id": "resourceGroup",
                        "label": "Resource group",
                        "control": "select",
                        "required": true,
                        "options": [
                          {
                            "value": "create-new",
                            "label": "Create new"
                          }
                        ],
                        "optionsFrom": {
                          "path": "resourceGroups",
                          "value": "name"
                        },
                        "defaultValue": "create-new"
                      },
                      {
                        "id": "newResourceGroup",
                        "label": "New resource group name",
                        "control": "text",
                        "required": true,
                        "visibleWhen": {
                          "type": "equals",
                          "path": "$form.resourceGroup",
                          "value": "create-new"
                        },
                        "pattern": "^[A-Za-z0-9_().-]{1,90}$",
                        "patternMessage": "Use 1-90 letters, numbers, periods, underscores, hyphens or parentheses."
                      },
                      {
                        "id": "serverName",
                        "label": "Server name",
                        "control": "text",
                        "required": true,
                        "defaultValue": "pg-flex-orders-01",
                        "pattern": "^[a-z0-9][a-z0-9-]{2,62}$",
                        "patternMessage": "Use 3-63 lowercase letters, numbers or hyphens.",
                        "unique": {
                          "path": "postgresServers",
                          "key": "name",
                          "message": "A PostgreSQL server with this name already exists."
                        }
                      },
                      {
                        "id": "region",
                        "label": "Region",
                        "control": "select",
                        "required": true,
                        "defaultValue": "westeurope",
                        "optionsFrom": {
                          "path": "regions",
                          "value": "name",
                          "label": "displayName"
                        }
                      },
                      {
                        "id": "postgresVersion",
                        "label": "PostgreSQL version",
                        "control": "select",
                        "required": true,
                        "defaultValue": "16",
                        "options": [
                          {
                            "value": "16",
                            "label": "16"
                          },
                          {
                            "value": "15",
                            "label": "15"
                          },
                          {
                            "value": "14",
                            "label": "14"
                          }
                        ]
                      },
                      {
                        "id": "workloadType",
                        "label": "Workload type",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Development",
                        "options": [
                          {
                            "value": "Development",
                            "label": "Development"
                          },
                          {
                            "value": "Production",
                            "label": "Production"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "compute",
                    "label": "Compute + storage",
