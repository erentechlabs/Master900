                          {
                            "value": "PostgreSQL authentication only",
                            "label": "PostgreSQL authentication only"
                          }
                        ],
                        "help": "Prefer Microsoft Entra-based authentication so users do not share database passwords."
                      },
                      {
                        "id": "entraAdmin",
                        "label": "Microsoft Entra admin",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Data Platform Team",
                        "options": [
                          {
                            "value": "Data Platform Team",
                            "label": "Data Platform Team (data-platform@contoso.example)"
