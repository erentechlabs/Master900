                        ]
                      },
                      {
                        "id": "storageSize",
                        "label": "Storage size",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Training storage profile",
                        "options": [
                          {
                            "value": "Training storage profile",
                            "label": "Training storage profile"
                          },
                          {
                            "value": "Larger training storage profile",
                            "label": "Larger training storage profile"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "auth",
                    "label": "Authentication",
                    "fields": [
                      {
                        "id": "authentication",
                        "label": "Authentication method",
                        "control": "radio",
                        "required": true,
                        "defaultValue": "Microsoft Entra authentication only",
                        "options": [
                          {
                            "value": "Microsoft Entra authentication only",
                            "label": "Microsoft Entra authentication only"
                          },
                          {
                            "value": "Microsoft Entra and PostgreSQL authentication",
                            "label": "Microsoft Entra and PostgreSQL authentication"
