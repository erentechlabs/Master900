                          {
                            "value": "Alex Training",
                            "label": "Alex Training (alex@contoso.example)"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "networking",
                    "label": "Networking",
                    "fields": [
                      {
                        "id": "networking",
                        "label": "Connectivity method",
                        "control": "radio",
                        "required": true,
                        "defaultValue": "Public access (allowed IP addresses)",
                        "options": [
                          {
                            "value": "Public access (allowed IP addresses)",
                            "label": "Public access (allowed IP addresses)"
                          },
                          {
                            "value": "Private access (virtual network integration)",
                            "label": "Private access (virtual network integration)"
                          }
                        ]
                      },
                      {
                        "id": "firewallMode",
                        "label": "Firewall rule",
                        "control": "radio",
                        "required": true,
                        "defaultValue": "Add current client IP address",
                        "visibleWhen": {
                          "type": "equals",
                          "path": "$form.networking",
                          "value": "Public access (allowed IP addresses)"
                        },
                        "options": [
                          {
                            "value": "Add current client IP address",
                            "label": "Add current client IP address"
                          },
                          {
                            "value": "Allow all IPv4 addresses",
                            "label": "Allow all IPv4 addresses (0.0.0.0 - 255.255.255.255)"
                          }
                        ]
                      },
                      {
                        "id": "firewallStart",
                        "label": "Start IP address",
                        "control": "text",
                        "defaultValue": "203.0.113.24",
                        "visibleWhen": {
                          "type": "equals",
                          "path": "$form.firewallMode",
                          "value": "Add current client IP address"
                        }
                      },
                      {
                        "id": "firewallEnd",
                        "label": "End IP address",
                        "control": "text",
                        "defaultValue": "203.0.113.24",
                        "visibleWhen": {
                          "type": "equals",
                          "path": "$form.firewallMode",
                          "value": "Add current client IP address"
                        }
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Create",
                  "checks": [
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.authentication",
                        "value": "PostgreSQL authentication only"
                      },
                      "message": "Choose a Microsoft Entra-based authentication option. PostgreSQL-only authentication would require database passwords for this lab."
                    },
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.firewallMode",
                        "value": "Allow all IPv4 addresses"
                      },
                      "message": "Do not allow all IPv4 addresses. Public access should be limited to the current lab client IP, or use private access."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.postgresVersion",
                        "value": "16"
                      },
                      "message": "Use PostgreSQL version 16 for this lab."
                    }
                  ],
                  "actions": [
                    {
                      "type": "if",
                      "when": {
                        "type": "equals",
                        "path": "$form.resourceGroup",
                        "value": "create-new"
                      },
                      "then": [
                        {
                          "type": "append",
                          "path": "resourceGroups",
                          "unique": "name",
                          "value": {
                            "name": "{{$form.newResourceGroup}}",
                            "location": "{{$form.region}}"
                          }
                        }
                      ]
                    },
                    {
                      "type": "append",
                      "path": "postgresServers",
                      "unique": "name",
                      "value": {
                        "name": "{{$form.serverName}}",
                        "resourceGroup": "{{$form.newResourceGroup | or:$form.resourceGroup}}",
                        "location": "{{$form.region}}",
                        "postgresVersion": "{{$form.postgresVersion}}",
                        "workloadType": "{{$form.workloadType}}",
                        "computeTier": "{{$form.computeTier}}",
                        "computeSize": "{{$form.computeSize}}",
                        "storageSize": "{{$form.storageSize}}",
                        "authentication": "{{$form.authentication}}",
                        "entraAdmin": "{{$form.entraAdmin}}",
                        "networking": "{{$form.networking}}",
                        "firewallRule": "{{$form.firewallMode}}",
                        "firewallStart": "{{$form.firewallStart}}",
                        "firewallEnd": "{{$form.firewallEnd}}",
                        "status": "Ready",
                        "fqdn": "{{$form.serverName}}.postgres.database.azure.com"
                      }
                    },
                    {
                      "type": "set",
                      "path": "sql.pgdb",
                      "value": {
                        "tables": {}
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Deployment succeeded",
                      "message": "PostgreSQL flexible server {{$form.serverName}} was created."
                    },
                    {
                      "type": "navigate",
                      "page": "pg-deployment",
                      "select": {
                        "as": "server",
                        "path": "postgresServers",
                        "key": "name",
                        "value": "{{$form.serverName}}"
                      }
                    }
                  ]
                }
              }
            ]
          },
