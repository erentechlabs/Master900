              "name": "rg-data-shared",
              "location": "westeurope"
            }
          ],
          "regions": [
            {
              "name": "westeurope",
              "displayName": "(Europe) West Europe"
            },
            {
              "name": "northeurope",
              "displayName": "(Europe) North Europe"
            },
            {
              "name": "swedencentral",
              "displayName": "(Europe) Sweden Central"
            }
