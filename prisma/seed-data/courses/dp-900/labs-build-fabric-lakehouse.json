              { "page": "sql-endpoint", "label": "SQL analytics endpoint", "icon": "Terminal" }
            ],
            "components": [
              {
                "kind": "form",
                "id": "upload-file-form",
                "title": "Get data > Upload files",
                "fields": [
                  { "id": "source", "label": "Source", "control": "select", "required": true, "defaultValue": "Upload files", "options": [{ "value": "Upload files", "label": "Upload files" }, { "value": "Dataflow Gen2", "label": "Dataflow Gen2" }, { "value": "Data pipeline", "label": "Data pipeline" }] },
                  { "id": "fileName", "label": "File", "control": "select", "required": true, "defaultValue": "sales.csv", "optionsFrom": { "path": "vmFiles", "value": "name" } },
                  { "id": "destination", "label": "Destination", "control": "select", "required": true, "defaultValue": "Files", "options": [{ "value": "Files", "label": "Files" }, { "value": "Tables", "label": "Tables" }] }
                ],
                "submit": {
                  "label": "Upload",
                  "checks": [
                    { "rule": { "type": "equals", "path": "$form.source", "value": "Upload files" }, "message": "Use Upload files for this small local CSV. Dataflow Gen2 and pipelines are useful for repeatable ingestion orchestration." },
                    { "rule": { "type": "equals", "path": "$form.fileName", "value": "sales.csv" }, "message": "Upload sales.csv from the lab VM." },
                    { "rule": { "type": "equals", "path": "$form.destination", "value": "Files" }, "message": "Upload to Files first, then explicitly load to a Delta table." }
                  ],
                  "actions": [
                    { "type": "append", "path": "lakehouseFiles", "unique": "name", "value": { "lakehouse": "{{$sel.lakehouse.name}}", "name": "sales.csv", "folder": "Files", "rows": 8, "format": "CSV" } },
                    { "type": "update", "path": "lakehouses", "where": { "name": "{{$sel.lakehouse.name}}" }, "set": { "files": 1 } },
                    { "type": "notify", "title": "Upload complete", "message": "sales.csv was uploaded to Files." }
                  ]
                }
              },
              { "kind": "table", "id": "files-list", "title": "Files", "source": "lakehouseFiles", "where": { "lakehouse": "{{$sel.lakehouse.name}}" }, "rowKey": "name", "emptyText": "No files uploaded.", "variant": "files", "columns": [{ "key": "name", "label": "Name", "format": "link" }, { "key": "format", "label": "Format" }, { "key": "rows", "label": "Rows" }, { "key": "folder", "label": "Folder" }] }
            ]
          },
          {
            "id": "tables",
            "title": "{{$sel.lakehouse.name}} | Tables",
            "subtitle": "Lakehouse",
