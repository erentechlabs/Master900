            "components": [
              { "kind": "properties", "title": "Lakehouse overview", "items": [{ "label": "Workspace", "value": "Sales Analytics" }, { "label": "Files", "value": "{{$sel.lakehouse.files}}" }, { "label": "Tables", "value": "{{$sel.lakehouse.tables}}" }, { "label": "SQL analytics endpoint", "value": "Automatically available" }] },
              { "kind": "callout", "variant": "info", "text": "A lakehouse can support ETL and ELT patterns: land data in Files, then transform or load it into Delta tables for SQL and BI workloads." }
