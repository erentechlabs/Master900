                  { "id": "name", "label": "Name", "control": "text", "required": true, "pattern": "^[A-Za-z][A-Za-z0-9_ ]{2,79}$", "patternMessage": "Start with a letter; use letters, numbers, spaces, or underscores.", "unique": { "path": "lakehouses", "key": "name", "message": "A lakehouse with this name already exists." } }
                ],
                "submit": {
                  "label": "Create",
                  "checks": [
                    { "rule": { "type": "equals", "path": "$form.itemType", "value": "Lakehouse" }, "message": "Choose Lakehouse. A warehouse or eventhouse would not expose the Files area used by this CSV ingestion task." }
                  ],
                  "actions": [
                    { "type": "append", "path": "lakehouses", "unique": "name", "value": { "name": "{{$form.name}}", "workspace": "{{$sel.workspace.name}}", "owner": "Alex", "tables": 0, "files": 0 } },
                    { "type": "append", "path": "items", "unique": "name", "value": { "name": "{{$form.name}}", "workspace": "{{$sel.workspace.name}}", "type": "Lakehouse", "owner": "Alex" } },
                    { "type": "notify", "title": "Lakehouse created", "message": "{{$form.name}} and its SQL analytics endpoint are ready." },
                    { "type": "navigate", "page": "lakehouse", "select": { "as": "lakehouse", "path": "lakehouses", "key": "name", "value": "{{$form.name}}" } }
                  ]
                }
              }
            ]
          },
