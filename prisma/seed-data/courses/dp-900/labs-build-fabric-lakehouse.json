                  { "id": "eventhouse", "label": "Eventhouse", "description": "Real-time event analytics", "icon": "Activity", "action": { "type": "message", "tone": "warning", "text": "Eventhouse is for high-volume event streams, not this batch CSV upload scenario." } }
