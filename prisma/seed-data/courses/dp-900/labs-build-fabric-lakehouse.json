            "requires": "lakehouse",
            "breadcrumb": ["Home", "Workspaces", "Sales Analytics", "{{$sel.lakehouse.name}}"],
            "menu": [
              { "page": "lakehouse", "label": "Lakehouse", "icon": "Database" },
              { "page": "files", "label": "Files", "icon": "FolderOpen" },
              { "page": "tables", "label": "Tables", "icon": "Table2" },
              { "page": "sql-endpoint", "label": "SQL analytics endpoint", "icon": "Terminal" }
            ],
            "components": [
              {
                "kind": "form",
                "id": "load-table-form",
                "title": "Load to Tables",
                "description": "Load a file or folder into a managed Delta table.",
                "fields": [
                  { "id": "sourceFile", "label": "Source file", "control": "select", "required": true, "optionsFrom": { "path": "lakehouseFiles", "value": "name", "where": { "lakehouse": "{{$sel.lakehouse.name}}" } } },
                  { "id": "loadMode", "label": "Load mode", "control": "select", "required": true, "defaultValue": "New table", "options": [{ "value": "New table", "label": "New table" }, { "value": "Existing table", "label": "Existing table" }] },
                  { "id": "tableName", "label": "Table name", "control": "text", "required": true, "defaultValue": "sales", "pattern": "^[A-Za-z][A-Za-z0-9_]{1,79}$", "patternMessage": "Start with a letter; use letters, numbers, or underscores." }
                ],
                "submit": {
                  "label": "Load",
                  "checks": [
                    { "rule": { "type": "equals", "path": "$form.sourceFile", "value": "sales.csv" }, "message": "Load the uploaded sales.csv file." },
                    { "rule": { "type": "equals", "path": "$form.loadMode", "value": "New table" }, "message": "Create a new Delta table for this first load." },
                    { "rule": { "type": "equals", "path": "$form.tableName", "value": "sales" }, "message": "Name the table sales so analysts can query it consistently." }
                  ],
                  "actions": [
                    { "type": "append", "path": "lakehouseTables", "unique": "name", "value": { "lakehouse": "{{$sel.lakehouse.name}}", "name": "sales", "format": "Delta", "rows": 8, "source": "sales.csv" } },
                    { "type": "update", "path": "lakehouses", "where": { "name": "{{$sel.lakehouse.name}}" }, "set": { "tables": 1 } },
                    { "type": "set", "path": "sql.salesdb.tables.sales", "value": { "columns": [{ "name": "Region", "type": "NVARCHAR(30)" }, { "name": "Month", "type": "NVARCHAR(20)" }, { "name": "Amount", "type": "INT" }, { "name": "Channel", "type": "NVARCHAR(20)" }], "rows": [{ "Region": "North", "Month": "2026-07", "Amount": 12000, "Channel": "Online" }, { "Region": "North", "Month": "2026-08", "Amount": 14200, "Channel": "Store" }, { "Region": "South", "Month": "2026-07", "Amount": 9800, "Channel": "Online" }, { "Region": "South", "Month": "2026-08", "Amount": 10100, "Channel": "Store" }, { "Region": "West", "Month": "2026-07", "Amount": 16100, "Channel": "Online" }, { "Region": "West", "Month": "2026-08", "Amount": 17000, "Channel": "Store" }, { "Region": "East", "Month": "2026-07", "Amount": 8700, "Channel": "Online" }, { "Region": "East", "Month": "2026-08", "Amount": 9300, "Channel": "Store" }] } },
                    { "type": "notify", "title": "Table loaded", "message": "sales.csv was loaded into the Delta table sales." }
                  ]
                }
              },
              { "kind": "table", "id": "tables-list", "title": "Tables", "source": "lakehouseTables", "where": { "lakehouse": "{{$sel.lakehouse.name}}" }, "rowKey": "name", "emptyText": "No tables yet. Loading only to Files is not enough for SQL analytics.", "columns": [{ "key": "name", "label": "Name", "format": "link" }, { "key": "format", "label": "Format", "format": "badge" }, { "key": "rows", "label": "Rows" }, { "key": "source", "label": "Source" }], "rowAction": { "type": "navigate", "page": "sql-endpoint" } }
            ]
          },
          {
            "id": "sql-endpoint",
            "title": "{{$sel.lakehouse.name}} SQL analytics endpoint",
            "subtitle": "Read-only T-SQL query surface",
            "icon": "Terminal",
            "url": "/groups/sales-analytics/lakehouses/{{$sel.lakehouse.name}}/sqlEndpoint",
            "requires": "lakehouse",
            "breadcrumb": ["Home", "Workspaces", "Sales Analytics", "{{$sel.lakehouse.name}}"],
            "menu": [
              { "page": "lakehouse", "label": "Lakehouse", "icon": "Database" },
              { "page": "files", "label": "Files", "icon": "FolderOpen" },
              { "page": "tables", "label": "Tables", "icon": "Table2" },
              { "page": "sql-endpoint", "label": "SQL analytics endpoint", "icon": "Terminal" }
            ],
            "components": [
              { "kind": "callout", "variant": "info", "text": "The SQL analytics endpoint is read-only for lakehouse Delta tables. Use it for BI and ad hoc SQL over tables, not for loading Files directly." },
              { "kind": "sqlEditor", "id": "sales-sql-editor", "title": "SQL query editor", "database": "sql.salesdb", "placeholder": "SELECT Region, SUM(Amount) AS TotalSales FROM sales GROUP BY Region ORDER BY TotalSales DESC", "sampleQueries": [{ "label": "Total sales by region", "sql": "SELECT Region, SUM(Amount) AS TotalSales FROM sales GROUP BY Region ORDER BY TotalSales DESC" }, { "label": "Sales by month", "sql": "SELECT Month, SUM(Amount) AS TotalSales FROM sales GROUP BY Month ORDER BY Month" }], "maxRows": 20 },
              { "kind": "text", "id": "concept-note", "text": "**OLTP** systems optimize many small transactions. **OLAP** and lakehouse workloads optimize analytical scans. Batch uploads like this CSV are different from streaming event workloads; use Real-Time Intelligence or an eventhouse when events arrive continuously." }
            ]
          }
        ],
        "initialState": {
          "workspaces": [
            { "id": "sales-analytics", "name": "Sales Analytics", "role": "Contributor", "description": "Shared analytics workspace for Northwind Traders" },
            { "id": "finance", "name": "Finance", "role": "Viewer", "description": "Finance reports" }
          ],
          "items": [
            { "name": "Regional Margin", "workspace": "Sales Analytics", "type": "Report", "owner": "Priya" },
            { "name": "Customer Cleanup", "workspace": "Sales Analytics", "type": "Dataflow Gen2", "owner": "Mehmet" },
            { "name": "Inventory Events", "workspace": "Sales Analytics", "type": "Eventstream", "owner": "Alex" }
          ],
          "lakehouses": [],
          "lakehouseFiles": [],
          "lakehouseTables": [],
          "vmFiles": [{ "name": "sales.csv" }, { "name": "returns.csv" }, { "name": "customers.json" }],
          "sql": { "salesdb": { "tables": {} } }
        }
      },
      "steps": [
        { "key": "open-workspace", "title": "Open the Sales Analytics workspace", "instruction": "Select **Workspaces**, then open **Sales Analytics**.", "hint": "Workspaces contain Fabric items such as lakehouses, warehouses, reports, and dataflows.", "explanation": "Fabric content is created inside a workspace so teams can manage permissions and related items together.", "targetId": "workspace-list", "rules": [{ "key": "visited-workspace", "description": "Sales Analytics workspace was opened", "rule": { "type": "visited", "page": "workspace" } }] },
        { "key": "create-lakehouse", "title": "Create the lakehouse", "instruction": "Select **+ New item**, choose **Lakehouse**, and create **SalesLakehouse**.", "hint": "Warehouse and Eventhouse are realistic choices, but this file-based scenario needs a lakehouse Files area and Delta tables.", "explanation": "A Fabric lakehouse stores files and managed Delta tables in one item and automatically provides a SQL analytics endpoint.", "targetId": "lakehouse-form", "rules": [{ "key": "lakehouse-created", "description": "SalesLakehouse exists", "rule": { "type": "arrayContains", "path": "lakehouses", "match": { "name": "SalesLakehouse", "workspace": "Sales Analytics" } }, "failureFeedback": "Create a Lakehouse item named SalesLakehouse." }] },
        { "key": "upload-sales", "title": "Upload sales.csv to Files", "instruction": "In **Get data > Upload files**, upload **sales.csv** from the VM to **Files**.", "hint": "Loading to Files alone stores the CSV, but does not create a SQL-queryable Delta table.", "explanation": "Files are useful for raw or staged data. Tables are needed for the SQL analytics endpoint and BI tools.", "targetId": "upload-file-form", "rules": [{ "key": "sales-file", "description": "sales.csv is uploaded to Files", "rule": { "type": "arrayContains", "path": "lakehouseFiles", "match": { "lakehouse": "SalesLakehouse", "name": "sales.csv", "folder": "Files" } }, "failureFeedback": "Upload sales.csv to Files." }] },
        { "key": "load-table", "title": "Load the file to a Delta table", "instruction": "Select **Load to Tables**, choose **sales.csv**, use **New table**, and name the table **sales**.", "hint": "Delta tables provide table metadata and storage format for analytical queries.", "explanation": "The Load to Tables flow turns CSV or Parquet files into managed Delta tables.", "targetId": "load-table-form", "rules": [{ "key": "sales-table", "description": "sales Delta table exists", "rule": { "type": "arrayContains", "path": "lakehouseTables", "match": { "lakehouse": "SalesLakehouse", "name": "sales", "format": "Delta" } }, "failureFeedback": "Load sales.csv into a new table named sales." }] },
        { "key": "query-region", "title": "Query total sales by region", "instruction": "Open **SQL analytics endpoint** and run `SELECT Region, SUM(Amount) AS TotalSales FROM sales GROUP BY Region ORDER BY TotalSales DESC`.", "hint": "The GROUP BY clause aggregates many sales rows into one row per region.", "explanation": "The SQL analytics endpoint lets analysts run T-SQL over lakehouse Delta tables without managing separate infrastructure.", "targetId": "sales-sql-editor", "rules": [{ "key": "aggregate-query", "description": "A correct aggregate query was run", "rule": { "type": "commandUsed", "pattern": "SELECT Region, SUM\\(Amount\\) AS TotalSales FROM sales GROUP BY Region ORDER BY TotalSales DESC" }, "failureFeedback": "Run the total sales by region query exactly as shown." }] }
      ],
      "finalRules": [
        { "key": "final-table-exists", "description": "The sales table exists as a Delta table", "rule": { "type": "arrayContains", "path": "lakehouseTables", "match": { "name": "sales", "format": "Delta" } }, "successFeedback": "The file was loaded to a queryable Delta table.", "failureFeedback": "Loading only to Files is not enough; create the sales table." },
        { "key": "final-query-run", "description": "The aggregate query was run from the SQL analytics endpoint", "rule": { "type": "commandUsed", "pattern": "GROUP BY Region" }, "failureFeedback": "Run an aggregate query that groups sales by Region." }
      ],
      "solution": "1. Select **Workspaces** and open **Sales Analytics**.\n2. Select **+ New item**. Choose **Lakehouse** and create `SalesLakehouse`. Do not choose Warehouse or Eventhouse for this file-based landing scenario.\n3. In the lakehouse, select **Get data** / **Files** and use **Upload files** to upload `sales.csv` to **Files**.\n4. Select **Load to Tables**. Source file `sales.csv`, **New table**, table name `sales`, then **Load**.\n5. Open **SQL analytics endpoint** and run: `SELECT Region, SUM(Amount) AS TotalSales FROM sales GROUP BY Region ORDER BY TotalSales DESC`."
    }
  ]
}
