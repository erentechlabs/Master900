{
  "labs": [
    {
      "slug": "build-fabric-lakehouse",
      "type": "UI_SIMULATION",
      "title": "Build a Microsoft Fabric lakehouse and query a Delta table",
      "summary": "Create a Fabric lakehouse, upload a sales CSV, load it into a Delta table, and query it from the SQL analytics endpoint.",
      "scenario": "Northwind Traders wants analysts to explore monthly sales files without provisioning separate SQL infrastructure. In the **simulated Microsoft Fabric portal** on your lab VM, use the **Sales Analytics** workspace to create a lakehouse named **SalesLakehouse**, upload **sales.csv** to **Files**, load it to a new table named **sales**, and use the **SQL analytics endpoint** to run an aggregate sales query by region.",
      "domainKey": "analytics-workloads",
      "objectiveCode": "4.1",
      "complexity": "BASIC",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Create a lakehouse item in a Fabric workspace",
        "Load file data into a Delta table",
        "Run a T-SQL aggregate query over a lakehouse SQL analytics endpoint"
      ],
      "prerequisites": ["Know the difference between files and tables in an analytics platform"],
      "sources": [
        { "title": "Create a lakehouse in Microsoft Fabric", "url": "https://learn.microsoft.com/en-us/fabric/data-engineering/create-lakehouse" },
        { "title": "Lakehouse Load to Delta Lake tables", "url": "https://learn.microsoft.com/en-us/fabric/data-engineering/load-to-tables" },
        { "title": "What is the SQL analytics endpoint for a lakehouse?", "url": "https://learn.microsoft.com/en-us/fabric/data-engineering/lakehouse-sql-analytics-endpoint" },
        { "title": "What is a lakehouse in Microsoft Fabric?", "url": "https://learn.microsoft.com/en-us/fabric/data-engineering/lakehouse-overview" }
      ],
