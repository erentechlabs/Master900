            "requires": "lakehouse",
            "breadcrumb": ["Home", "Workspaces", "Sales Analytics", "{{$sel.lakehouse.name}}"],
            "menu": [
              { "page": "lakehouse", "label": "Lakehouse", "icon": "Database" },
