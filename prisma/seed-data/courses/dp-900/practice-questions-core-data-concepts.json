    {
      "ref": "dp900-cdc-038",
      "type": "ORDERING",
      "domainKey": "core-data-concepts",
      "objectiveCode": "1.4",
      "difficulty": "MEDIUM",
      "stem": "Order the dependent handoff steps for delivering a new executive dashboard from governed source data.",
      "explanation": "The team must define the requested dashboard and sources, grant access to those sources, create the curated data layer, and then build visuals from that layer.",
      "ordering": {
        "items": [
          {
            "id": "s1",
            "text": "Business sponsor confirms dashboard questions and approved source systems"
          },
          {
            "id": "s2",
            "text": "DBA grants the data engineer read access to those approved sources"
          },
          {
            "id": "s3",
            "text": "Data engineer ingests, cleans, and publishes curated tables"
          },
          {
            "id": "s4",
            "text": "Data analyst builds measures and visuals from the curated tables"
          }
        ],
        "correctOrder": [
          "s1",
          "s2",
          "s3",
          "s4"
        ],
        "explanations": {
          "s1": "The sponsor's questions and approved source list define what data access is needed.",
          "s2": "The DBA can grant read access only after the approved source systems are known.",
          "s3": "The data engineer needs that source access before ingesting, cleansing, and publishing trusted tables.",
          "s4": "The analyst needs the curated tables before creating reliable measures and dashboard visuals."
        }
      },
