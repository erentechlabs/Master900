          { "key": "standard-ssd", "description": "The OS disk is Standard SSD", "rule": { "type": "arrayContains", "path": "virtualMachines", "match": { "name": "vm-web-01", "osDiskType": "Standard SSD (LRS)" } }, "failureFeedback": "vm-web-01 should use a Standard SSD OS disk." },
          { "key": "public-ip", "description": "The VM has a public IP address", "rule": { "type": "allOf", "rules": [{ "type": "arrayContains", "path": "virtualMachines", "match": { "name": "vm-web-01" } }, { "type": "arrayNotContains", "path": "virtualMachines", "match": { "name": "vm-web-01", "publicIp": "None" } }] }, "failureFeedback": "Without a public IP address, users can't reach the web server from the internet." }
        ] },
