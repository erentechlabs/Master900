          { "key": "tags", "description": "The VM is tagged env=dev and owner=training", "rule": { "type": "arrayContains", "path": "virtualMachines", "match": { "name": "vm-web-01", "tags.env": "dev", "tags.owner": "training" } }, "failureFeedback": "Add the tags env = dev and owner = training." }
