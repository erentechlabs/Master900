                      "message": "Use 19:00 for this lab."
                    }
                  ],
                  "actions": [
                    {
                      "type": "update",
                      "path": "virtualMachines",
                      "where": {
                        "name": "vm-web-01"
                      },
                      "set": {
                        "autoShutdown": "{{$form.enabled}}",
                        "shutdownTime": "{{$form.shutdownTime}}",
                        "timeZone": "{{$form.timeZone}}"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Auto-shutdown saved"
                    }
