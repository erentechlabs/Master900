      "steps": [
        {
          "key": "open-vm",
          "title": "Open vm-web-01",
          "instruction": "In **Virtual machines**, select **vm-web-01** and review the **Public IP address**.",
          "explanation": "The Overview blade provides the address for SSH and browser tests.",
          "targetId": "vm-list",
          "rules": [
            {
              "key": "visited-vm",
              "description": "vm-web-01 is open",
              "rule": {
                "type": "visited",
                "page": "vm-overview"
              }
            }
          ]
        },
        {
          "key": "ssh",
          "title": "Connect with SSH",
          "instruction": "Open **Terminal** or **Cloud Shell** and run `ssh azureuser@203.0.113.44`.",
          "explanation": "Package commands must run on the Linux VM, not on the lab VM.",
          "targetId": "cloud-shell-terminal",
          "rules": [
            {
              "key": "connected",
              "description": "SSH session is connected",
              "rule": {
                "type": "equals",
                "path": "shell.connected",
                "value": true
              },
              "failureFeedback": "Run ssh azureuser@203.0.113.44."
            }
          ]
        },
        {
          "key": "nginx",
          "title": "Install and verify NGINX",
          "instruction": "Run `sudo apt update`, `sudo apt install -y nginx`, and `systemctl status nginx`. Optionally run `echo '<h1>Welcome to Tailwind Traders - served from vm-web-01</h1>' | sudo tee /var/www/html/index.html`.",
          "explanation": "Verify the workload before changing network exposure.",
          "targetId": "cloud-shell-terminal",
          "rules": [
            {
              "key": "installed",
              "description": "NGINX is installed",
              "rule": {
                "type": "arrayContains",
                "path": "virtualMachines",
                "match": {
                  "name": "vm-web-01",
                  "nginxInstalled": true,
                  "nginxStatus": "active (running)"
                }
              }
            },
            {
              "key": "checked",
              "description": "NGINX status was checked",
              "rule": {
                "type": "commandUsed",
                "pattern": "^systemctl status nginx$"
              }
            }
          ]
        },
        {
          "key": "timeout",
          "title": "Confirm HTTP is blocked",
          "instruction": "Open `http://203.0.113.44`; the browser should time out while port 80 is closed.",
          "explanation": "The VM can be healthy while the NSG still blocks inbound HTTP.",
          "rules": [
            {
              "key": "browser-error",
              "description": "NGINX is installed before opening HTTP in the NSG",
              "rule": {
                "type": "arrayContains",
                "path": "virtualMachines",
                "match": {
                  "name": "vm-web-01",
                  "nginxInstalled": true
                }
              }
            }
          ]
        },
        {
