            "breadcrumb": [
              "Home",
              "Virtual machines",
              "vm-web-01",
              "Network settings"
            ],
            "components": [
              {
                "kind": "form",
                "id": "inbound-rule-form",
                "title": "Inbound port rule",
                "fields": [
                  {
                    "id": "service",
                    "label": "Service",
                    "control": "select",
                    "required": true,
                    "defaultValue": "HTTP",
                    "options": [
                      {
                        "value": "HTTP",
                        "label": "HTTP"
                      },
                      {
                        "value": "HTTPS",
                        "label": "HTTPS"
                      },
                      {
                        "value": "SSH",
                        "label": "SSH"
                      },
                      {
                        "value": "RDP",
                        "label": "RDP"
                      },
                      {
                        "value": "Custom",
                        "label": "Custom"
                      }
                    ]
                  },
                  {
                    "id": "source",
                    "label": "Source",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Internet",
                    "options": [
                      {
                        "value": "Internet",
                        "label": "Internet"
                      },
                      {
                        "value": "Any",
                        "label": "Any"
                      }
                    ]
                  },
                  {
                    "id": "port",
                    "label": "Destination port ranges",
                    "control": "text",
                    "required": true,
                    "defaultValue": "80"
                  },
                  {
                    "id": "protocol",
                    "label": "Protocol",
                    "control": "select",
                    "required": true,
                    "defaultValue": "TCP",
                    "options": [
                      {
                        "value": "TCP",
                        "label": "TCP"
                      },
                      {
                        "value": "Any",
                        "label": "Any"
                      }
                    ]
                  },
                  {
                    "id": "action",
                    "label": "Action",
                    "control": "radio",
                    "required": true,
                    "defaultValue": "Allow",
                    "options": [
                      {
                        "value": "Allow",
                        "label": "Allow"
                      },
                      {
                        "value": "Deny",
                        "label": "Deny"
                      }
                    ]
                  },
                  {
                    "id": "priority",
                    "label": "Priority",
                    "control": "number",
                    "required": true,
                    "defaultValue": 300,
                    "min": 100,
                    "max": 4096
                  },
                  {
                    "id": "name",
                    "label": "Name",
                    "control": "text",
                    "required": true,
                    "defaultValue": "Allow-HTTP-Internet"
                  }
                ],
                "submit": {
                  "label": "Add",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.service",
                        "value": "HTTP"
                      },
                      "message": "Open only HTTP for this website; SSH, RDP, HTTPS, or Custom/* is broader than required."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.port",
                        "value": "80"
                      },
                      "message": "HTTP uses TCP port 80. Do not open * or management ports."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.protocol",
                        "value": "TCP"
                      },
                      "message": "HTTP uses TCP."
                    },
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.source",
                        "value": "Any"
                      },
                      "message": "Use Internet for the public website; Any is broader than needed."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "nsgRules",
                      "unique": "name",
                      "value": {
                        "name": "{{$form.name}}",
                        "priority": "{{$form.priority}}",
                        "source": "{{$form.source}}",
                        "port": "{{$form.port}}",
                        "protocol": "{{$form.protocol}}",
                        "access": "{{$form.action}}"
                      }
                    },
                    {
                      "type": "update",
                      "path": "virtualMachines",
                      "where": {
                        "name": "vm-web-01"
                      },
                      "set": {
                        "httpOpen": true
                      }
                    },
                    {
                      "type": "set",
                      "path": "website.url",
                      "value": "http://203.0.113.44"
                    },
                    {
                      "type": "navigate",
                      "page": "vm-networking"
                    },
                    {
                      "type": "notify",
                      "title": "Inbound rule created",
                      "message": "HTTP is now allowed on TCP port 80."
                    }
                  ]
                }
              }
            ]
