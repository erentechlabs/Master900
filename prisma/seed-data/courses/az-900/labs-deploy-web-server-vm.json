{
  "labs": [
    {
      "slug": "deploy-web-server-vm",
      "type": "UI_SIMULATION",
      "title": "Publish a web server on an Azure virtual machine",
      "summary": "SSH to an existing Ubuntu VM, install NGINX, open only HTTP in Network settings, verify the site, and enable auto-shutdown.",
      "scenario": "Tailwind Traders has a running Ubuntu Server VM named **vm-web-01**. Its NSG allows only SSH from the administrator workstation. In the simulated Azure portal VM, SSH to the VM, install NGINX, prove `http://203.0.113.44` times out while TCP 80 is closed, add only an inbound **HTTP** rule, reload the site, and enable **Auto-shutdown** at **19:00**. Do not expose SSH, RDP or all ports to the internet.",
      "domainKey": "azure-architecture-services",
      "moduleSlug": "azure-compute-and-networking",
      "objectiveCode": "2.2",
      "complexity": "INTERMEDIATE",
      "estimatedMinutes": 25,
      "learningObjectives": [
        "Use SSH to administer a Linux VM",
        "Install and verify a web server before exposing it",
        "Add a least-privilege inbound NSG rule",
        "Enable VM auto-shutdown"
      ],
      "prerequisites": [
        "Know what SSH, HTTP, and network security groups are"
      ],
      "sources": [
        {
          "title": "Quickstart: Create a Linux virtual machine in the Azure portal",
          "url": "https://learn.microsoft.com/en-us/azure/virtual-machines/linux/quick-create-portal"
        },
        {
          "title": "Tutorial: Filter network traffic with a network security group",
          "url": "https://learn.microsoft.com/en-us/azure/virtual-network/tutorial-filter-network-traffic"
        },
        {
          "title": "Auto-shutdown a VM",
          "url": "https://learn.microsoft.com/en-us/azure/virtual-machines/auto-shutdown-vm"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Azure",
          "theme": "azure",
          "user": "alex@contoso.example",
          "tenant": "Contoso (contoso.example)",
          "url": "https://portal.azure.com",
          "searchPlaceholder": "Search resources, services, and docs (G+/)"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser",
            "terminal"
          ]
        },
        "terminal": {
          "title": "Terminal / Cloud Shell (Bash)",
          "prompt": "{{shell.user}}@{{shell.host}}:~$",
          "surface": "both",
          "welcome": "Use SSH before running Linux package commands on vm-web-01.",
          "fallback": "{{$cmd}}: command not available in this simulated environment. Type help.",
          "commands": [
            {
              "id": "ssh",
              "pattern": "^ssh azureuser@203\\.0\\.113\\.44$",
              "help": "ssh azureuser@203.0.113.44",
              "actions": [
                {
                  "type": "set",
                  "path": "shell",
                  "value": {
                    "user": "azureuser",
                    "host": "vm-web-01",
                    "connected": true
                  }
                }
              ],
              "output": "Welcome to Ubuntu Server on vm-web-01 (simulation)."
            },
            {
              "id": "apt-before-ssh",
              "pattern": "^sudo apt( update| install -y nginx)$",
              "when": {
                "type": "notEquals",
                "path": "shell.connected",
                "value": true
              },
              "error": "sudo: apt: command not found on LAB-VM-01. SSH to the Linux VM first."
            },
            {
              "id": "apt-update",
              "pattern": "^sudo apt update$",
              "when": {
                "type": "equals",
                "path": "shell.connected",
                "value": true
              },
              "help": "sudo apt update",
              "actions": [
                {
                  "type": "update",
                  "path": "virtualMachines",
                  "where": {
                    "name": "vm-web-01"
                  },
                  "set": {
                    "packagesUpdated": true
                  }
                }
              ],
              "output": "Hit:1 http://azure.archive.ubuntu.example noble InRelease\nReading package lists... Done"
            },
            {
              "id": "install",
              "pattern": "^sudo apt install -y nginx$",
              "when": {
                "type": "equals",
                "path": "shell.connected",
                "value": true
              },
              "help": "sudo apt install -y nginx",
              "actions": [
                {
                  "type": "update",
                  "path": "virtualMachines",
                  "where": {
                    "name": "vm-web-01"
                  },
                  "set": {
                    "nginxInstalled": true,
                    "nginxStatus": "active (running)",
                    "siteText": "Welcome to Tailwind Traders"
                  }
                }
              ],
              "output": "Setting up nginx ... done"
            },
            {
              "id": "status",
              "pattern": "^systemctl status nginx$",
              "when": {
                "type": "arrayContains",
                "path": "virtualMachines",
                "match": {
                  "name": "vm-web-01",
                  "nginxInstalled": true
                }
              },
              "help": "systemctl status nginx",
              "output": "nginx.service - A high performance web server\nActive: active (running)"
            },
            {
              "id": "index",
              "pattern": "^echo .+ \\| sudo tee /var/www/html/index\\.html$",
              "when": {
                "type": "arrayContains",
                "path": "virtualMachines",
                "match": {
                  "name": "vm-web-01",
                  "nginxInstalled": true
                }
              },
              "help": "echo '<h1>Welcome</h1>' | sudo tee /var/www/html/index.html",
              "actions": [
                {
                  "type": "update",
                  "path": "virtualMachines",
                  "where": {
                    "name": "vm-web-01"
                  },
                  "set": {
                    "indexCustomized": true,
                    "siteText": "Welcome to Tailwind Traders - served from vm-web-01"
                  }
                }
              ],
              "output": "<h1>Welcome to Tailwind Traders - served from vm-web-01</h1>"
            }
          ]
        },
        "clock": {
          "start": "2026-09-30T09:00:00Z"
        },
