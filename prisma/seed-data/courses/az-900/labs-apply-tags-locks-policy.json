      "components": [
       {
        "kind": "form",
        "id": "rg-tags-form",
        "title": "Tags",
        "description": "Add key/value metadata for cost allocation and ownership reporting. Tags are not permissions and should not contain secrets.",
        "fields": [
         {
          "id": "tagName1",
          "label": "Name",
          "control": "text",
          "required": true,
          "defaultValue": "CostCenter"
         },
         {
          "id": "tagValue1",
          "label": "Value",
          "control": "text",
          "required": true,
          "defaultValue": "FIN-042"
         },
         {
          "id": "tagName2",
          "label": "Name 2",
          "control": "text",
          "required": true,
          "defaultValue": "Environment"
         },
         {
          "id": "tagValue2",
          "label": "Value 2",
          "control": "text",
          "required": true,
          "defaultValue": "Production"
         }
        ],
        "submit": {
         "label": "Save",
         "checks": [
          {
           "rule": {
            "type": "equals",
            "path": "$form.tagName1",
            "value": "CostCenter"
           },
           "message": "Use CostCenter exactly."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.tagValue1",
            "value": "FIN-042"
           },
           "message": "Use FIN-042."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.tagName2",
            "value": "Environment"
           },
           "message": "Use Environment exactly."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.tagValue2",
            "value": "Production"
           },
           "message": "Use Production."
          }
         ],
         "actions": [
          {
           "type": "update",
           "path": "resourceGroups",
           "where": {
            "name": "{{$sel.rg.name}}"
           },
           "set": {
            "tags.CostCenter": "{{$form.tagValue1}}",
            "tags.Environment": "{{$form.tagValue2}}",
            "tagNote": "Resources do not inherit these tags automatically."
           }
          },
          {
           "type": "notify",
           "title": "Tags saved",
           "message": "Tags were applied to {{$sel.rg.name}}."
          },
          {
           "type": "navigate",
           "page": "rg-overview"
          }
         ]
        }
       }
      ]
