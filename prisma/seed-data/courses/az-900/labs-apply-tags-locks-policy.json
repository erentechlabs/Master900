{
 "labs": [
  {
   "slug": "apply-tags-locks-policy",
   "type": "UI_SIMULATION",
   "title": "Apply tags, a delete lock, and an allowed locations policy",
   "summary": "Use Azure portal governance blades to tag a finance resource group, protect it with a delete lock, assign an allowed locations policy, and review compliance.",
   "scenario": "Contoso Finance is preparing **rg-finance-prod** for production governance. In the **simulated Azure portal** on your lab VM, add resource-group tags **CostCenter = FIN-042** and **Environment = Production**, add a **Delete** lock named **lock-finance-delete**, and assign the built-in **Allowed locations** Azure Policy definition at the resource group scope. Allow only **(Europe) West Europe** and **(Europe) North Europe**, add a non-compliance message, then refresh compliance to find the existing Sweden Central resource. Resources do not automatically inherit resource-group tags unless a policy or automation applies them.",
   "domainKey": "azure-management-governance",
   "moduleSlug": "governance-and-compliance",
   "objectiveCode": "3.2",
   "complexity": "BASIC",
   "estimatedMinutes": 25,
   "learningObjectives": [
    "Apply resource-group tags for cost allocation and explain inheritance boundaries",
    "Choose a Delete lock instead of an overly restrictive Read-only lock",
    "Assign an Azure Policy definition and interpret compliance results",
    "Differentiate Azure Policy, RBAC, and resource locks"
   ],
   "prerequisites": [
    "Know what a resource group is",
    "Know that Azure Policy evaluates resource compliance"
   ],
   "sources": [
    {
     "title": "Tag resources, resource groups, and subscriptions with Azure portal",
     "url": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/management/tag-resources-portal"
    },
    {
     "title": "Lock your Azure resources to protect your infrastructure",
     "url": "https://learn.microsoft.com/en-us/azure/azure-resource-manager/management/lock-resources"
    },
    {
     "title": "Quickstart: Create policy assignment using Azure portal",
     "url": "https://learn.microsoft.com/en-us/azure/governance/policy/assign-policy-portal"
    },
    {
     "title": "Overview of Azure Policy",
     "url": "https://learn.microsoft.com/en-us/azure/governance/policy/overview"
    }
   ],
