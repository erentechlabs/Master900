   "steps": [
    {
     "key": "open-finance-rg",
     "title": "Open the finance resource group",
     "instruction": "In **Resource groups**, open **rg-finance-prod** and review its **Essentials** and resources.",
     "hint": "Select the resource group name in the table.",
     "explanation": "Governance controls are commonly applied at a resource group or subscription scope.",
     "targetId": "rg-list",
     "rules": [
      {
       "key": "visited-rg",
       "description": "rg-finance-prod was opened",
       "rule": {
        "type": "visited",
        "page": "rg-overview"
       }
      }
     ]
    },
    {
     "key": "add-tags",
     "title": "Add finance tags",
     "instruction": "Open **Tags** and save **CostCenter = FIN-042** and **Environment = Production** on the resource group.",
     "hint": "These tags organize the resource group for reporting. Existing child resources do not inherit them automatically.",
     "explanation": "Tags are metadata for organization and cost allocation, not permissions.",
     "targetId": "rg-tags-form",
     "rules": [
      {
       "key": "rg-tags",
       "description": "The resource group has both required tags",
       "rule": {
        "type": "arrayContains",
        "path": "resourceGroups",
        "match": {
         "name": "rg-finance-prod",
         "tags.CostCenter": "FIN-042",
         "tags.Environment": "Production"
        }
       },
       "failureFeedback": "Add CostCenter FIN-042 and Environment Production."
      }
     ]
    },
    {
     "key": "add-delete-lock",
     "title": "Add a Delete lock",
     "instruction": "Open **Locks** and add a lock named **lock-finance-delete** with **Lock type** set to **Delete**.",
     "hint": "Do not choose Read-only. It can block legitimate management operations such as starting VMs or listing storage keys.",
     "explanation": "A Delete lock protects against accidental deletion while still allowing permitted updates.",
     "targetId": "add-lock-form",
     "rules": [
      {
       "key": "delete-lock",
       "description": "A Delete lock protects the resource group",
       "rule": {
        "type": "arrayContains",
        "path": "locks",
        "match": {
         "name": "lock-finance-delete",
         "scope": "rg-finance-prod",
         "level": "Delete"
        }
       },
       "failureFeedback": "Add a Delete lock named lock-finance-delete."
      }
     ]
    },
    {
     "key": "assign-allowed-locations",
     "title": "Assign the Allowed locations policy",
     "instruction": "In **Policy > Assignments**, select **Assign policy**. Set **Scope** to **rg-finance-prod**, **Policy definition** to **Allowed locations**, **Assignment name** to **finance-allowed-locations**, and **Allowed locations** to **(Europe) West Europe** and **(Europe) North Europe**. Add the non-compliance message shown in the scenario, then select **Review + create** and **Create**.",
     "hint": "The Sweden Central location must not be allowed so the existing App Service is reported as non-compliant.",
     "explanation": "Azure Policy evaluates resources against standards such as allowed regions.",
     "targetId": "assign-policy",
     "rules": [
      {
       "key": "assignment-created",
       "description": "Allowed locations is assigned at rg-finance-prod",
       "rule": {
        "type": "arrayContains",
        "path": "policyAssignments",
        "match": {
         "name": "finance-allowed-locations",
         "definition": "Allowed locations",
         "scope": "rg-finance-prod"
        }
       },
       "failureFeedback": "Create the finance-allowed-locations assignment."
      }
     ]
    },
    {
     "key": "refresh-compliance",
     "title": "Refresh compliance",
     "instruction": "Open **Policy compliance** and select **Refresh** to simulate the policy evaluation cycle.",
     "hint": "The existing App Service in Sweden Central should appear as non-compliant.",
     "explanation": "Policy compliance is evaluated after assignment; the dashboard shows which resources match or violate the rule.",
     "targetId": "policy-refresh",
     "rules": [
      {
       "key": "noncompliant-resource",
       "description": "The Sweden Central resource is non-compliant",
       "rule": {
        "type": "arrayContains",
        "path": "resources",
        "match": {
         "name": "app-fin-payroll",
         "compliance": "Non-compliant"
        }
       },
       "failureFeedback": "Refresh policy compliance after creating the assignment."
      }
     ]
    },
    {
     "key": "review-governance-differences",
     "title": "Review Policy, RBAC, and locks",
     "instruction": "On **Policy compliance**, read the callout that compares **Azure Policy**, **RBAC**, and **resource locks**.",
     "hint": "Policy is for standards, RBAC is for permissions, and locks protect management operations.",
     "explanation": "These controls are complementary, not interchangeable.",
     "targetId": "compliance-assignments",
     "rules": [
      {
       "key": "evaluation-complete",
       "description": "Compliance evaluation is completed",
       "rule": {
        "type": "equals",
        "path": "policyEvaluation.state",
        "value": "Completed"
       }
      }
     ]
    }
   ],
   "finalRules": [
    {
     "key": "no-readonly-lock",
     "description": "No Read-only lock exists on rg-finance-prod",
     "rule": {
      "type": "arrayNotContains",
      "path": "locks",
      "match": {
       "scope": "rg-finance-prod",
       "level": "Read-only"
      }
     },
     "failureFeedback": "Remove any Read-only lock and add a Delete lock instead."
    },
    {
     "key": "allowed-locations-exact",
     "description": "Allowed locations are West Europe and North Europe",
     "rule": {
      "type": "arrayContains",
      "path": "policyAssignments",
      "match": {
       "name": "finance-allowed-locations",
       "allowedLocations": [
        "westeurope",
        "northeurope"
       ]
      }
     },
     "failureFeedback": "The assignment must allow only West Europe and North Europe."
    }
   ],
   "solution": "1. Select **Resource groups**, then open **rg-finance-prod**.\n2. Open **Tags**. Set **Name** `CostCenter`, **Value** `FIN-042`, **Name 2** `Environment`, **Value 2** `Production`, then select **Save**.\n3. Open **Locks**. In **Add lock**, enter **Lock name** `lock-finance-delete`, set **Lock type** to **Delete**, keep a note, then select **OK**. Do not choose **Read-only**.\n4. Open **Policy > Assignments**, select **Assign policy**, set **Scope** to `rg-finance-prod`, **Policy definition** to **Allowed locations**, and **Assignment name** to `finance-allowed-locations`.\n5. On **Parameters**, select **(Europe) West Europe** and **(Europe) North Europe** only. On **Non-compliance messages**, enter `Finance production resources must be deployed only in West Europe or North Europe.` Select **Review + create** and **Create**.\n6. Open **Policy compliance** and select **Refresh**. Confirm **app-fin-payroll** is **Non-compliant**."
  }
