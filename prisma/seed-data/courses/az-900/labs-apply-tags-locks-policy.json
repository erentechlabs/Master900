     {
      "id": "policy-assign",
      "title": "Assign policy",
      "subtitle": "Azure Policy",
      "icon": "ClipboardCheck",
      "url": "/#view/Microsoft_Azure_Policy/CreateAssignmentBlade",
      "navItem": "policy-assignments",
      "breadcrumb": [
       "Home",
       "Policy",
       "Assignments"
      ],
      "components": [
       {
        "kind": "wizard",
        "id": "policy-assignment-wizard",
        "description": "Assign a built-in policy definition to a scope. The assignment evaluates matching resources and reports compliance.",
        "reviewLabel": "Review + create",
        "tabs": [
         {
          "id": "basics",
          "label": "Basics",
          "fields": [
           {
            "id": "scope",
            "label": "Scope",
            "control": "select",
            "required": true,
            "options": [
             {
              "value": "rg-finance-prod",
              "label": "rg-finance-prod"
             }
            ],
            "defaultValue": "rg-finance-prod"
           },
           {
            "id": "definition",
            "label": "Policy definition",
            "control": "select",
            "required": true,
            "options": [
             {
              "value": "Allowed locations",
              "label": "Allowed locations"
             },
             {
              "value": "Require a tag and its value on resources",
              "label": "Require a tag and its value on resources"
             },
             {
              "value": "Allowed resource types",
              "label": "Allowed resource types"
             }
            ],
            "defaultValue": "Allowed locations"
           },
           {
            "id": "assignmentName",
            "label": "Assignment name",
            "control": "text",
            "required": true,
            "defaultValue": "finance-allowed-locations"
           }
          ]
         },
         {
          "id": "parameters",
          "label": "Parameters",
          "fields": [
           {
            "id": "allowedLocations",
            "label": "Allowed locations",
            "control": "checkboxes",
            "required": true,
            "defaultValue": [
             "westeurope",
             "northeurope"
            ],
            "options": [
             {
              "value": "westeurope",
              "label": "(Europe) West Europe"
             },
             {
              "value": "northeurope",
              "label": "(Europe) North Europe"
             },
             {
              "value": "swedencentral",
              "label": "(Europe) Sweden Central"
             },
             {
              "value": "eastus",
              "label": "(US) East US"
             }
            ]
           }
          ]
         },
         {
          "id": "messages",
          "label": "Non-compliance messages",
          "fields": [
           {
            "id": "nonComplianceMessage",
            "label": "Message",
            "control": "textarea",
            "required": true,
            "defaultValue": "Finance production resources must be deployed only in West Europe or North Europe."
           }
          ]
         },
         {
          "id": "review",
          "label": "Review + create",
          "fields": []
         }
        ],
        "submit": {
         "label": "Create",
         "checks": [
          {
           "rule": {
            "type": "equals",
            "path": "$form.definition",
            "value": "Allowed locations"
           },
           "message": "Choose Allowed locations."
          },
          {
           "rule": {
            "type": "includes",
            "path": "$form.allowedLocations",
            "value": "westeurope"
           },
           "message": "West Europe must be allowed."
          },
          {
           "rule": {
            "type": "includes",
            "path": "$form.allowedLocations",
            "value": "northeurope"
           },
           "message": "North Europe must be allowed."
          },
          {
           "rule": {
            "type": "not",
            "rule": {
             "type": "includes",
             "path": "$form.allowedLocations",
             "value": "swedencentral"
            }
           },
           "message": "Do not allow Sweden Central; an existing resource should be non-compliant."
          }
         ],
         "actions": [
          {
           "type": "append",
           "path": "policyAssignments",
           "unique": "name",
           "value": {
            "name": "{{$form.assignmentName}}",
            "definition": "{{$form.definition}}",
            "scope": "{{$form.scope}}",
            "allowedLocations": "{{$form.allowedLocations | list}}",
            "message": "{{$form.nonComplianceMessage}}",
            "complianceState": "Not evaluated"
           }
          },
          {
           "type": "notify",
           "title": "Policy assignment created",
           "message": "Assignment {{$form.assignmentName}} was created."
          },
          {
           "type": "navigate",
           "page": "policy-compliance"
          }
         ]
        }
       }
      ]
     },
     {
      "id": "policy-compliance",
      "title": "Policy | Compliance",
      "subtitle": "Contoso (contoso.example)",
      "icon": "ListChecks",
      "url": "/#view/Microsoft_Azure_Policy/PolicyMenuBlade/~/Compliance",
      "breadcrumb": [
       "Home",
       "Policy"
      ],
      "commands": [
       {
        "id": "policy-refresh",
        "label": "Refresh",
        "icon": "RefreshCw",
        "variant": "primary",
        "action": {
         "type": "sequence",
         "actions": [
          {
           "type": "update",
           "path": "resources",
           "where": {
            "resourceGroup": "rg-finance-prod",
            "location": "swedencentral"
           },
           "set": {
            "compliance": "Non-compliant",
            "complianceReason": "Location Sweden Central is not allowed."
           }
          },
          {
           "type": "update",
           "path": "resources",
           "where": {
            "resourceGroup": "rg-finance-prod",
            "location": "westeurope"
           },
           "set": {
            "compliance": "Compliant",
            "complianceReason": "Location is allowed."
           }
          },
          {
           "type": "update",
           "path": "resources",
           "where": {
            "resourceGroup": "rg-finance-prod",
            "location": "northeurope"
           },
           "set": {
            "compliance": "Compliant",
            "complianceReason": "Location is allowed."
           }
          },
          {
           "type": "update",
           "path": "policyAssignments",
           "where": {
            "name": "finance-allowed-locations"
           },
           "set": {
            "complianceState": "1 non-compliant resource"
           }
          },
          {
           "type": "set",
           "path": "policyEvaluation.state",
           "value": "Completed"
          },
          {
           "type": "notify",
           "title": "Compliance evaluation refreshed",
           "message": "Azure Policy found one non-compliant resource."
          }
         ]
        }
       }
      ],
      "components": [
       {
        "kind": "callout",
        "variant": "info",
        "title": "Policy, RBAC, and locks",
        "text": "Azure Policy evaluates and can enforce resource standards. RBAC grants who can perform actions. Resource locks prevent management operations such as deletion or updates at a scope."
       },
       {
        "kind": "table",
        "id": "compliance-assignments",
        "title": "Assignments",
        "source": "policyAssignments",
        "rowKey": "name",
        "columns": [
         {
          "key": "name",
          "label": "Assignment"
         },
         {
          "key": "definition",
          "label": "Definition"
         },
         {
          "key": "scope",
          "label": "Scope"
