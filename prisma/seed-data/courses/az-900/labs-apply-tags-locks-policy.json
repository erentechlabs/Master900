      "components": [
       {
        "kind": "table",
        "id": "locks-table",
        "title": "Locks",
        "source": "locks",
        "where": {
         "scope": "{{$sel.rg.name}}"
        },
        "rowKey": "name",
        "emptyText": "No locks configured.",
        "columns": [
         {
          "key": "name",
          "label": "Name",
          "format": "link"
         },
         {
          "key": "level",
          "label": "Lock type"
         },
         {
          "key": "notes",
          "label": "Notes"
         }
        ]
       },
       {
        "kind": "form",
        "id": "add-lock-form",
        "title": "Add lock",
        "description": "Choose Delete to prevent accidental deletion while still allowing permitted operational changes. Read-only would block many control-plane operations.",
        "fields": [
         {
          "id": "lockName",
          "label": "Lock name",
          "control": "text",
          "required": true,
          "defaultValue": "lock-finance-delete",
          "pattern": "^[A-Za-z0-9_.-]{3,80}$",
          "patternMessage": "Use 3-80 letters, numbers, dots, underscores, or hyphens."
         },
         {
          "id": "lockType",
          "label": "Lock type",
          "control": "radio",
          "required": true,
          "defaultValue": "CanNotDelete",
          "options": [
           {
            "value": "CanNotDelete",
            "label": "Delete"
           },
           {
            "value": "ReadOnly",
            "label": "Read-only"
           }
          ]
         },
         {
          "id": "notes",
          "label": "Notes",
          "control": "textarea",
          "required": true,
          "defaultValue": "Prevent accidental deletion of production finance resources."
         }
        ],
        "submit": {
         "label": "OK",
         "checks": [
          {
           "rule": {
            "type": "equals",
            "path": "$form.lockType",
            "value": "CanNotDelete"
           },
           "message": "Use Delete. Read-only would also block legitimate operations such as starting VMs or listing storage keys."
          }
         ],
         "actions": [
          {
           "type": "append",
           "path": "locks",
           "unique": "name",
           "value": {
            "name": "{{$form.lockName}}",
            "scope": "{{$sel.rg.name}}",
            "level": "Delete",
            "lockType": "{{$form.lockType}}",
            "notes": "{{$form.notes}}"
           }
          },
          {
           "type": "update",
           "path": "resourceGroups",
           "where": {
            "name": "{{$sel.rg.name}}"
           },
           "set": {
            "lockSummary": "Delete"
           }
          },
          {
           "type": "notify",
           "title": "Lock added",
           "message": "Delete lock {{$form.lockName}} was added."
          }
         ]
        }
       }
      ]
     },
