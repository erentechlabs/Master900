{
 "labs": [
  {
   "slug": "create-budget-review-advisor",
   "type": "UI_SIMULATION",
   "title": "Create a budget and resolve an Azure Advisor cost recommendation",
   "summary": "Use Cost Management to review fictional spending, create a monthly budget with alerts, and act on an Azure Advisor cost recommendation.",
   "scenario": "Fabrikam platform team wants earlier cost conversations for its Azure subscription. In the **simulated Azure portal** on your lab VM, review **Cost Management > Cost analysis**, create a monthly subscription budget named **budget-platform-monthly** with fictional amount **5000**, alert on **Actual 80%** and **Forecasted 100%**, send notifications to **finance@contoso.example**, then open **Azure Advisor > Cost** and resolve the recommendation to right-size or shut down **vm-test-03**. Budgets notify people but do not stop or change resources automatically.",
   "domainKey": "azure-management-governance",
   "moduleSlug": "cost-management",
   "objectiveCode": "3.1",
   "complexity": "BASIC",
   "estimatedMinutes": 25,
   "learningObjectives": [
    "Analyze cost by service and resource group with fictional amounts",
    "Create budget thresholds and recipients",
    "Explain that budgets alert but do not stop resources",
    "Use Azure Advisor cost recommendations and recognize Advisor categories"
   ],
   "prerequisites": [
    "Know that Azure Cost Management tracks actual and forecasted spend"
   ],
   "sources": [
    {
     "title": "Tutorial - Create and manage budgets",
     "url": "https://learn.microsoft.com/en-us/azure/cost-management-billing/costs/tutorial-acm-create-budgets"
    },
    {
     "title": "Analyze costs with Cost analysis",
     "url": "https://learn.microsoft.com/en-us/azure/cost-management-billing/costs/quick-acm-cost-analysis"
    },
    {
     "title": "Introduction to Azure Advisor",
     "url": "https://learn.microsoft.com/en-us/azure/advisor/advisor-overview"
    },
    {
     "title": "Optimize VM spend by resizing or shutting down underutilized instances",
     "url": "https://learn.microsoft.com/en-us/azure/advisor/advisor-cost-recommendations"
    }
   ],
