        "kind": "table",
        "id": "advisor-cost-list",
        "title": "Cost recommendations",
        "source": "advisorRecommendations",
        "where": {
         "category": "Cost"
        },
        "rowKey": "id",
        "columns": [
         {
          "key": "title",
          "label": "Recommendation",
          "format": "link"
         },
         {
          "key": "resource",
          "label": "Resource"
         },
         {
          "key": "impact",
