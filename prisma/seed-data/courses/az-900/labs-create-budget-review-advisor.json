     {
      "id": "budget-create",
      "title": "Create budget",
      "subtitle": "Cost Management",
      "icon": "Receipt",
      "url": "/#view/Microsoft_Azure_CostManagement/CreateBudgetBlade",
      "navItem": "budgets",
      "breadcrumb": [
       "Home",
       "Cost Management",
       "Budgets"
      ],
      "components": [
       {
        "kind": "wizard",
        "id": "budget-wizard",
        "description": "Create a Cost Management budget. Alerts notify recipients; resources continue running unless an operator or automation changes them.",
        "reviewLabel": "Review + create",
        "tabs": [
         {
          "id": "basics",
          "label": "Basics",
          "fields": [
           {
            "id": "scope",
            "label": "Scope",
            "control": "select",
            "required": true,
            "defaultValue": "Subscription: Contoso Learning (simulated)",
            "options": [
             {
              "value": "Subscription: Contoso Learning (simulated)",
              "label": "Subscription: Contoso Learning (simulated)"
             },
             {
              "value": "Resource group: rg-platform-dev",
              "label": "Resource group: rg-platform-dev"
             }
            ]
           },
           {
            "id": "name",
            "label": "Name",
            "control": "text",
            "required": true,
            "defaultValue": "budget-platform-monthly",
            "pattern": "^[A-Za-z0-9_.-]{3,80}$",
            "patternMessage": "Use a short budget name."
           },
           {
            "id": "resetPeriod",
            "label": "Reset period",
            "control": "select",
            "required": true,
            "defaultValue": "Monthly",
            "options": [
             {
              "value": "Monthly",
              "label": "Monthly"
             },
             {
              "value": "Quarterly",
              "label": "Quarterly"
             },
             {
              "value": "Annually",
              "label": "Annually"
             }
            ]
           },
           {
            "id": "creationDate",
            "label": "Creation date",
            "control": "text",
            "required": true,
            "defaultValue": "2026-10-01",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "patternMessage": "Use YYYY-MM-DD."
           },
           {
            "id": "expirationDate",
            "label": "Expiration date",
            "control": "text",
            "required": true,
            "defaultValue": "2027-09-30",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "patternMessage": "Use YYYY-MM-DD."
           },
           {
            "id": "amount",
            "label": "Amount",
            "control": "number",
            "required": true,
            "defaultValue": 5000,
            "min": 1,
            "help": "Fictional training amount only."
           }
          ]
         },
         {
          "id": "conditions",
          "label": "Alert conditions",
          "fields": [
           {
            "id": "actualThreshold",
            "label": "Actual threshold",
            "control": "number",
            "required": true,
            "defaultValue": 80,
            "min": 1,
            "max": 100
           },
           {
            "id": "forecastedThreshold",
            "label": "Forecasted threshold",
            "control": "number",
            "required": true,
            "defaultValue": 100,
            "min": 1,
            "max": 100
           },
           {
            "id": "recipients",
            "label": "Alert recipients",
            "control": "text",
            "required": true,
            "defaultValue": "finance@contoso.example",
            "pattern": "^[^@\\s]+@[^@\\s]+\\.example$",
            "patternMessage": "Use a fictional .example recipient."
           }
          ]
         },
         {
          "id": "review",
          "label": "Review + create",
          "fields": []
         }
        ],
        "submit": {
         "label": "Create",
         "checks": [
          {
           "rule": {
            "type": "equals",
            "path": "$form.scope",
            "value": "Subscription: Contoso Learning (simulated)"
           },
           "message": "Create the budget at subscription scope."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.name",
            "value": "budget-platform-monthly"
           },
           "message": "Use budget-platform-monthly."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.resetPeriod",
            "value": "Monthly"
           },
           "message": "Use Monthly."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.actualThreshold",
            "value": 80
           },
           "message": "Set Actual threshold to 80."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.forecastedThreshold",
            "value": 100
           },
           "message": "Set Forecasted threshold to 100."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.recipients",
            "value": "finance@contoso.example"
           },
           "message": "Send budget alerts to finance@contoso.example."
          }
         ],
         "actions": [
          {
           "type": "append",
           "path": "budgets",
           "unique": "name",
           "value": {
            "name": "{{$form.name}}",
            "scope": "{{$form.scope}}",
            "resetPeriod": "{{$form.resetPeriod}}",
            "creationDate": "{{$form.creationDate}}",
            "expirationDate": "{{$form.expirationDate}}",
            "amount": "{{$form.amount}}",
            "actualThreshold": "{{$form.actualThreshold}}",
            "forecastedThreshold": "{{$form.forecastedThreshold}}",
            "recipients": [
             "{{$form.recipients}}"
            ],
            "status": "Active"
           }
          },
          {
           "type": "notify",
           "title": "Budget created",
           "message": "Budget {{$form.name}} was created. Alerts notify recipients but do not stop resources."
          },
          {
           "type": "navigate",
           "page": "budgets"
          }
         ]
        }
       }
      ]
     },
