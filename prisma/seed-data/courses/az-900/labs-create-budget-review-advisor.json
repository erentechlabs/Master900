   "steps": [
    {
     "key": "review-cost-analysis",
     "title": "Review Cost analysis",
     "instruction": "Open **Cost Management** and review **Cost analysis** by service and resource group. Notice the fictional round amounts and rising test-lab trend.",
     "hint": "The chart and table use training-only amounts.",
     "explanation": "Cost analysis helps identify where spend is coming from before teams decide what to optimize.",
     "targetId": "service-cost-chart",
     "rules": [
      {
       "key": "visited-cost",
       "description": "Cost analysis was opened",
       "rule": {
        "type": "visited",
        "page": "cost-analysis"
       }
      }
     ]
    },
    {
     "key": "open-budget-create",
     "title": "Open budget creation",
     "instruction": "Open **Budgets** and select **Add**.",
     "hint": "Budgets live under Cost Management at a selected billing or Azure scope.",
     "explanation": "A budget is scoped to the cost boundary you want to track.",
     "targetId": "budget-add",
     "rules": [
      {
       "key": "visited-budget-create",
       "description": "Budget creation was opened",
       "rule": {
        "type": "visited",
        "page": "budget-create"
       }
      }
     ]
    },
    {
     "key": "create-budget",
     "title": "Create the monthly budget",
     "instruction": "Create **budget-platform-monthly** at **Subscription: Contoso Learning (simulated)** scope. Use **Reset period** **Monthly**, creation date **2026-10-01**, expiration date **2027-09-30**, fictional **Amount** `5000`, **Actual threshold** `80`, **Forecasted threshold** `100`, and **Alert recipients** `finance@contoso.example`.",
     "hint": "Budgets alert recipients; they do not stop resources automatically.",
     "explanation": "Actual and forecasted thresholds give finance and operators early warning from different perspectives.",
     "targetId": "budget-wizard",
     "rules": [
      {
       "key": "budget-created",
       "description": "The budget exists with required scope and recipient",
       "rule": {
        "type": "arrayContains",
        "path": "budgets",
        "match": {
         "name": "budget-platform-monthly",
         "scope": "Subscription: Contoso Learning (simulated)",
         "resetPeriod": "Monthly",
         "actualThreshold": 80,
         "forecastedThreshold": 100
        }
       },
