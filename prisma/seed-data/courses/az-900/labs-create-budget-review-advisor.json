          "format": "status"
         },
         {
          "key": "resolution",
          "label": "Resolution"
         }
        ],
        "rowActions": [
         {
          "id": "shut-down",
          "label": "Shut down",
          "icon": "PowerOff",
          "variant": "primary",
          "visibleWhen": {
           "type": "notEquals",
           "path": "$row.status",
           "value": "Resolved"
          },
          "action": {
           "type": "sequence",
           "actions": [
            {
             "type": "update",
             "path": "virtualMachines",
             "where": {
              "name": "{{$row.resource}}"
             },
             "set": {
              "status": "Stopped (deallocated)",
              "advisorAction": "Shut down from Advisor recommendation"
             }
            },
            {
             "type": "update",
             "path": "advisorRecommendations",
             "where": {
              "id": "{{$row.id}}"
             },
             "set": {
              "status": "Resolved",
              "resolution": "Shut down underutilized VM"
             }
            },
            {
             "type": "notify",
             "title": "Recommendation resolved",
             "message": "{{$row.resource}} was stopped and the Advisor cost recommendation is resolved."
            }
           ]
          }
         },
         {
          "id": "postpone",
          "label": "Postpone",
          "icon": "Clock",
          "visibleWhen": {
           "type": "notEquals",
           "path": "$row.status",
           "value": "Resolved"
          },
          "action": {
           "type": "sequence",
           "actions": [
            {
             "type": "update",
             "path": "advisorRecommendations",
             "where": {
              "id": "{{$row.id}}"
             },
             "set": {
              "status": "Postponed",
              "resolution": "Postponed with business justification"
             }
            },
            {
             "type": "notify",
             "title": "Recommendation postponed",
             "tone": "info",
             "message": "The recommendation was postponed with a business reason."
            }
           ]
          }
         }
        ]
       }
      ]
