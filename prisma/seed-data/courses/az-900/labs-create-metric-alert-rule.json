           },
           "message": "Use ops@contoso.example."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.severity",
            "value": "Sev2 - Warning"
           },
           "message": "Set Severity to Sev2 - Warning."
          }
         ],
         "actions": [
          {
           "type": "append",
           "path": "actionGroups",
           "unique": "name",
           "value": {
            "name": "{{$form.actionGroupName}}",
            "displayName": "{{$form.displayName}}",
            "resourceGroup": "rg-ops-monitoring",
            "notificationType": "{{$form.notificationType}}",
            "email": "{{$form.email}}"
