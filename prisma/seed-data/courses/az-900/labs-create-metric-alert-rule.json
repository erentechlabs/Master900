           "message": "Set threshold value to 80."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.checkEvery",
            "value": "5 minutes"
           },
           "message": "Set Check every to 5 minutes."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.lookback",
            "value": "5 minutes"
           },
           "message": "Set Lookback period to 5 minutes."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.actionGroupName",
            "value": "ag-ops"
           },
           "message": "Create action group ag-ops."
          },
          {
           "rule": {
            "type": "equals",
            "path": "$form.email",
