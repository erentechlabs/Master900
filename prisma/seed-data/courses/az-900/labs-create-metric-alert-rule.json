{
 "labs": [
  {
   "slug": "create-metric-alert-rule",
   "type": "UI_SIMULATION",
   "title": "Create a metric alert rule for high VM CPU",
   "summary": "Use Azure Monitor to chart VM CPU, create an alert rule with an email action group, simulate load, and acknowledge the fired alert.",
   "scenario": "Tailwind Traders operations wants a warning when **vm-app-02** has sustained high CPU. In the **simulated Azure portal** on your lab VM, review **Azure Monitor > Metrics** for **Percentage CPU**, create an alert rule for **vm-app-02** where **Average Percentage CPU** is **Greater than 80**, evaluated every **5 minutes** over a **5 minutes** lookback period, create action group **ag-ops** with email **ops@contoso.example**, set **Severity 2 - Warning**, then run the simulated CPU stress command and acknowledge the fired alert. Also review how **Service Health** differs from **Resource Health**.",
   "domainKey": "azure-management-governance",
   "moduleSlug": "monitoring-tools",
   "objectiveCode": "3.4",
   "complexity": "BASIC",
   "estimatedMinutes": 25,
   "learningObjectives": [
    "Inspect a VM metric chart in Azure Monitor",
    "Create a metric alert rule with signal, condition, action group, and severity",
    "Simulate a fired alert and set user response to Acknowledged",
    "Differentiate Service Health and Resource Health"
   ],
   "prerequisites": [
    "Know that metrics are numeric telemetry over time"
   ],
   "sources": [
    {
     "title": "Create Azure Monitor metric alert rules",
     "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/alerts/alerts-create-metric-alert-rule"
    },
    {
     "title": "Azure Monitor alerts overview",
     "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/alerts/alerts-overview"
    },
    {
     "title": "Action groups in Azure Monitor",
     "url": "https://learn.microsoft.com/en-us/azure/azure-monitor/alerts/action-groups"
    },
    {
     "title": "Azure Resource Health overview",
     "url": "https://learn.microsoft.com/en-us/azure/service-health/resource-health-overview"
    }
   ],
   "config": {
    "portal": {
     "name": "Microsoft Azure",
     "theme": "azure",
     "user": "alex@contoso.example",
     "tenant": "Contoso (contoso.example)",
     "url": "https://portal.azure.com",
     "searchPlaceholder": "Search resources, services, and docs (G+/)"
    },
    "vm": {
     "name": "LAB-VM-01",
     "os": "windows",
     "apps": [
      "browser",
      "terminal"
     ]
    },
    "terminal": {
     "title": "Cloud Shell (Bash)",
     "prompt": "alex@Azure:~$",
     "surface": "both",
     "welcome": "Welcome to Azure Cloud Shell (simulation). Use the provided command to trigger lab telemetry.",
     "commands": [
      {
       "id": "cpu-stress",
       "pattern": "^run-cpu-stress --vm vm-app-02$",
       "help": "run-cpu-stress --vm vm-app-02",
       "actions": [
        {
         "type": "update",
         "path": "virtualMachines",
         "where": {
          "name": "vm-app-02"
         },
         "set": {
          "currentCpu": 92,
          "cpuState": "High"
         }
        },
        {
         "type": "if",
         "when": {
          "type": "arrayContains",
          "path": "alertRules",
          "match": {
           "name": "alert-vm-app-02-cpu"
          }
         },
         "then": [
          {
           "type": "append",
           "path": "alerts",
           "unique": "name",
           "value": {
            "name": "High CPU on vm-app-02",
            "rule": "alert-vm-app-02-cpu",
            "resource": "vm-app-02",
            "severity": "Sev2",
            "condition": "Average Percentage CPU > 80",
            "status": "Fired",
            "userResponse": "New"
           }
          },
          {
           "type": "notify",
           "title": "Metric alert fired",
           "message": "High CPU on vm-app-02 fired and notified ag-ops."
          }
         ],
         "else": [
          {
           "type": "notify",
           "title": "CPU load simulated",
           "tone": "info",
           "message": "CPU increased, but no matching alert rule is enabled yet."
          }
         ]
        }
       ],
       "output": "CPU stress simulation started for vm-app-02. Percentage CPU crossed the alert threshold."
      }
     ],
     "fallback": "{{$cmd}} is not available in this simulated Cloud Shell. Type help."
    },
    "clock": {
     "start": "2026-10-01T10:00:00Z"
    },
