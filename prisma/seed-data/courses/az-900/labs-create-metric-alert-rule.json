            "operator": "{{$form.operator}}",
            "thresholdValue": "{{$form.thresholdValue}}",
            "checkEvery": "{{$form.checkEvery}}",
            "lookback": "{{$form.lookback}}",
            "actionGroup": "{{$form.actionGroupName}}",
            "severity": "{{$form.severity}}",
            "enabled": "{{$form.enabled}}"
           }
          },
          {
           "type": "notify",
