   "steps": [
    {
     "key": "review-metric",
     "title": "Review the Percentage CPU metric",
     "instruction": "Open **Monitor > Metrics** and review **Percentage CPU (Average)** for **vm-app-02**.",
     "hint": "Metrics are numerical measurements over time.",
     "explanation": "A metric chart helps you choose a meaningful signal before you create an alert rule.",
     "targetId": "cpu-metric-chart",
     "rules": [
      {
       "key": "visited-metrics",
       "description": "Metrics page was opened",
       "rule": {
        "type": "visited",
        "page": "monitor-metrics"
       }
      }
     ]
    },
    {
     "key": "create-alert-rule",
     "title": "Create the alert rule",
     "instruction": "Select **New alert rule**. Set **Select a resource** to **vm-app-02**, **Signal name** **Percentage CPU**, **Threshold type** **Static**, **Aggregation type** **Average**, **Operator** **Greater than**, **Threshold value** `80`, **Check every** **5 minutes**, and **Lookback period** **5 minutes**.",
     "hint": "The signal, aggregation, operator, threshold, frequency, and lookback together define when the alert fires.",
     "explanation": "Metric alert rules evaluate a numeric time series against a condition.",
     "targetId": "create-alert-rule",
     "rules": [
      {
       "key": "alert-condition",
       "description": "Alert rule condition is correct",
       "rule": {
        "type": "arrayContains",
        "path": "alertRules",
        "match": {
         "name": "alert-vm-app-02-cpu",
         "scope": "vm-app-02",
         "signal": "Percentage CPU",
         "aggregation": "Average",
         "operator": "Greater than",
         "thresholdValue": 80,
         "checkEvery": "5 minutes",
         "lookback": "5 minutes"
        }
       },
       "failureFeedback": "Create alert-vm-app-02-cpu with Average Percentage CPU Greater than 80 and 5-minute settings."
      }
     ]
    },
    {
     "key": "create-action-group",
     "title": "Attach an action group",
     "instruction": "In the alert rule **Actions** tab, create action group **ag-ops** with **Display name** **OPS**, **Notification type** **Email/SMS message/Push/Voice**, and **Email** `ops@contoso.example`. In **Details**, set **Severity** to **Sev2 - Warning**, name the rule **alert-vm-app-02-cpu**, keep it enabled, then select **Review + create** and **Create**.",
     "hint": "Action groups define who or what is notified when the alert fires.",
     "explanation": "A rule without an action group can fire without notifying the operations team.",
     "targetId": "alert-rule-wizard",
     "rules": [
      {
       "key": "action-group-created",
       "description": "ag-ops exists with the required email",
       "rule": {
        "type": "arrayContains",
        "path": "actionGroups",
        "match": {
         "name": "ag-ops",
         "displayName": "OPS",
         "email": "ops@contoso.example"
        }
       },
       "failureFeedback": "Create action group ag-ops with ops@contoso.example."
      },
      {
       "key": "severity-action",
       "description": "The alert rule uses Sev2 and ag-ops",
       "rule": {
        "type": "arrayContains",
        "path": "alertRules",
        "match": {
         "name": "alert-vm-app-02-cpu",
         "actionGroup": "ag-ops",
         "severity": "Sev2 - Warning",
         "enabled": true
        }
       }
      }
     ]
    },
    {
     "key": "simulate-load",
     "title": "Simulate high CPU",
     "instruction": "Return to **Monitor > Metrics** and select **Run CPU stress test**. You can also run `run-cpu-stress --vm vm-app-02` in Cloud Shell.",
     "hint": "The lab simulates CPU load and alert evaluation without affecting a real VM.",
     "explanation": "A fired alert appears after the monitored signal crosses the rule condition.",
     "targetId": "run-cpu-stress",
     "rules": [
      {
       "key": "alert-fired",
       "description": "The high CPU alert fired",
       "rule": {
        "type": "arrayContains",
        "path": "alerts",
        "match": {
         "name": "High CPU on vm-app-02",
         "status": "Fired"
        }
       },
       "failureFeedback": "Run the CPU stress test after creating the alert rule."
      }
     ]
    },
    {
     "key": "acknowledge-alert",
     "title": "Acknowledge the fired alert",
     "instruction": "Open **Alerts** and set the **High CPU on vm-app-02** user response to **Acknowledged**.",
     "hint": "Acknowledging records that an operator has seen and taken ownership of the alert.",
     "explanation": "User response is an operational triage field; it does not by itself fix the resource.",
     "targetId": "fired-alerts",
     "rules": [
      {
       "key": "alert-acknowledged",
       "description": "The fired alert is acknowledged",
       "rule": {
        "type": "arrayContains",
        "path": "alerts",
        "match": {
         "name": "High CPU on vm-app-02",
         "userResponse": "Acknowledged"
        }
       },
       "failureFeedback": "Use Acknowledge on the fired alert."
      }
     ]
    },
    {
     "key": "review-health",
     "title": "Review health experiences",
     "instruction": "Open **Service Health** and review the **Service Health vs Resource Health** explanation.",
     "hint": "Service Health is personalized service-impact communication; Resource Health is per-resource availability.",
     "explanation": "Monitoring metrics and Azure health communications answer different operational questions.",
     "targetId": "health-views",
     "rules": [
      {
       "key": "visited-health",
       "description": "Service Health page was opened",
       "rule": {
        "type": "visited",
        "page": "service-health"
       }
      }
     ]
    }
