        },
        "terminal": {
          "title": "Cloud Shell (Bash)",
          "prompt": "alex@Azure:~$",
          "surface": "cloudshell",
          "welcome": "Welcome to Azure Cloud Shell (simulation).",
          "fallback": "{{$cmd}}: command not available in this simulated environment.",
          "commands": [
            {
              "id": "deploy",
              "pattern": "^az webapp deploy -g rg-app-service-demo -n app-tailwind-portal --slot staging --src-path site-v2\\.zip --type zip$",
              "help": "az webapp deploy -g rg-app-service-demo -n app-tailwind-portal --slot staging --src-path site-v2.zip --type zip",
              "actions": [
                {
                  "type": "update",
                  "path": "webApps",
                  "where": {
                    "name": "app-tailwind-portal"
                  },
                  "set": {
                    "stagingVersion": "Tailwind Traders release v2"
                  }
                },
                {
                  "type": "update",
                  "path": "deploymentSlots",
                  "where": {
                    "name": "staging"
                  },
                  "set": {
                    "version": "Tailwind Traders release v2"
                  }
                },
                {
                  "type": "notify",
                  "title": "Deployment to staging completed"
                }
              ],
              "output": "Deployment successful to slot staging."
            },
            {
              "id": "swap",
              "pattern": "^az webapp deployment slot swap -g rg-app-service-demo -n app-tailwind-portal --slot staging --target-slot production$",
              "help": "az webapp deployment slot swap -g rg-app-service-demo -n app-tailwind-portal --slot staging --target-slot production",
              "when": {
                "type": "arrayContains",
                "path": "webApps",
                "match": {
                  "name": "app-tailwind-portal",
                  "stagingVersion": "Tailwind Traders release v2"
                }
              },
              "actions": [
                {
                  "type": "update",
                  "path": "webApps",
                  "where": {
                    "name": "app-tailwind-portal"
                  },
                  "set": {
                    "productionVersion": "Tailwind Traders release v2",
                    "stagingVersion": "App Service default page",
                    "lastSwap": "staging-to-production"
                  }
                },
                {
                  "type": "update",
                  "path": "deploymentSlots",
                  "where": {
                    "name": "staging"
                  },
                  "set": {
                    "version": "App Service default page"
                  }
                },
                {
                  "type": "notify",
                  "title": "Swap completed"
                }
              ],
              "output": "Swap completed. Source slot: staging. Target slot: production."
            }
          ]
        }
      },
      "steps": [
        {
          "key": "open-create",
          "title": "Open the Web App create experience",
          "instruction": "Select **App Services**, then select **Create**.",
          "hint": "App Services is in the Favorites navigation.",
          "explanation": "App Service is a managed PaaS web hosting option. You configure the app and runtime while Azure manages the underlying web servers.",
          "targetId": "app-create",
          "rules": [
            {
              "key": "visited-create",
              "description": "Create Web App page is open",
              "rule": {
                "type": "visited",
                "page": "webapp-create"
              }
            }
          ]
        },
        {
          "key": "create-app",
          "title": "Create the App Service plan and Web App",
          "instruction": "Create resource group **rg-app-service-demo**, name the app **app-tailwind-portal**, choose **Code**, **.NET 8 (LTS)**, **Linux**, **(Europe) West Europe**, plan **asp-tailwind-demo**, and **Basic B1**. Select **Review + create**, then **Create**.",
          "hint": "Choose a plan that supports slots; no prices are shown.",
          "explanation": "An App Service plan defines managed compute capacity. The Web App hosts your code without requiring you to patch a VM web server.",
          "targetId": "webapp-wizard",
          "rules": [
            {
              "key": "plan-created",
              "description": "App Service plan exists",
              "rule": {
                "type": "arrayContains",
                "path": "appServicePlans",
                "match": {
                  "name": "asp-tailwind-demo",
                  "pricingPlan": "Basic B1"
                }
              }
            },
            {
              "key": "app-created",
              "description": "Web App exists",
              "rule": {
                "type": "arrayContains",
                "path": "webApps",
                "match": {
                  "name": "app-tailwind-portal",
                  "runtimeStack": ".NET 8 (LTS)",
                  "operatingSystem": "Linux"
                }
              }
            }
          ]
        },
        {
          "key": "open-production",
          "title": "Open the default production app",
          "instruction": "Select **Go to resource**, then **Browse** or open `https://app-tailwind-portal.azurewebsites.net`.",
          "hint": "The default domain is shown in Essentials.",
          "explanation": "Opening the default host proves production is running before any staged release changes it.",
          "targetId": "go-to-webapp",
          "rules": [
            {
              "key": "visited-production",
              "description": "Production site opened",
              "rule": {
                "type": "visited",
                "page": "production-site"
              }
            }
          ]
        },
        {
          "key": "add-slot",
          "title": "Add a staging deployment slot",
          "instruction": "Open **Deployment slots**, select **Add Slot**, set **Name** to `staging`, **Clone settings from** **Production**, and select **Add**.",
          "hint": "Deployment slots are under Deployment in the app menu.",
          "explanation": "A staging slot is a live app with its own host name. You can test a new version there before users see it.",
          "targetId": "add-slot",
          "rules": [
            {
              "key": "slot-created",
              "description": "Staging slot exists",
              "rule": {
                "type": "arrayContains",
                "path": "deploymentSlots",
                "match": {
                  "name": "staging",
                  "hostName": "app-tailwind-portal-staging.azurewebsites.net"
                }
              }
            }
          ]
        },
        {
          "key": "deploy-staging",
          "title": "Deploy release v2 to staging",
          "instruction": "Open **Deployment Center** and run `az webapp deploy -g rg-app-service-demo -n app-tailwind-portal --slot staging --src-path site-v2.zip --type zip`. Then open `https://app-tailwind-portal-staging.azurewebsites.net`.",
          "hint": "The command deploys only to staging.",
          "explanation": "Deploying to staging validates new code without changing the production host name.",
          "targetId": "deploy-terminal",
          "rules": [
            {
              "key": "staging-v2",
              "description": "Release v2 was deployed to staging",
              "rule": {
                "type": "commandUsed",
                "pattern": "^az webapp deploy .*--slot staging .*site-v2\\.zip"
              }
            },
            {
              "key": "visited-staging",
              "description": "Staging site opened",
              "rule": {
                "type": "visited",
                "page": "staging-site"
              }
            }
          ]
        },
        {
          "key": "swap",
          "title": "Swap staging into production",
          "instruction": "Use **Deployment slots** > **Swap** with **Source slot** `staging` and **Target slot** `production`, or run `az webapp deployment slot swap -g rg-app-service-demo -n app-tailwind-portal --slot staging --target-slot production`. Then open production again.",
          "hint": "Staging is the source because it has the validated release.",
          "explanation": "A slot swap exchanges content behind host names, supporting releases with little or no downtime and an easy rollback path.",
          "targetId": "swap-slots",
          "rules": [
            {
              "key": "production-v2",
              "description": "Production has v2",
              "rule": {
                "type": "arrayContains",
                "path": "webApps",
                "match": {
                  "name": "app-tailwind-portal",
                  "productionVersion": "Tailwind Traders release v2",
                  "lastSwap": "staging-to-production"
                }
              }
            }
          ]
        }
      ],
      "finalRules": [
        {
          "key": "paas-not-iaas",
          "description": "No VM was created",
          "rule": {
            "type": "arrayLength",
            "path": "virtualMachines",
            "max": 0
          }
        },
        {
          "key": "slot-release",
          "description": "Release was deployed and swapped",
          "rule": {
            "type": "allOf",
            "rules": [
              {
                "type": "commandUsed",
                "pattern": "az webapp deploy .*--slot staging"
              },
              {
                "type": "arrayContains",
                "path": "webApps",
                "match": {
                  "name": "app-tailwind-portal",
                  "productionVersion": "Tailwind Traders release v2"
                }
              }
            ]
          }
        }
      ],
      "solution": "1. Select **App Services** > **Create**.\n2. Use resource group `rg-app-service-demo`, name `app-tailwind-portal`, **Code**, **.NET 8 (LTS)**, **Linux**, **(Europe) West Europe**, plan `asp-tailwind-demo`, and **Basic B1**.\n3. **Review + create** > **Create**, then **Go to resource** and browse `https://app-tailwind-portal.azurewebsites.net`.\n4. Open **Deployment slots**, **Add Slot**, name `staging`, clone from **Production**, and **Add**.\n5. Run `az webapp deploy -g rg-app-service-demo -n app-tailwind-portal --slot staging --src-path site-v2.zip --type zip` and open `https://app-tailwind-portal-staging.azurewebsites.net`.\n6. **Swap** source `staging` to target `production`, then open production again."
    }
  ]
}
