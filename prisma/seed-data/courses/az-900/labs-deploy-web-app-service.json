{
  "labs": [
    {
      "slug": "deploy-web-app-service",
      "type": "UI_SIMULATION",
      "title": "Deploy and swap an Azure App Service web app",
      "summary": "Create an App Service plan and Web App, verify the default site, deploy a new version to staging, and swap it into production.",
      "scenario": "Tailwind Traders wants a web app without managing virtual machines. Create an App Service plan and Web App named **app-tailwind-portal**, open the **azurewebsites.net** default page, add a **staging** slot, deploy release v2 to staging, and swap it into production. Done means production shows the new version through a zero-downtime slot workflow.",
      "domainKey": "azure-architecture-services",
      "moduleSlug": "azure-compute-and-networking",
      "objectiveCode": "2.2",
      "complexity": "INTERMEDIATE",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Create an App Service plan and Web App in the portal",
        "Explain why App Service is PaaS compared with IaaS virtual machines",
        "Use a staging deployment slot to validate a release",
        "Swap slots to update production with minimal downtime"
      ],
      "prerequisites": [
        "Know what PaaS and IaaS mean at a fundamentals level"
      ],
      "sources": [
        {
          "title": "Quickstart: Deploy an ASP.NET web app to Azure App Service",
          "url": "https://learn.microsoft.com/en-us/azure/app-service/quickstart-dotnetcore"
        },
        {
          "title": "Set up staging environments in Azure App Service",
          "url": "https://learn.microsoft.com/en-us/azure/app-service/deploy-staging-slots"
        },
        {
          "title": "az webapp deployment slot",
          "url": "https://learn.microsoft.com/en-us/cli/azure/webapp/deployment/slot?view=azure-cli-latest"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Azure",
          "theme": "azure",
          "user": "alex@contoso.example",
          "tenant": "Contoso (contoso.example)",
          "url": "https://portal.azure.com",
          "searchPlaceholder": "Search resources, services, and docs (G+/)"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser",
            "terminal"
          ]
        },
        "clock": {
          "start": "2026-10-02T09:00:00Z"
        },
        "startPage": "home",
        "navigation": [
          {
            "page": "home",
            "label": "Home",
            "icon": "Home"
          },
          {
            "page": "app-services",
            "label": "App Services",
            "icon": "AppWindow",
            "section": "Favorites"
          }
        ],
        "pages": [
          {
            "id": "home",
            "title": "Home",
            "url": "/#home",
            "components": [
              {
                "kind": "tiles",
                "id": "services",
                "title": "Azure services",
                "size": "sm",
                "items": [
                  {
                    "id": "app-services",
                    "label": "App Services",
                    "icon": "AppWindow",
                    "action": {
                      "type": "navigate",
                      "page": "app-services"
                    }
                  },
                  {
                    "id": "cloud-shell",
                    "label": "Cloud Shell",
                    "icon": "Terminal",
                    "action": {
                      "type": "navigate",
                      "page": "cloud-shell"
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "cloud-shell",
            "title": "Cloud Shell",
            "icon": "Terminal",
            "url": "/#cloudshell",
            "components": [
              {
                "kind": "terminal",
                "id": "cloud-shell-terminal",
                "title": "Cloud Shell (Bash)"
              }
            ]
          },
          {
            "id": "app-services",
            "title": "App Services",
            "icon": "AppWindow",
            "url": "/#browse/Microsoft.Web%2Fsites",
            "commands": [
              {
                "id": "app-create",
                "label": "Create",
                "icon": "Plus",
                "variant": "primary",
                "action": {
                  "type": "navigate",
                  "page": "webapp-create"
                }
              }
            ],
            "components": [
              {
                "kind": "table",
                "id": "app-list",
                "source": "webApps",
                "columns": [
                  {
                    "key": "name",
                    "label": "Name",
                    "format": "link"
                  },
                  {
                    "key": "resourceGroup",
                    "label": "Resource group"
                  },
                  {
                    "key": "runtimeStack",
                    "label": "Runtime stack"
                  },
                  {
                    "key": "state",
                    "label": "Status",
                    "format": "status"
                  },
                  {
                    "key": "defaultHostName",
                    "label": "Default domain"
                  }
                ],
                "rowKey": "name",
                "emptyText": "No App Services found.",
