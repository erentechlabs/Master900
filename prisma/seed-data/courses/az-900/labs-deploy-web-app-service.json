            "title": "app-tailwind-portal",
            "layout": "blank",
            "url": "https://{{$sel.app.defaultHostName}}",
            "requires": "app",
            "components": [
              {
                "kind": "text",
                "id": "production-site-content",
                "text": "# {{$sel.app.productionVersion}}\n\nProduction slot at `https://{{$sel.app.defaultHostName}}`."
              }
            ]
          },
          {
            "id": "staging-site",
            "title": "app-tailwind-portal staging",
            "layout": "blank",
            "url": "https://{{$sel.app.name}}-staging.azurewebsites.net",
            "requires": "app",
            "components": [
              {
                "kind": "text",
                "id": "staging-site-content",
                "text": "# {{$sel.app.stagingVersion}}\n\nStaging slot at `https://{{$sel.app.name}}-staging.azurewebsites.net`."
              }
            ]
          }
        ],
