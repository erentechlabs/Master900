                "icon": "ExternalLink",
                "variant": "primary",
                "action": {
                  "type": "navigate",
                  "page": "production-site"
                }
              }
            ],
            "components": [
              {
                "kind": "callout",
                "variant": "info",
                "title": "PaaS hosting",
                "text": "App Service runs your web app on a managed platform instead of a self-managed VM."
              },
              {
                "kind": "properties",
                "title": "Essentials",
                "items": [
                  {
                    "label": "Default domain",
                    "value": "https://{{$sel.app.defaultHostName}}",
                    "format": "link"
                  },
                  {
                    "label": "Runtime stack",
                    "value": "{{$sel.app.runtimeStack}}"
                  },
                  {
                    "label": "Production version",
                    "value": "{{$sel.app.productionVersion}}"
                  }
                ]
              }
            ]
          },
          {
            "id": "deployment-slots",
            "title": "{{$sel.app.name}} | Deployment slots",
            "subtitle": "App Service",
            "icon": "Split",
            "requires": "app",
            "navItem": "app-services",
            "menu": [
              {
                "page": "webapp-overview",
                "label": "Overview",
                "icon": "AppWindow"
              },
              {
                "page": "deployment-slots",
                "label": "Deployment slots",
                "icon": "Split",
                "section": "Deployment"
              },
              {
                "page": "deployment-center",
                "label": "Deployment Center",
                "icon": "Rocket",
                "section": "Deployment"
              }
            ],
            "commands": [
              {
                "id": "add-slot",
                "label": "Add Slot",
                "icon": "Plus",
                "variant": "primary",
                "action": {
                  "type": "navigate",
                  "page": "add-slot"
                }
              },
              {
                "id": "swap-slots",
                "label": "Swap",
                "icon": "Merge",
                "visibleWhen": {
                  "type": "arrayContains",
                  "path": "deploymentSlots",
                  "match": {
                    "name": "staging"
                  }
                },
                "action": {
                  "type": "navigate",
                  "page": "swap-slots"
                }
              }
            ],
            "components": [
              {
                "kind": "callout",
                "variant": "info",
                "text": "Deployment slots are live apps with their own host names."
              },
              {
                "kind": "table",
                "id": "slots-table",
                "source": "deploymentSlots",
                "columns": [
                  {
                    "key": "name",
                    "label": "Name",
                    "format": "link"
                  },
                  {
                    "key": "state",
                    "label": "Status",
                    "format": "status"
                  },
                  {
                    "key": "hostName",
                    "label": "Host name"
                  },
                  {
                    "key": "version",
                    "label": "Version"
                  }
                ],
                "rowKey": "name",
                "emptyText": "No deployment slots."
              }
            ]
          },
          {
            "id": "add-slot",
            "title": "Add a slot",
            "icon": "Plus",
            "requires": "app",
            "navItem": "app-services",
            "components": [
              {
                "kind": "form",
                "id": "slot-form",
                "title": "Add a slot",
                "fields": [
                  {
                    "id": "name",
                    "label": "Name",
                    "control": "text",
                    "required": true,
                    "defaultValue": "staging"
                  },
                  {
                    "id": "clone",
                    "label": "Clone settings from",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Production",
                    "options": [
                      {
                        "value": "Production",
                        "label": "Production"
                      },
                      {
                        "value": "Do not clone settings",
                        "label": "Do not clone settings"
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Add",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.name",
                        "value": "staging"
                      },
                      "message": "Name the slot staging."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "deploymentSlots",
                      "unique": "name",
                      "value": {
                        "name": "staging",
                        "state": "Running",
                        "hostName": "{{$sel.app.name}}-staging.azurewebsites.net",
                        "version": "App Service default page"
                      }
                    },
                    {
                      "type": "update",
                      "path": "webApps",
                      "where": {
                        "name": "{{$sel.app.name}}"
                      },
                      "set": {
                        "stagingVersion": "App Service default page"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Deployment slot added"
                    },
                    {
                      "type": "navigate",
                      "page": "deployment-slots"
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "deployment-center",
            "title": "{{$sel.app.name}} | Deployment Center",
            "subtitle": "App Service",
            "icon": "Rocket",
            "requires": "app",
            "navItem": "app-services",
            "menu": [
              {
                "page": "webapp-overview",
                "label": "Overview",
                "icon": "AppWindow"
              },
              {
                "page": "deployment-slots",
                "label": "Deployment slots",
                "icon": "Split",
                "section": "Deployment"
              },
              {
                "page": "deployment-center",
                "label": "Deployment Center",
                "icon": "Rocket",
                "section": "Deployment"
              }
            ],
            "components": [
              {
                "kind": "callout",
                "variant": "info",
                "text": "Run `az webapp deploy -g rg-app-service-demo -n app-tailwind-portal --slot staging --src-path site-v2.zip --type zip`."
              },
              {
                "kind": "terminal",
                "id": "deploy-terminal",
                "title": "Cloud Shell (Bash)"
              }
            ]
          },
          {
            "id": "swap-slots",
            "title": "Swap",
            "icon": "Merge",
            "requires": "app",
            "navItem": "app-services",
            "components": [
              {
                "kind": "form",
                "id": "swap-form",
                "title": "Swap slots",
                "fields": [
                  {
                    "id": "source",
                    "label": "Source slot",
                    "control": "select",
                    "required": true,
                    "defaultValue": "staging",
                    "options": [
                      {
                        "value": "staging",
                        "label": "staging"
                      }
                    ]
                  },
                  {
                    "id": "target",
                    "label": "Target slot",
                    "control": "select",
                    "required": true,
                    "defaultValue": "production",
                    "options": [
                      {
                        "value": "production",
                        "label": "production"
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Swap",
                  "checks": [
                    {
                      "rule": {
                        "type": "arrayContains",
                        "path": "webApps",
                        "match": {
                          "name": "app-tailwind-portal",
                          "stagingVersion": "Tailwind Traders release v2"
                        }
                      },
                      "message": "Deploy release v2 to staging first."
                    }
                  ],
                  "actions": [
                    {
                      "type": "update",
                      "path": "webApps",
                      "where": {
                        "name": "app-tailwind-portal"
                      },
                      "set": {
                        "productionVersion": "Tailwind Traders release v2",
                        "stagingVersion": "App Service default page",
                        "lastSwap": "staging-to-production"
                      }
                    },
                    {
                      "type": "update",
                      "path": "deploymentSlots",
                      "where": {
                        "name": "staging"
                      },
                      "set": {
                        "version": "App Service default page"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Swap completed"
                    },
                    {
                      "type": "navigate",
                      "page": "webapp-overview"
                    }
                  ]
                }
              }
            ]
          },
