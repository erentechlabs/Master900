                  "select": {
                    "as": "app",
                    "path": "webApps",
                    "key": "name",
                    "value": "{{$row.name}}"
                  }
                }
              }
            ]
          },
          {
            "id": "webapp-create",
            "title": "Create Web App",
            "icon": "AppWindow",
            "url": "/#create/Microsoft.WebSite",
            "navItem": "app-services",
            "breadcrumb": [
              "Home",
              "App Services"
            ],
            "components": [
              {
                "kind": "wizard",
                "id": "webapp-wizard",
                "description": "Create a Web App and an App Service plan. Prices are intentionally not shown.",
                "reviewLabel": "Review + create",
                "tabs": [
                  {
                    "id": "basics",
                    "label": "Basics",
                    "fields": [
                      {
                        "id": "subscription",
                        "label": "Subscription",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Contoso Learning (simulated)",
                        "options": [
                          {
                            "value": "Contoso Learning (simulated)",
                            "label": "Contoso Learning (simulated)"
                          }
                        ]
                      },
                      {
                        "id": "resourceGroup",
                        "label": "Resource group",
                        "control": "select",
                        "required": true,
                        "defaultValue": "create-new",
                        "options": [
                          {
                            "value": "create-new",
                            "label": "Create new"
                          }
                        ],
                        "optionsFrom": {
                          "path": "resourceGroups",
                          "value": "name"
                        }
                      },
                      {
                        "id": "newResourceGroup",
                        "label": "New resource group name",
                        "control": "text",
                        "required": true,
                        "visibleWhen": {
                          "type": "equals",
                          "path": "$form.resourceGroup",
                          "value": "create-new"
                        }
                      },
                      {
                        "id": "name",
                        "label": "Name",
                        "control": "text",
                        "required": true,
                        "pattern": "^[a-z0-9-]{2,60}$",
                        "patternMessage": "Use lowercase letters, numbers, and hyphens."
                      },
                      {
                        "id": "publish",
                        "label": "Publish",
                        "control": "radio",
                        "required": true,
                        "defaultValue": "Code",
                        "options": [
                          {
                            "value": "Code",
                            "label": "Code"
                          },
                          {
                            "value": "Docker Container",
                            "label": "Docker Container"
                          }
                        ]
                      },
                      {
                        "id": "runtimeStack",
                        "label": "Runtime stack",
                        "control": "select",
                        "required": true,
                        "defaultValue": ".NET 8 (LTS)",
                        "options": [
                          {
                            "value": ".NET 8 (LTS)",
                            "label": ".NET 8 (LTS)"
                          },
                          {
                            "value": "Node 20 LTS",
                            "label": "Node 20 LTS"
                          }
                        ]
                      },
                      {
                        "id": "operatingSystem",
                        "label": "Operating System",
                        "control": "radio",
                        "required": true,
                        "defaultValue": "Linux",
                        "options": [
                          {
                            "value": "Linux",
                            "label": "Linux"
                          },
                          {
                            "value": "Windows",
                            "label": "Windows"
                          }
                        ]
                      },
                      {
                        "id": "region",
                        "label": "Region",
                        "control": "select",
                        "required": true,
                        "defaultValue": "westeurope",
                        "optionsFrom": {
                          "path": "regions",
                          "value": "name",
                          "label": "displayName"
                        }
                      }
                    ]
                  },
                  {
                    "id": "hosting",
                    "label": "Hosting",
                    "fields": [
                      {
                        "id": "appServicePlan",
                        "label": "App Service Plan",
                        "control": "select",
                        "required": true,
                        "defaultValue": "create-new",
                        "options": [
                          {
                            "value": "create-new",
                            "label": "Create new"
                          }
                        ]
                      },
                      {
                        "id": "newPlanName",
                        "label": "New App Service plan name",
                        "control": "text",
                        "required": true,
                        "visibleWhen": {
                          "type": "equals",
                          "path": "$form.appServicePlan",
                          "value": "create-new"
                        }
                      },
                      {
                        "id": "pricingPlan",
                        "label": "Pricing plan",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Basic B1",
                        "options": [
                          {
                            "value": "Free F1",
                            "label": "Free F1"
                          },
                          {
                            "value": "Basic B1",
                            "label": "Basic B1"
                          },
                          {
                            "value": "Standard S1",
                            "label": "Standard S1"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Create",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.publish",
                        "value": "Code"
                      },
                      "message": "Choose Code for this lab."
                    },
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.pricingPlan",
                        "value": "Free F1"
                      },
                      "message": "Choose a plan that supports deployment slots."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "resourceGroups",
                      "unique": "name",
                      "value": {
                        "name": "{{$form.newResourceGroup}}",
                        "location": "{{$form.region}}"
                      }
                    },
                    {
                      "type": "append",
                      "path": "appServicePlans",
                      "unique": "name",
                      "value": {
                        "name": "{{$form.newPlanName}}",
                        "resourceGroup": "{{$form.newResourceGroup}}",
                        "location": "{{$form.region}}",
                        "pricingPlan": "{{$form.pricingPlan}}",
                        "os": "{{$form.operatingSystem}}"
                      }
                    },
                    {
                      "type": "append",
                      "path": "webApps",
                      "unique": "name",
                      "value": {
                        "name": "{{$form.name}}",
                        "resourceGroup": "{{$form.newResourceGroup}}",
                        "location": "{{$form.region}}",
                        "publish": "{{$form.publish}}",
                        "runtimeStack": "{{$form.runtimeStack}}",
                        "operatingSystem": "{{$form.operatingSystem}}",
                        "appServicePlan": "{{$form.newPlanName}}",
                        "pricingPlan": "{{$form.pricingPlan}}",
                        "state": "Running",
                        "defaultHostName": "{{$form.name}}.azurewebsites.net",
                        "productionVersion": "App Service default page",
                        "stagingVersion": "No staging slot"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Deployment succeeded",
                      "message": "Web App {{$form.name}} was created."
                    },
                    {
                      "type": "navigate",
                      "page": "webapp-deployment",
                      "select": {
                        "as": "app",
                        "path": "webApps",
                        "key": "name",
                        "value": "{{$form.name}}"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "webapp-deployment",
