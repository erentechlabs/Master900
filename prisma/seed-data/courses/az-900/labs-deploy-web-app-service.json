            {
              "name": "westeurope",
              "displayName": "(Europe) West Europe"
            },
            {
              "name": "northeurope",
              "displayName": "(Europe) North Europe"
            }
          ],
          "appServicePlans": [],
          "webApps": [],
          "deploymentSlots": [],
