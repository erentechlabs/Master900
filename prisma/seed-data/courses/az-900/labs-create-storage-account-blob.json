                "text": "RA-GRS and RA-GZRS are the read-access geo-redundant choices in this simulation."
              }
            ]
          },
          {
            "id": "containers",
            "title": "{{$sel.storage.name}} | Containers",
            "icon": "Container",
            "requires": "storage",
            "navItem": "storage-accounts",
            "breadcrumb": [
              "Home",
              "Storage accounts",
              "{{$sel.storage.name}}"
            ],
            "menu": [
              {
                "page": "storage-overview",
                "label": "Overview",
                "icon": "Database"
              },
              {
                "page": "containers",
                "label": "Containers",
                "icon": "Container",
                "section": "Data storage"
              }
            ],
            "commands": [
              {
                "id": "new-container",
                "label": "+ Container",
                "icon": "Plus",
                "variant": "primary",
                "action": {
                  "type": "navigate",
                  "page": "container-create"
                }
              }
            ],
            "components": [
              {
                "kind": "table",
                "id": "container-list",
                "source": "containers",
                "rowKey": "name",
                "columns": [
                  {
                    "key": "name",
                    "label": "Name",
                    "format": "link"
                  },
                  {
                    "key": "publicAccess",
                    "label": "Anonymous access level"
                  },
                  {
                    "key": "blobCount",
                    "label": "Blobs",
                    "format": "count"
                  }
                ],
                "where": {
                  "account": "{{$sel.storage.name}}"
                },
                "rowAction": {
                  "type": "navigate",
                  "page": "container-detail",
                  "select": {
                    "as": "container",
                    "path": "containers",
