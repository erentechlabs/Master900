                    "value": "{{$row.name}}"
                  }
                }
              }
            ]
          },
          {
            "id": "container-create",
            "title": "New container",
            "icon": "Container",
            "requires": "storage",
            "navItem": "storage-accounts",
            "components": [
              {
                "kind": "form",
                "id": "container-form",
                "title": "New container",
                "fields": [
                  {
                    "id": "name",
                    "label": "Name",
                    "control": "text",
                    "required": true,
                    "defaultValue": "invoices",
                    "pattern": "^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])$",
                    "patternMessage": "Use a valid lowercase container name."
                  },
                  {
                    "id": "publicAccess",
                    "label": "Anonymous access level",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Private (no anonymous access)",
                    "options": [
                      {
                        "value": "Private (no anonymous access)",
                        "label": "Private (no anonymous access)"
                      },
                      {
                        "value": "Blob (anonymous read access for blobs only)",
                        "label": "Blob (anonymous read access for blobs only)"
                      },
                      {
                        "value": "Container (anonymous read access for containers and blobs)",
                        "label": "Container (anonymous read access for containers and blobs)"
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Create",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.name",
                        "value": "invoices"
                      },
                      "message": "Create the invoices container."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.publicAccess",
                        "value": "Private (no anonymous access)"
                      },
                      "message": "Invoices must stay private."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "containers",
                      "unique": "name",
                      "value": {
                        "account": "{{$sel.storage.name}}",
                        "name": "{{$form.name}}",
                        "publicAccess": "{{$form.publicAccess}}",
                        "blobCount": 0
                      }
                    },
                    {
                      "type": "navigate",
                      "page": "container-detail",
                      "select": {
                        "as": "container",
                        "path": "containers",
                        "key": "name",
                        "value": "{{$form.name}}"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "container-detail",
            "title": "{{$sel.container.name}}",
            "subtitle": "Container",
            "icon": "Container",
            "requires": "container",
            "navItem": "storage-accounts",
            "commands": [
              {
                "id": "upload-blob",
                "label": "Upload",
                "icon": "Upload",
                "variant": "primary",
                "action": {
                  "type": "navigate",
                  "page": "blob-upload"
                }
              }
            ],
            "components": [
              {
                "kind": "properties",
                "items": [
                  {
                    "label": "Anonymous access level",
                    "value": "{{$sel.container.publicAccess}}"
                  },
                  {
                    "label": "Storage account",
                    "value": "{{$sel.container.account}}"
                  }
                ]
              },
              {
                "kind": "table",
                "id": "blob-list",
                "source": "blobs",
                "rowKey": "name",
                "columns": [
                  {
                    "key": "name",
                    "label": "Name",
                    "format": "link"
                  },
                  {
                    "key": "contentType",
                    "label": "Content type"
                  },
                  {
                    "key": "accessTier",
                    "label": "Access tier",
                    "format": "badge"
                  }
                ],
                "where": {
                  "account": "{{$sel.container.account}}",
                  "container": "{{$sel.container.name}}"
                },
                "rowAction": {
                  "type": "navigate",
                  "page": "blob-tier",
                  "select": {
                    "as": "blob",
                    "path": "blobs",
                    "key": "name",
                    "value": "{{$row.name}}"
                  }
                }
              }
            ]
          },
          {
            "id": "blob-upload",
            "title": "Upload blob",
            "icon": "Upload",
            "requires": "container",
            "navItem": "storage-accounts",
            "components": [
              {
                "kind": "form",
                "id": "upload-form",
                "title": "Upload blob",
                "description": "Choose a file from LAB-VM-01 Documents.",
                "fields": [
                  {
                    "id": "file",
                    "label": "Files",
                    "control": "select",
                    "required": true,
                    "defaultValue": "invoice-2026-09.pdf",
                    "optionsFrom": {
                      "path": "documents",
                      "value": "name"
                    }
                  },
                  {
                    "id": "blobType",
                    "label": "Blob type",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Block blob",
                    "options": [
                      {
                        "value": "Block blob",
                        "label": "Block blob"
                      },
                      {
                        "value": "Append blob",
                        "label": "Append blob"
                      }
                    ]
                  },
                  {
                    "id": "accessTier",
                    "label": "Access tier",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Hot",
                    "options": [
                      {
                        "value": "Hot",
                        "label": "Hot"
                      },
                      {
                        "value": "Cool",
                        "label": "Cool"
                      },
                      {
                        "value": "Archive",
                        "label": "Archive"
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Upload",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.file",
                        "value": "invoice-2026-09.pdf"
                      },
                      "message": "Upload invoice-2026-09.pdf."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.blobType",
                        "value": "Block blob"
                      },
                      "message": "Use Block blob for the PDF."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "blobs",
                      "unique": "name",
                      "value": {
                        "account": "{{$sel.container.account}}",
                        "container": "{{$sel.container.name}}",
                        "name": "{{$form.file}}",
                        "contentType": "application/pdf",
                        "accessTier": "{{$form.accessTier}}",
                        "uploadedAt": "{{$now}}"
                      }
                    },
                    {
                      "type": "update",
                      "path": "containers",
                      "where": {
                        "name": "{{$sel.container.name}}"
                      },
                      "set": {
                        "blobCount": 1
                      }
                    },
                    {
                      "type": "navigate",
                      "page": "container-detail"
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "blob-tier",
            "title": "{{$sel.blob.name}} | Change access tier",
            "icon": "Archive",
            "requires": "blob",
            "navItem": "storage-accounts",
            "components": [
              {
                "kind": "callout",
                "variant": "info",
                "title": "Access tier",
                "text": "Cool is for less frequent reads. Archive may require rehydration before the blob is readable."
              },
              {
                "kind": "form",
                "id": "tier-form",
                "title": "Change access tier",
