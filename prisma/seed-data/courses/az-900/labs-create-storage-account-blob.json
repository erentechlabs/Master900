          {
            "id": "storage-create",
            "title": "Create a storage account",
            "icon": "Database",
            "url": "/#create/Microsoft.StorageAccount-ARM",
            "navItem": "storage-accounts",
            "components": [
              {
                "kind": "wizard",
                "id": "storage-wizard",
                "description": "Storage account names must be globally unique, 3-24 characters, and use lowercase letters and numbers.",
                "reviewLabel": "Review + create",
                "tabs": [
                  {
                    "id": "basics",
                    "label": "Basics",
                    "fields": [
                      {
                        "id": "subscription",
                        "label": "Subscription",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Contoso Learning (simulated)",
                        "options": [
                          {
                            "value": "Contoso Learning (simulated)",
                            "label": "Contoso Learning (simulated)"
                          }
                        ]
                      },
                      {
                        "id": "resourceGroup",
                        "label": "Resource group",
                        "control": "select",
                        "required": true,
                        "defaultValue": "rg-data-prod",
                        "optionsFrom": {
                          "path": "resourceGroups",
                          "value": "name"
                        }
                      },
                      {
                        "id": "name",
                        "label": "Storage account name",
                        "control": "text",
                        "required": true,
                        "defaultValue": "northwindinv2026",
                        "pattern": "^[a-z0-9]{3,24}$",
                        "patternMessage": "Use 3-24 lowercase letters and numbers only.",
                        "unique": {
                          "path": "storageAccounts",
                          "key": "name",
                          "message": "This storage account name is already taken. Choose a globally unique name."
                        }
                      },
                      {
                        "id": "region",
                        "label": "Region",
                        "control": "select",
                        "required": true,
                        "defaultValue": "westeurope",
                        "optionsFrom": {
                          "path": "regions",
                          "value": "name",
                          "label": "displayName"
                        }
                      },
                      {
                        "id": "primaryService",
                        "label": "Primary service",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Azure Blob Storage",
                        "options": [
                          {
                            "value": "Azure Blob Storage",
                            "label": "Azure Blob Storage"
                          },
                          {
                            "value": "Azure Files",
                            "label": "Azure Files"
                          }
                        ]
                      },
                      {
                        "id": "performance",
                        "label": "Performance",
                        "control": "radio",
                        "required": true,
                        "defaultValue": "Standard",
                        "options": [
                          {
                            "value": "Standard",
                            "label": "Standard"
                          },
                          {
                            "value": "Premium",
                            "label": "Premium"
                          }
                        ]
                      },
                      {
                        "id": "redundancy",
                        "label": "Redundancy",
                        "control": "select",
                        "required": true,
                        "defaultValue": "GRS",
                        "options": [
                          {
                            "value": "LRS",
                            "label": "Locally-redundant storage (LRS)"
                          },
                          {
                            "value": "ZRS",
                            "label": "Zone-redundant storage (ZRS)"
                          },
                          {
                            "value": "GRS",
                            "label": "Geo-redundant storage (GRS)"
                          },
                          {
                            "value": "RA-GRS",
                            "label": "Read-access geo-redundant storage (RA-GRS)"
                          },
                          {
                            "value": "GZRS",
                            "label": "Geo-zone-redundant storage (GZRS)"
                          },
                          {
                            "value": "RA-GZRS",
                            "label": "Read-access geo-zone-redundant storage (RA-GZRS)"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "advanced",
                    "label": "Advanced",
                    "fields": [
                      {
                        "id": "secureTransfer",
                        "label": "Require secure transfer for REST API operations",
                        "control": "toggle",
                        "defaultValue": true,
                        "required": true
                      },
                      {
                        "id": "anonymousBlobAccess",
                        "label": "Allow enabling anonymous access on individual containers",
                        "control": "toggle",
                        "defaultValue": true
                      },
                      {
                        "id": "minimumTls",
                        "label": "Minimum TLS version",
                        "control": "select",
                        "required": true,
                        "defaultValue": "TLS 1.2",
                        "options": [
                          {
                            "value": "TLS 1.0",
                            "label": "TLS 1.0"
                          },
                          {
                            "value": "TLS 1.1",
                            "label": "TLS 1.1"
                          },
                          {
                            "value": "TLS 1.2",
                            "label": "TLS 1.2"
                          }
                        ]
                      },
                      {
                        "id": "accessTier",
                        "label": "Default access tier",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Hot",
                        "options": [
                          {
                            "value": "Hot",
                            "label": "Hot"
                          },
                          {
                            "value": "Cool",
                            "label": "Cool"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "networking",
                    "label": "Networking",
                    "fields": [
                      {
                        "id": "networkAccess",
                        "label": "Public network access",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Enabled from all networks",
                        "options": [
                          {
                            "value": "Enabled from all networks",
                            "label": "Enabled from all networks"
                          },
                          {
                            "value": "Enabled from selected virtual networks and IP addresses",
                            "label": "Enabled from selected virtual networks and IP addresses"
                          },
                          {
                            "value": "Disabled",
                            "label": "Disabled"
                          }
                        ]
                      }
                    ]
                  },
                  {
                    "id": "data-protection",
                    "label": "Data protection",
                    "fields": [
                      {
                        "id": "blobSoftDelete",
                        "label": "Enable soft delete for blobs",
                        "control": "toggle",
                        "defaultValue": true,
                        "required": true
                      },
                      {
                        "id": "containerSoftDelete",
                        "label": "Enable soft delete for containers",
                        "control": "toggle",
                        "defaultValue": true,
                        "required": true
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Create",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.primaryService",
                        "value": "Azure Blob Storage"
                      },
                      "message": "The invoice workload uses Blob Storage."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.performance",
                        "value": "Standard"
                      },
                      "message": "Use Standard for general-purpose blob storage."
                    },
                    {
                      "rule": {
                        "type": "oneOf",
                        "path": "$form.redundancy",
                        "values": [
                          "RA-GRS",
                          "RA-GZRS"
                        ]
                      },
                      "message": "Choose RA-GRS or RA-GZRS for read access to a secondary region during an outage."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.secureTransfer",
                        "value": true
                      },
                      "message": "Require secure transfer."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.anonymousBlobAccess",
                        "value": false
                      },
                      "message": "Disallow anonymous blob access for private invoices."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.minimumTls",
                        "value": "TLS 1.2"
                      },
                      "message": "Use minimum TLS 1.2."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.blobSoftDelete",
                        "value": true
                      },
                      "message": "Enable soft delete for blobs."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.containerSoftDelete",
                        "value": true
                      },
                      "message": "Enable soft delete for containers."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "storageAccounts",
                      "unique": "name",
                      "value": {
                        "name": "{{$form.name}}",
                        "resourceGroup": "{{$form.resourceGroup}}",
                        "location": "{{$form.region}}",
                        "primaryService": "{{$form.primaryService}}",
                        "performance": "{{$form.performance}}",
                        "redundancy": "{{$form.redundancy}}",
                        "secureTransfer": "{{$form.secureTransfer}}",
                        "anonymousBlobAccess": "{{$form.anonymousBlobAccess}}",
                        "minimumTls": "{{$form.minimumTls}}",
                        "defaultAccessTier": "{{$form.accessTier}}",
                        "networkAccess": "{{$form.networkAccess}}",
                        "blobSoftDelete": "{{$form.blobSoftDelete}}",
                        "containerSoftDelete": "{{$form.containerSoftDelete}}"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Deployment succeeded"
                    },
                    {
                      "type": "navigate",
                      "page": "storage-overview",
                      "select": {
                        "as": "storage",
                        "path": "storageAccounts",
                        "key": "name",
                        "value": "{{$form.name}}"
                      }
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "storage-overview",
            "title": "{{$sel.storage.name}}",
            "subtitle": "Storage account",
            "icon": "Database",
            "requires": "storage",
            "navItem": "storage-accounts",
            "breadcrumb": [
              "Home",
