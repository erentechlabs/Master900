{
  "labs": [
    {
      "slug": "create-storage-account-blob",
      "type": "UI_SIMULATION",
      "title": "Create a storage account and upload private invoice blobs",
      "summary": "Create a secure read-access geo-redundant storage account, create a private blob container, upload an invoice PDF, and move it to a cooler tier.",
      "scenario": "Northwind Traders stores monthly invoices in Azure Blob Storage. Create a storage account in **rg-data-prod** with a globally unique lowercase name. The account must survive a regional outage with read access to the secondary region, require secure transfer, disallow anonymous blob access, require **TLS 1.2**, and enable soft delete for blobs and containers. Then create a private **invoices** container, upload **invoice-2026-09.pdf** from the lab VM Documents list, and change the uploaded blob to **Cool** or **Archive**. Archive requires rehydration before reads.",
      "domainKey": "azure-architecture-services",
      "moduleSlug": "azure-storage-services",
      "objectiveCode": "2.3",
      "complexity": "INTERMEDIATE",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Create a secure storage account",
        "Choose redundancy for read access to a secondary region",
        "Create a private blob container",
        "Upload a blob and change its access tier"
      ],
      "prerequisites": [
        "Know what storage accounts, blob containers, and redundancy are"
      ],
      "sources": [
        {
          "title": "Create an Azure Storage Account",
          "url": "https://learn.microsoft.com/en-us/azure/storage/common/storage-account-create"
        },
        {
          "title": "Quickstart: Upload, download, and list blobs - Azure portal",
          "url": "https://learn.microsoft.com/en-us/azure/storage/blobs/storage-quickstart-blobs-portal"
        },
        {
          "title": "Data redundancy - Azure Storage",
          "url": "https://learn.microsoft.com/en-us/azure/storage/common/storage-redundancy"
        },
        {
          "title": "Access tiers for blob data",
          "url": "https://learn.microsoft.com/en-us/azure/storage/blobs/access-tiers-overview"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Azure",
          "theme": "azure",
          "user": "alex@contoso.example",
          "tenant": "Contoso (contoso.example)",
          "url": "https://portal.azure.com",
          "searchPlaceholder": "Search resources, services, and docs (G+/)"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser"
          ]
        },
        "clock": {
          "start": "2026-09-30T09:00:00Z"
        },
        "startPage": "home",
        "navigation": [
          {
            "page": "home",
            "label": "Home",
            "icon": "Home"
          },
          {
            "page": "storage-accounts",
            "label": "Storage accounts",
            "icon": "Database",
            "section": "Favorites"
          }
        ],
        "pages": [
          {
            "id": "home",
            "title": "Home",
            "url": "/#home",
            "components": [
              {
                "kind": "tiles",
                "id": "services",
                "title": "Azure services",
                "size": "sm",
                "items": [
                  {
                    "id": "storage-accounts",
                    "label": "Storage accounts",
                    "icon": "Database",
                    "action": {
                      "type": "navigate",
                      "page": "storage-accounts"
                    }
                  },
                  {
                    "id": "resource-groups",
                    "label": "Resource groups",
                    "icon": "Boxes",
                    "action": {
                      "type": "message",
                      "text": "Use rg-data-prod for this lab."
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "storage-accounts",
            "title": "Storage accounts",
            "icon": "Database",
            "url": "/#browse/Microsoft.Storage%2FStorageAccounts",
            "commands": [
              {
                "id": "storage-create",
                "label": "Create",
                "icon": "Plus",
                "variant": "primary",
                "action": {
                  "type": "navigate",
                  "page": "storage-create"
                }
              }
            ],
            "components": [
              {
                "kind": "table",
                "id": "storage-list",
                "source": "storageAccounts",
                "rowKey": "name",
                "columns": [
                  {
                    "key": "name",
