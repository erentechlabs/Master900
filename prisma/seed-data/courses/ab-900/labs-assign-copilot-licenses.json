      "steps": [
        {
          "key": "fix-usage-location",
          "title": "Fix the missing usage location",
          "instruction": "Open **Users > Active users**, select **Priya**, and in **Manage settings** set **Usage location** to **United States**.",
          "hint": "The Active users table shows **Not set** for Priya.",
          "explanation": "A usage location is required before service plans can be assigned correctly. Pilot users also need a qualifying Microsoft 365 plan.",
          "targetId": "active-users-table",
          "rules": [
            {
              "key": "priya-location-set",
              "description": "Priya has a usage location",
              "rule": {
                "type": "arrayContains",
                "path": "users",
                "match": {
                  "upn": "priya@contoso.example",
                  "usageLocation": "United States"
                }
              },
              "failureFeedback": "Select Priya and save Usage location as United States."
            }
          ]
        },
        {
          "key": "assign-group-license",
          "title": "Assign Copilot licenses to the pilot group",
          "instruction": "Go to **Billing > Licenses > Microsoft Copilot**, select **Assign licenses**, and assign the subscription to the **Copilot Pilot - Sales** group only.",
          "hint": "Do not choose **All users** or the broader **Sales department** group.",
          "explanation": "Group-based licensing keeps the pilot scoped and automatically covers future members of the approved group.",
          "targetId": "assign-copilot-license",
          "rules": [
            {
              "key": "pilot-assigned",
              "description": "Microsoft Copilot is assigned to Copilot Pilot - Sales",
              "rule": {
                "type": "arrayContains",
                "path": "licenseAssignments",
                "match": {
                  "target": "Copilot Pilot - Sales",
                  "product": "Microsoft Copilot",
                  "status": "Assigned"
                }
              },
              "failureFeedback": "Assign Microsoft Copilot to the Copilot Pilot - Sales group."
            }
          ]
        },
        {
          "key": "check-assignment-status",
          "title": "Check assignment status",
          "instruction": "On **Microsoft Copilot > Assignments**, confirm that **Copilot Pilot - Sales** shows **Assigned**, then open **Errors & issues** to verify there are no blocking pilot assignment errors.",
          "hint": "The product details page lists group-based assignments by group name.",
          "explanation": "The Licenses page shows whether the product is assigned directly or through a group and provides an Errors & issues tab for assignment problems.",
          "targetId": "copilot-license-assignments",
          "rules": [
            {
              "key": "copilot-users-updated",
              "description": "Pilot users receive Copilot through the pilot group",
              "rule": {
                "type": "allOf",
                "rules": [
                  {
                    "type": "arrayContains",
                    "path": "users",
                    "match": {
                      "upn": "sofia@contoso.example",
                      "copilot": "Assigned by Copilot Pilot - Sales"
                    }
                  },
                  {
                    "type": "arrayContains",
                    "path": "users",
                    "match": {
                      "upn": "priya@contoso.example",
                      "copilot": "Assigned by Copilot Pilot - Sales"
                    }
                  }
                ]
              },
              "failureFeedback": "The pilot group assignment should update pilot users."
            }
          ]
        },
        {
          "key": "configure-copilot-settings",
          "title": "Configure Copilot settings",
          "instruction": "Go to **Copilot > Settings**. Set **Pin Microsoft Copilot Chat** to **Pin Copilot Chat in Microsoft 365 apps (recommended)** and turn **Allow web search in Copilot** **Off** for the pilot.",
          "hint": "The scenario pins Copilot Chat for easy access but disables web search until the data governance team completes the pilot review.",
          "explanation": "Copilot settings are managed with the AI Administrator role. Web search controls generated web queries; pinning improves discoverability in Microsoft 365 apps.",
          "targetId": "copilot-controls",
          "rules": [
            {
              "key": "settings-configured",
              "description": "Pinning is enabled and web search is off",
              "rule": {
                "type": "allOf",
                "rules": [
                  {
                    "type": "equals",
                    "path": "copilotSettings.pinCopilotChat",
                    "value": "Pin Copilot Chat in Microsoft 365 apps"
                  },
                  {
                    "type": "equals",
                    "path": "copilotSettings.webSearchAllowed",
                    "value": false
                  }
                ]
              },
              "failureFeedback": "Set pinning to the recommended option and turn Allow web search in Copilot off."
            }
          ]
        },
        {
          "key": "view-usage-report",
          "title": "Open the Microsoft Copilot usage report",
          "instruction": "Open **Reports > Usage > Microsoft Copilot** and review the readiness and usage view for the Sales pilot.",
          "hint": "You can also reach the report from the Copilot page **Usage** tile.",
          "explanation": "Usage reports help administrators track readiness and adoption after assignment; they do not change permissions or expose data.",
          "targetId": "report-tiles",
          "rules": [
            {
              "key": "usage-report-opened",
              "description": "The Microsoft Copilot usage report was opened",
              "rule": {
                "type": "visited",
                "page": "copilot-usage"
              }
            }
          ]
        }
      ],
