{
  "labs": [
    {
      "slug": "assign-copilot-licenses",
      "type": "UI_SIMULATION",
      "title": "Assign Microsoft Copilot licenses for a Sales pilot",
      "summary": "Use the Microsoft 365 admin center to prepare pilot users, assign Microsoft Copilot licenses to the Sales pilot group, configure Copilot settings, and review usage readiness.",
      "scenario": "Contoso is starting a Microsoft Copilot pilot for the Sales team. In the **simulated Microsoft 365 admin center**, verify that the pilot users are eligible, fix the one missing **Usage location**, assign **Microsoft Copilot** licenses only to **Copilot Pilot - Sales**, confirm assignment status, configure Copilot settings, and open the Microsoft Copilot usage report. Use least privilege: License Administrator for licensing and AI Administrator for Copilot settings; reserve Global Administrator for emergencies.",
      "domainKey": "copilot-agent-administration",
      "objectiveCode": "3.2",
      "complexity": "BASIC",
      "estimatedMinutes": 25,
      "learningObjectives": [
        "Check Microsoft Copilot licensing prerequisites, including a qualifying Microsoft 365 plan and usage location",
        "Assign Copilot licenses with group-based licensing instead of an org-wide direct assignment",
        "Configure documented Copilot settings in the Microsoft 365 admin center",
        "Explain that Copilot uses Microsoft Graph and the semantic index while respecting existing Microsoft 365 permissions"
      ],
      "prerequisites": [
        "Know what users, groups, licenses, and admin roles are in Microsoft 365"
      ],
      "sources": [
        {
          "title": "Study guide for Exam AB-900",
          "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/ab-900"
        },
        {
          "title": "Set Up Microsoft Copilot and Assign Licenses",
          "url": "https://learn.microsoft.com/en-us/microsoft-365/copilot/microsoft-365-copilot-setup"
        },
        {
          "title": "Assign or unassign licenses to a group in the Microsoft 365 admin center",
          "url": "https://learn.microsoft.com/en-us/microsoft-365/admin/manage/manage-group-licenses?view=o365-worldwide"
        },
        {
          "title": "Manage Microsoft Copilot Settings",
          "url": "https://learn.microsoft.com/en-us/microsoft-365/copilot/microsoft-365-copilot-page"
        },
        {
          "title": "Manage Microsoft Copilot Chat",
          "url": "https://learn.microsoft.com/en-us/copilot/manage"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft 365 admin center",
