          {
            "id": "assign-copilot-license",
            "title": "Assign licenses",
            "subtitle": "Microsoft Copilot",
            "icon": "Plus",
            "url": "/adminportal/home#/licenses/Microsoft-Copilot/assign",
            "navItem": "licenses",
            "breadcrumb": [
              "Home",
              "Billing",
              "Licenses",
              "Microsoft Copilot"
            ],
            "components": [
              {
                "kind": "callout",
                "variant": "warning",
                "text": "Do not assign this product to **All users**. This is a controlled Sales pilot with a limited pool of licenses."
              },
              {
                "kind": "form",
                "id": "assign-license-form",
                "title": "Assign licenses",
                "description": "Search for users or groups and choose the subscription to assign from.",
                "fields": [
                  {
                    "id": "assignmentType",
                    "label": "Assign licenses to",
                    "control": "radio",
                    "required": true,
                    "defaultValue": "group",
                    "options": [
                      {
                        "value": "group",
                        "label": "A group"
                      },
                      {
                        "value": "users",
                        "label": "Selected users"
                      },
                      {
                        "value": "all",
                        "label": "All users"
                      }
                    ]
                  },
                  {
                    "id": "group",
                    "label": "Search for a group",
                    "control": "select",
                    "required": true,
                    "visibleWhen": {
                      "type": "equals",
                      "path": "$form.assignmentType",
                      "value": "group"
                    },
                    "optionsFrom": {
                      "path": "groups",
                      "value": "name"
                    }
                  },
                  {
                    "id": "subscription",
                    "label": "Subscription",
                    "control": "select",
                    "required": true,
                    "defaultValue": "Microsoft Copilot",
                    "options": [
                      {
                        "value": "Microsoft Copilot",
                        "label": "Microsoft Copilot"
                      }
                    ]
                  },
                  {
                    "id": "apps",
                    "label": "Apps and services",
                    "control": "checkboxes",
                    "defaultValue": [
                      "copilot"
                    ],
                    "options": [
                      {
                        "value": "copilot",
                        "label": "Microsoft Copilot"
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Assign licenses",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.assignmentType",
                        "value": "group"
                      },
                      "message": "Use group-based licensing for this pilot. Direct assignment to selected users or all users would be harder to govern."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.group",
                        "value": "Copilot Pilot - Sales"
                      },
                      "message": "Assign licenses only to Copilot Pilot - Sales. The other groups are outside the pilot or too large for available licenses."
                    },
                    {
                      "rule": {
                        "type": "allOf",
                        "rules": [
                          {
                            "type": "arrayContains",
                            "path": "users",
                            "match": {
                              "upn": "sofia@contoso.example",
                              "usageLocation": "United States",
                              "qualifyingPlan": true
                            }
                          },
                          {
                            "type": "arrayContains",
                            "path": "users",
                            "match": {
                              "upn": "priya@contoso.example",
                              "usageLocation": "United States",
                              "qualifyingPlan": true
                            }
                          },
                          {
                            "type": "arrayContains",
                            "path": "users",
                            "match": {
                              "upn": "mehmet@contoso.example",
                              "usageLocation": "United States",
                              "qualifyingPlan": true
                            }
                          },
                          {
                            "type": "arrayContains",
                            "path": "users",
                            "match": {
                              "upn": "alex@contoso.example",
                              "usageLocation": "United States",
                              "qualifyingPlan": true
                            }
                          }
                        ]
                      },
                      "message": "Every pilot user must have a qualifying Microsoft 365 plan and a usage location."
                    },
                    {
                      "rule": {
                        "type": "arrayNotContains",
                        "path": "licenseAssignments",
                        "match": {
                          "target": "Copilot Pilot - Sales"
                        }
                      },
                      "message": "The pilot group already has this product assigned."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "licenseAssignments",
                      "unique": "target",
                      "value": {
                        "target": "{{$form.group}}",
                        "assignmentType": "Group",
                        "product": "Microsoft Copilot",
                        "members": 4,
                        "status": "Assigned",
                        "services": [
                          "Microsoft Copilot"
                        ],
                        "assignedAt": "{{$now}}"
                      }
                    },
                    {
                      "type": "update",
                      "path": "users",
                      "where": {
                        "pilot": true
                      },
                      "set": {
                        "copilot": "Assigned by Copilot Pilot - Sales"
                      }
                    },
                    {
                      "type": "update",
                      "path": "licenseProducts",
                      "where": {
                        "name": "Microsoft Copilot"
                      },
                      "set": {
                        "available": 21,
                        "assigned": 4
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Licenses assigned",
                      "message": "Microsoft Copilot licenses were assigned to Copilot Pilot - Sales."
                    },
                    {
                      "type": "navigate",
                      "page": "copilot-license"
                    }
                  ],
                  "successMessage": "Assigned"
                }
              }
            ]
          },
