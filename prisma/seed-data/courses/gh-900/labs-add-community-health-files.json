                    "control": "code",
                    "language": "markdown",
                    "required": true,
                    "minLength": 120,
                    "defaultValue": "# Trail Mapper\n\nTrail Mapper is a fictional open-source sample that helps learners practice GitHub community workflows.\n\n## Getting started\n\nRun the sample locally with npm test.\n\n## Contributing\n\nPlease read CONTRIBUTING.md and the Code of Conduct before opening issues or pull requests.\n\n## License\n\nThis project uses the MIT License.\n"
                  },
                  {
                    "id": "message",
                    "label": "Commit message",
                    "control": "text",
                    "required": true,
                    "defaultValue": "Improve README community information"
                  }
                ],
                "submit": {
                  "label": "Commit changes",
                  "checks": [
                    {
                      "rule": {
                        "type": "matches",
                        "path": "$form.content",
                        "pattern": "Getting started"
                      },
                      "message": "README should explain how to get started."
                    },
                    {
                      "rule": {
                        "type": "matches",
                        "path": "$form.content",
                        "pattern": "Contributing"
                      },
                      "message": "README should point contributors to guidance."
                    }
                  ],
                  "actions": [
                    {
                      "type": "set",
                      "path": "readme",
                      "value": "{{$form.content}}"
                    },
                    {
                      "type": "set",
                      "path": "health.readme",
                      "value": true
                    },
                    {
                      "type": "update",
                      "path": "files",
                      "where": {
                        "path": "README.md"
