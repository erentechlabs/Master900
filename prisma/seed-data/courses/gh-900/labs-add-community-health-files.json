{
  "labs": [
    {
      "slug": "add-community-health-files",
      "type": "UI_SIMULATION",
      "title": "Add community health files to a public repository",
      "summary": "Improve README, add a license, contribution guide, code of conduct, issue templates, and Discussions so the Community Standards checklist reaches 100%.",
      "scenario": "Contoso OSS is preparing **trail-mapper** for outside contributors. The maintainer asks you to make the repository welcoming and supportable before promoting it: improve the README, add community health files, configure issue templates, enable Discussions, and verify **Community Standards** reaches 100%.",
      "domainKey": "github-community",
      "objectiveCode": "7.1",
      "complexity": "BASIC",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Identify common community health files for a public repository",
        "Use the Community Standards checklist to add missing files",
        "Configure bug report and feature request issue templates",
        "Enable Discussions for community Q&A"
      ],
      "prerequisites": [
        "Basic repository navigation"
      ],
      "sources": [
        {
          "title": "About community profiles for public repositories",
          "url": "https://docs.github.com/en/communities/setting-up-your-project-for-healthy-contributions/about-community-profiles-for-public-repositories"
        },
        {
          "title": "About the repository README file",
          "url": "https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/about-readmes"
        },
        {
          "title": "Licensing a repository",
          "url": "https://docs.github.com/en/repositories/managing-your-repositorys-settings-and-features/customizing-your-repository/licensing-a-repository"
        },
        {
          "title": "Configuring issue templates for your repository",
          "url": "https://docs.github.com/en/communities/using-templates-to-encourage-useful-issues-and-pull-requests/configuring-issue-templates-for-your-repository"
        }
      ],
