          {
            "id": "alert-detail",
            "title": "Dependabot alert {{$sel.alert.id}}",
            "subtitle": "{{$sel.alert.package}}",
            "icon": "ShieldAlert",
            "requires": "alert",
            "navItem": "security",
            "components": [
              {
                "kind": "properties",
                "title": "Alert details",
                "items": [
                  {
                    "label": "Package",
                    "value": "{{$sel.alert.package}}"
                  },
                  {
                    "label": "Severity",
                    "value": "{{$sel.alert.severity}}",
                    "format": "status"
                  },
                  {
                    "label": "Affected file",
                    "value": "{{$sel.alert.file}}"
                  },
                  {
                    "label": "Dependabot pull request",
                    "value": "#{{$sel.alert.pullRequest}}"
                  }
                ]
              },
              {
                "kind": "button",
                "id": "merge-dependabot",
                "label": "Merge Dependabot pull request",
                "icon": "GitMerge",
                "variant": "primary",
                "action": {
                  "type": "sequence",
                  "actions": [
                    {
                      "type": "update",
                      "path": "dependabotAlerts",
                      "where": {
                        "id": "{{$sel.alert.id}}"
                      },
                      "set": {
                        "state": "Fixed",
                        "merged": true
                      }
                    },
                    {
                      "type": "append",
                      "path": "mergedPullRequests",
                      "value": {
                        "number": "{{$sel.alert.pullRequest}}",
                        "title": "Bump {{$sel.alert.package}} to patched version",
                        "result": "Merged"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Dependabot pull request merged",
                      "message": "The critical alert is fixed."
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "policy",
            "title": "Security policy",
            "subtitle": "Security > Policy",
            "icon": "FileLock",
