              }
            ],
            "commands": [
              {
                "id": "new-ruleset",
                "label": "New branch ruleset",
                "icon": "Plus",
                "variant": "primary",
                "action": {
                  "type": "navigate",
                  "page": "ruleset-new"
                }
              }
            ],
            "components": [
              {
                "kind": "text",
                "text": "Rulesets are named lists of rules for branches or tags. They can be **Active**, evaluated, or disabled. Active branch rules can restrict deletions, require pull requests and status checks, and block force pushes."
              },
              {
                "kind": "table",
                "id": "rules-table",
                "title": "Rulesets",
                "source": "rulesets",
                "rowKey": "name",
                "emptyText": "No rulesets configured.",
                "columns": [
                  {
                    "key": "name",
                    "label": "Name",
                    "format": "link"
                  },
                  {
                    "key": "enforcement",
                    "label": "Enforcement",
                    "format": "status"
                  },
                  {
                    "key": "target",
                    "label": "Target"
                  },
                  {
                    "key": "rules",
                    "label": "Rules",
                    "format": "tags"
                  }
                ]
              }
            ]
          },
          {
            "id": "ruleset-new",
            "title": "New branch ruleset",
            "subtitle": "Rules",
            "icon": "Gavel",
            "url": "/contoso-labs/inventory-api/settings/rules/new?target=branch",
            "navItem": "settings",
            "breadcrumb": [
              "Settings",
              "Rules"
            ],
            "components": [
              {
                "kind": "form",
                "id": "ruleset-form",
                "title": "Branch ruleset",
                "fields": [
                  {
                    "id": "name",
                    "label": "Ruleset name",
                    "control": "text",
                    "required": true,
                    "defaultValue": "Protect main"
                  },
                  {
                    "id": "enforcement",
                    "label": "Enforcement status",
                    "control": "select",
                    "required": true,
                    "options": [
                      {
                        "value": "Evaluate",
                        "label": "Evaluate"
                      },
                      {
                        "value": "Active",
                        "label": "Active"
                      },
                      {
                        "value": "Disabled",
                        "label": "Disabled"
                      }
                    ],
                    "defaultValue": "Active"
                  },
                  {
                    "id": "target",
                    "label": "Target branches",
                    "control": "select",
                    "required": true,
                    "options": [
                      {
                        "value": "Include default branch",
                        "label": "Include default branch"
                      },
                      {
                        "value": "Include all branches",
                        "label": "Include all branches"
                      }
                    ],
                    "defaultValue": "Include default branch"
                  },
                  {
                    "id": "rules",
                    "label": "Rules",
                    "control": "checkboxes",
                    "required": true,
                    "options": [
                      {
                        "value": "Restrict deletions",
                        "label": "Restrict deletions"
                      },
                      {
                        "value": "Require a pull request before merging",
                        "label": "Require a pull request before merging"
                      },
                      {
                        "value": "Require status checks to pass",
                        "label": "Require status checks to pass"
                      },
                      {
                        "value": "Block force pushes",
                        "label": "Block force pushes"
                      }
                    ],
                    "defaultValue": [
                      "Restrict deletions",
                      "Require a pull request before merging",
                      "Require status checks to pass",
                      "Block force pushes"
                    ]
                  },
                  {
                    "id": "approvals",
                    "label": "Required approvals",
                    "control": "number",
                    "required": true,
                    "defaultValue": 1,
                    "min": 1
                  },
                  {
                    "id": "check",
                    "label": "Required status check",
                    "control": "text",
                    "required": true,
                    "defaultValue": "Node.js CI / build"
                  }
                ],
                "submit": {
                  "label": "Create",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.enforcement",
                        "value": "Active"
                      },
                      "message": "Use Active enforcement."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.target",
                        "value": "Include default branch"
                      },
                      "message": "Target the default branch."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.approvals",
                        "value": 1
                      },
                      "message": "Use one required approval."
                    },
                    {
                      "rule": {
                        "type": "includes",
                        "path": "$form.rules",
                        "value": "Restrict deletions"
                      },
                      "message": "Enable Restrict deletions."
                    },
                    {
                      "rule": {
                        "type": "includes",
                        "path": "$form.rules",
                        "value": "Require a pull request before merging"
                      },
                      "message": "Enable Require a pull request before merging."
                    },
                    {
                      "rule": {
                        "type": "includes",
                        "path": "$form.rules",
                        "value": "Require status checks to pass"
                      },
                      "message": "Enable Require status checks to pass."
                    },
                    {
                      "rule": {
                        "type": "includes",
                        "path": "$form.rules",
                        "value": "Block force pushes"
                      },
                      "message": "Enable Block force pushes."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "rulesets",
                      "unique": "name",
                      "value": {
                        "name": "{{$form.name}}",
                        "enforcement": "{{$form.enforcement}}",
                        "target": "{{$form.target}}",
                        "rules": "{{$form.rules | list}}",
                        "requiredApprovals": "{{$form.approvals}}",
                        "requiredStatusCheck": "{{$form.check}}"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Ruleset created",
                      "message": "Protect main is active."
                    },
                    {
                      "type": "navigate",
                      "page": "rules"
                    }
                  ]
                }
              }
            ]
          },
          {
