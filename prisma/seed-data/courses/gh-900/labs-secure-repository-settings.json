                    {
                      "type": "set",
                      "path": "security.policyCommitted",
                      "value": true
                    },
                    {
                      "type": "notify",
                      "title": "SECURITY.md committed"
                    },
                    {
                      "type": "navigate",
                      "page": "security"
                    }
                  ]
                }
              },
              {
                "kind": "code",
                "id": "policy-preview",
                "title": "Policy starter",
