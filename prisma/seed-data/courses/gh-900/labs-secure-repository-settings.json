{
  "labs": [
    {
      "slug": "secure-repository-settings",
      "type": "UI_SIMULATION",
      "title": "Secure a repository with access, rulesets, and code security settings",
      "summary": "Configure least-privilege access, an active default-branch ruleset, repository code security features, a simulated Dependabot remediation, and SECURITY.md.",
      "scenario": "The simulated **contoso-labs/inventory-api** repository is moving toward production. Give an external contractor only the access required for triage, protect **main** with an active ruleset, enable code security settings including push protection and CodeQL default setup, review a critical Dependabot alert, and commit a security policy. Do not type real secrets or tokens.",
      "domainKey": "privacy-security-administration",
      "objectiveCode": "6.1",
      "complexity": "INTERMEDIATE",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Apply least privilege with GitHub repository roles",
        "Create an active branch ruleset for the default branch",
        "Enable Dependabot, secret scanning with push protection, and CodeQL default setup"
      ],
      "prerequisites": [
        "Know what repository roles, branches, pull requests, and security alerts are"
      ],
      "sources": [
        {
          "title": "About rulesets",
          "url": "https://docs.github.com/en/repositories/configuring-branches-and-merges-in-your-repository/managing-rulesets/about-rulesets"
        },
        {
          "title": "GitHub security features",
          "url": "https://docs.github.com/en/code-security/getting-started/github-security-features"
        },
        {
          "title": "Dependabot alerts",
          "url": "https://docs.github.com/en/code-security/concepts/supply-chain-security/dependabot-alerts"
        },
        {
          "title": "Push protection",
          "url": "https://docs.github.com/en/code-security/concepts/secret-security/push-protection"
        }
      ],
      "config": {
        "portal": {
          "name": "GitHub",
          "theme": "github",
          "user": "alex-contoso",
          "tenant": "contoso-labs",
          "url": "https://github.com",
          "searchPlaceholder": "Type / to search"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser"
          ]
        },
        "clock": {
          "start": "2026-09-30T09:00:00Z"
        },
