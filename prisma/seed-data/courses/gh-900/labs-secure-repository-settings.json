          {
            "id": "collab",
            "title": "Collaborators and teams",
            "subtitle": "Settings",
            "icon": "Users",
            "url": "/contoso-labs/inventory-api/settings/access",
            "navItem": "settings",
            "menu": [
              {
                "page": "settings",
                "label": "General",
                "icon": "Settings"
              },
              {
                "page": "collab",
                "label": "Collaborators and teams",
                "icon": "Users"
              },
              {
                "page": "rules",
                "label": "Rules",
                "icon": "Gavel"
              },
              {
                "page": "code-security",
                "label": "Code security",
                "icon": "ShieldCheck"
              }
            ],
            "components": [
              {
                "kind": "callout",
                "variant": "info",
                "title": "Least privilege",
                "text": "A contractor who triages issues can use **Triage** or **Read**. **Write** allows pushing code, and **Admin** can change repository settings."
              },
              {
                "kind": "form",
                "id": "contractor-form",
                "title": "Add people",
                "fields": [
                  {
                    "id": "handle",
                    "label": "Username",
                    "control": "text",
                    "required": true,
                    "defaultValue": "taylor-contractor"
                  },
                  {
                    "id": "role",
                    "label": "Role",
                    "control": "select",
                    "required": true,
                    "options": [
                      {
                        "value": "Read",
                        "label": "Read"
                      },
                      {
                        "value": "Triage",
                        "label": "Triage"
                      },
                      {
                        "value": "Write",
                        "label": "Write"
                      },
                      {
                        "value": "Maintain",
                        "label": "Maintain"
                      },
                      {
                        "value": "Admin",
                        "label": "Admin"
                      }
                    ],
                    "defaultValue": "Triage"
                  }
                ],
                "submit": {
                  "label": "Add taylor-contractor to this repository",
                  "checks": [
                    {
                      "rule": {
                        "type": "not",
                        "rule": {
                          "type": "oneOf",
                          "path": "$form.role",
                          "values": [
                            "Write",
                            "Maintain",
                            "Admin"
                          ]
                        }
                      },
                      "message": "This contractor only needs Read or Triage. Write, Maintain, or Admin grants too much access."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "collaborators",
                      "unique": "handle",
                      "value": {
                        "handle": "{{$form.handle}}",
                        "role": "{{$form.role}}",
                        "external": true,
                        "twoFactor": "Required by organization policy"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Access invitation sent",
                      "message": "{{$form.handle}} was invited with {{$form.role}} access."
                    }
                  ]
                }
              },
              {
                "kind": "table",
                "id": "collab-table",
                "title": "People with access",
                "source": "collaborators",
                "rowKey": "handle",
                "columns": [
                  {
                    "key": "handle",
                    "label": "User",
                    "format": "code"
                  },
                  {
                    "key": "role",
                    "label": "Role",
                    "format": "badge"
                  },
                  {
                    "key": "external",
                    "label": "External",
                    "format": "bool"
                  },
                  {
                    "key": "twoFactor",
                    "label": "2FA"
                  }
                ]
              }
            ]
          },
          {
            "id": "rules",
            "title": "Rules",
            "subtitle": "Rulesets",
            "icon": "Gavel",
            "url": "/contoso-labs/inventory-api/settings/rules",
            "navItem": "settings",
            "menu": [
              {
                "page": "settings",
                "label": "General",
                "icon": "Settings"
              },
              {
                "page": "collab",
                "label": "Collaborators and teams",
