              "status": "Failing expectation"
            },
            {
              "path": ".github/workflows/node.js.yml",
              "type": "YAML",
              "status": "Not created"
            }
          ],
          "readme": "# Inventory API\n\nFictional API for GitHub Actions practice.",
          "workflowFile": {},
          "workflowRuns": [],
          "tests": {
            "skuTest": ""
          },
          "badgeAdded": false
        }
      },
      "steps": [
        {
          "key": "choose-template",
          "title": "Choose the Node.js workflow template",
          "instruction": "Open **Actions**. Under **Get started with GitHub Actions**, choose the **Node.js** workflow template under Continuous integration and select **Configure**.",
          "hint": "Do not choose Docker or Pages.",
          "explanation": "Workflow templates provide a starting YAML file for common languages and tools.",
          "targetId": "templates",
          "rules": [
            {
              "key": "opened-editor",
              "description": "Workflow editor opened",
              "rule": {
                "type": "visited",
                "page": "configure"
              },
              "failureFeedback": "Open the Node.js workflow template."
            }
          ]
        },
        {
          "key": "commit-workflow",
          "title": "Commit node.js.yml",
          "instruction": "Keep `.github/workflows/node.js.yml` with **push** and **pull_request** events for **main**, a **build** job on **ubuntu-latest**, a Node.js matrix, and steps for **actions/checkout**, **actions/setup-node**, **npm ci**, and **npm test**. Select **Commit changes...**.",
          "hint": "YAML indentation matters.",
          "explanation": "Events start workflow runs. Jobs run on runners. Steps run actions or commands.",
          "targetId": "workflow-form",
          "rules": [
            {
              "key": "workflow-file",
              "description": "Workflow file has required CI content",
              "rule": {
                "type": "matches",
                "path": "workflowFile.content",
                "pattern": "actions/setup-node@v4[\\s\\S]*npm ci[\\s\\S]*npm test"
              },
              "failureFeedback": "Commit the Node.js workflow with setup-node, npm ci, and npm test."
            }
          ]
        },
        {
          "key": "inspect-logs",
          "title": "Inspect the failed run log",
          "instruction": "Open the failed **Node.js CI** run from the **Actions** run list. Review the **npm test** logs for the failed matrix leg.",
          "hint": "The failed step is expanded and shows the expected and received values.",
          "explanation": "Workflow run logs show the status and output of each job step, including failures that need troubleshooting.",
          "targetId": "runs",
          "rules": [
            {
              "key": "failed-run-opened",
              "description": "Failed run detail was opened",
              "rule": {
                "type": "visited",
                "page": "run"
              },
              "failureFeedback": "Open the failed workflow run."
            }
          ]
        },
        {
          "key": "fix-test",
          "title": "Fix the failing test",
          "instruction": "Select **Edit failing test**, update `tests/sku.test.ts` so it expects **SKU-123**, and **Commit changes**.",
          "hint": "The workflow YAML is correct; the simulated problem is the test expectation.",
          "explanation": "After a fix commit, GitHub Actions starts a new workflow run so the team can verify the correction.",
          "targetId": "edit-fix",
          "rules": [
            {
              "key": "success-run",
              "description": "A later run succeeded",
              "rule": {
                "type": "arrayContains",
                "path": "workflowRuns",
                "match": {
                  "id": "102",
                  "conclusion": "success"
                }
              },
              "failureFeedback": "Commit the fixed test so run 102 succeeds."
            }
          ]
        },
        {
          "key": "verify-latest",
          "title": "Verify the latest run succeeded",
          "instruction": "Return to **Actions** and confirm the latest **Node.js CI** run has result **success**. Optionally add the status badge to README.md.",
          "hint": "The latest run is the one created after the fix commit.",
          "explanation": "Successful checks can be required by rulesets before merge. Status badges make workflow health visible from the README.",
          "targetId": "runs",
          "rules": [
            {
              "key": "latest-success",
              "description": "Latest run succeeded",
              "rule": {
                "type": "arrayContains",
                "path": "workflowRuns",
                "match": {
                  "id": "102",
                  "name": "Node.js CI",
                  "conclusion": "success"
                }
              },
              "failureFeedback": "Verify the successful run."
            }
          ]
        }
      ],
      "finalRules": [
        {
          "key": "workflow-success",
          "description": "Workflow file exists and latest run succeeded",
          "rule": {
            "type": "allOf",
            "rules": [
              {
                "type": "matches",
                "path": "workflowFile.path",
                "pattern": "^\\.github/workflows/node\\.js\\.yml$"
              },
              {
                "type": "matches",
                "path": "workflowFile.content",
                "pattern": "pull_request:[\\s\\S]*branches: \\[main\\]"
              },
              {
                "type": "arrayContains",
                "path": "workflowRuns",
                "match": {
                  "id": "102",
                  "conclusion": "success"
                }
              }
            ]
          },
          "successFeedback": "The workflow file is on main and the latest run succeeded.",
          "failureFeedback": "Commit node.js.yml and fix the failing run so the latest run succeeds."
        }
      ],
      "solution": "1. Open **Actions** and choose **Node.js** under Continuous integration.\n2. Select **Configure** and keep `.github/workflows/node.js.yml` with `push` and `pull_request` events for `main`, `jobs.build.runs-on: ubuntu-latest`, a Node.js matrix, `actions/checkout@v4`, `actions/setup-node@v4`, `npm ci`, and `npm test`. Select **Commit changes...**.\n3. Open the failed **Node.js CI** run and inspect the **npm test** logs. The simulated Node 22.x leg reports `Expected: SKU-123` and `Received: sku-123`.\n4. Select **Edit failing test**, update `tests/sku.test.ts` to expect `SKU-123`, and **Commit changes**.\n5. Return to **Actions** and verify the latest **Node.js CI** run shows **success**. Optionally add the status badge Markdown to README.md."
    }
  ]
}
