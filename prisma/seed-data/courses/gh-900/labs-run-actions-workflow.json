{
  "labs": [
    {
      "slug": "run-actions-workflow",
      "type": "UI_SIMULATION",
      "title": "Create and troubleshoot a GitHub Actions workflow",
      "summary": "Configure a Node.js GitHub Actions workflow from a template, inspect a failed workflow run log, fix the simulated test failure, and verify the latest run succeeds.",
      "scenario": "Contoso Labs wants continuous integration for **contoso-labs/inventory-api**. In the simulated GitHub repository, open **Actions**, choose the **Node.js** workflow template under Continuous integration, commit `.github/workflows/node.js.yml`, inspect the failed **npm test** logs for one matrix leg, fix the scenario, and verify the new run succeeds. Everything is simulated; no real runner is used.",
      "domainKey": "modern-development",
      "objectiveCode": "4.1",
      "complexity": "BASIC",
      "estimatedMinutes": 25,
      "learningObjectives": [
        "Create a workflow from a GitHub Actions template",
        "Explain events, jobs, steps, actions, and GitHub-hosted runners",
        "Use workflow run logs to diagnose and fix a failed CI run"
      ],
      "prerequisites": [
        "Basic understanding of automated tests and pull requests"
      ],
      "sources": [
        {
          "title": "Using workflow templates",
          "url": "https://docs.github.com/en/actions/how-tos/write-workflows/use-workflow-templates"
        },
        {
          "title": "Using workflow run logs",
          "url": "https://docs.github.com/en/actions/how-tos/monitor-workflows/use-workflow-run-logs"
        },
        {
          "title": "Continuous integration",
          "url": "https://docs.github.com/en/actions/get-started/continuous-integration"
        }
      ],
