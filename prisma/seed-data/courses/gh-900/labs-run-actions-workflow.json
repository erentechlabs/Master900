          {
            "id": "configure",
            "title": "Configure Node.js workflow",
            "subtitle": ".github/workflows/node.js.yml",
            "icon": "Workflow",
            "url": "/contoso-labs/inventory-api/actions/new?category=continuous-integration&query=node",
            "navItem": "actions",
            "components": [
              {
                "kind": "text",
                "text": "A workflow is YAML stored in `.github/workflows/`. The `on` section defines events such as `push` and `pull_request`. A workflow has jobs; each job runs on a runner and contains steps that run shell commands or reusable actions from GitHub Marketplace."
              },
              {
                "kind": "form",
                "id": "workflow-form",
                "title": "Edit new file",
                "fields": [
                  {
                    "id": "path",
                    "label": "File path",
                    "control": "text",
                    "required": true,
                    "defaultValue": ".github/workflows/node.js.yml",
                    "readOnly": true
                  },
                  {
                    "id": "content",
                    "label": "node.js.yml",
                    "control": "code",
                    "language": "yaml",
                    "required": true,
                    "defaultValue": "name: Node.js CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n    branches: [main]\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    strategy:\n      matrix:\n        node-version: [20.x, 22.x]\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node-version }}\n          cache: npm\n      - run: npm ci\n      - run: npm test\n"
                  },
                  {
                    "id": "message",
                    "label": "Commit message",
                    "control": "text",
                    "required": true,
                    "defaultValue": "Create Node.js CI workflow"
                  }
                ],
                "submit": {
                  "label": "Commit changes...",
                  "checks": [
                    {
                      "rule": {
                        "type": "matches",
                        "path": "$form.content",
                        "pattern": "push:"
                      },
                      "message": "The workflow should run on push."
                    },
                    {
                      "rule": {
                        "type": "matches",
                        "path": "$form.content",
                        "pattern": "pull_request:"
                      },
                      "message": "The workflow should run on pull_request."
                    },
                    {
                      "rule": {
                        "type": "matches",
                        "path": "$form.content",
                        "pattern": "runs-on:\\s*ubuntu-latest"
                      },
                      "message": "Use ubuntu-latest."
                    },
                    {
                      "rule": {
                        "type": "matches",
                        "path": "$form.content",
                        "pattern": "actions/setup-node@v4"
                      },
                      "message": "Use setup-node."
                    },
                    {
                      "rule": {
                        "type": "matches",
                        "path": "$form.content",
                        "pattern": "npm ci"
                      },
                      "message": "Use npm ci."
                    },
                    {
                      "rule": {
                        "type": "matches",
                        "path": "$form.content",
                        "pattern": "npm test"
                      },
                      "message": "Run npm test."
                    }
                  ],
                  "actions": [
                    {
                      "type": "set",
                      "path": "workflowFile.path",
                      "value": "{{$form.path}}"
                    },
                    {
                      "type": "set",
                      "path": "workflowFile.content",
                      "value": "{{$form.content}}"
                    },
                    {
                      "type": "update",
                      "path": "files",
                      "where": {
                        "path": ".github/workflows/node.js.yml"
                      },
                      "set": {
                        "status": "Committed"
                      }
                    },
                    {
                      "type": "append",
                      "path": "workflowRuns",
                      "value": {
                        "id": "101",
                        "name": "Node.js CI",
                        "status": "completed",
                        "conclusion": "failure",
                        "commit": "a1b2c3d",
                        "failingLeg": "Node 22.x",
                        "logs": "Run npm test\nFAIL tests/sku.test.ts > normalizeSku > normalizes lowercase input\nExpected: SKU-123\nReceived: sku-123\nError: Process completed with exit code 1.",
                        "fixed": false
                      }
                    },
