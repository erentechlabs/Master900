on"}},{"id":"ideas","label":"Ideas","icon":"Lightbulb","action":{"type":"message","tone":"info","text":"Use **Q&A** for this question."}}]}]},{"id":"new-discussion","title":"New discussion","url":"/contoso-oss/awesome-lab-tools/discussions/new?category=q-a","components":[{"kind":"form","id":"discussion-form","title":"Q&A","fields":[{"id":"title","label":"Discussion title","control":"text","required":true,"defaultValue":"Should CLI-only tools have a separate section?"},{"id":"body","label":"Write","control":"textarea","required":true,"defaultValue":"I checked existing issues and did not find this question. Should CLI-only lab tools be grouped separately from browser-based tools?"}],"submit":{"label":"Start discussion","actions":[{"type":"set","path":"community.discussionPosted","value":true},{"type":"append","path":"upstream.discussions","value":{"category":"Q&A","title":"{{$form.title}}","answered":false}},{"type":"navigate","page":"discussions"},{"type":"notify","title":"Discussion started"}]}}]},{"id":"pulls-fork","title":"Pull requests","url":"/contoso-oss/awesome-lab-tools/pulls","components":[{"kind":"table","id":"fork-pr-list","source":"upstream.pullRequests","rowKey":"number","columns":[{"key":"number","label":"#"},{"key":"title","label":"Title","format":"link"},{"key":"headRepository","label":"Head repository","format":"code"},{"key":"head","label":"Compare","format":"code"},{"key":"state","label":"State","format":"badge"}]}]}],"initialState":{"community":{"starred":false,"watch":"","prOpened":false,"discussionPosted":false},"fork":{"exists":false,"fullName":"","currentBranch":"","branches":[],"files":[],"committed":false},"upstream":{"files":[{"path":"README.md","description":"Project overview","content":"# Awesome Lab Tools\n\nA curated list of tools for building hands-on training labs.\n\n## Browser tools\n- Markdown preview helper\n- Lab screenshot checklist\n"},{"path":"CONTRIBUTING.md","description":"How to contribute","content":"# Contributing\n\nBefore opening a pull request, search existing issues and discussions. For questions, use Discussions with the Q&A category. Fork the repository, create a branch in your fork, and open a pull request to upstream.\n"},{"path":"CODE_OF_CONDUCT.md","description":"Community standards","content":"# Code of Conduct\n\nBe respectful, inclusive, and constructive.\n"},{"path":"LICENSE","description":"MIT License","content":"MIT License\n"}],"issues":[{"number":"101","title":"Add screenshots for browser extension tools","labels":["documentation"],"state":"open"},{"number":"98","title":"Clarify Windows terminal examples","labels":["good first issue"],"state":"closed"}],"discussions":[{"category":"Announcements","title":"Maintainer roadmap for lab utilities","answered":false},{"category":"Q&A","title":"Can I submit tools used only inside a classroom?","answered":true}],"pullRequests":[]}}},"steps":[{"key":"read","title":"Read community files","instruction":"Open **CONTRIBUTING.md** and **CODE_OF_CONDUCT.md** from the file list.","explanation":"Community files explain how to contribute and behave respectfully.","targetId":"oss-file-list","rules":[{"key":"viewed-file","description":"A community file was opened","rule":{"type":"visited","page":"oss-file-view"}},{"key":"files-exist","description":"Community files exist","rule":{"type":"allOf","rules":[{"type":"arrayContains","path":"upstream.files","match":{"path":"CONTRIBUTING.md"}},{"type":"arrayContains","path":"upstream.files","match":{"path":"CODE_OF_CONDUCT.md"}}]}}]},{"key":"issues","title":"Search issues first","instruction":"Open **Issues** and review the existing issue list. Do not submit a question as an issue.","explanation":"Searching first avoids duplicate reports; questions belong in Discussions.","targetId":"issue-list","rules":[{"key":"issues-visited","description":"Issues visited","rule":{"type":"visited","page":"issues"}}]},{"key":"star-watch","title":"Star and watch releases","instruction":"Select **Star**. Select **Watch**, choose **Custom**, select **Releases**, and select **Apply**.","explanation":"Stars save repositories. Custom watch settings reduce noisy notifications.","targetId":"star-button","rules":[{"key":"starred","description":"Repository starred","rule":{"type":"equals","path":"community.starred","value":true}},{"key":"watch","description":"Watching releases","rule":{"type":"equals","path":"community.watch","value":"Custom: Releases"}}]},{"key":"fork-edit","title":"Fork, branch, edit and commit","instruction":"Select **Fork**, select **Copy the main branch only**, and select **Create fork**. In your fork, create **docs/add-cli-tools**, open **README.md**, select **Edit file**, add the CLI helper line, and select **Commit changes...**.","explanation":"Forks let you contribute without direct upstream write permission; branches isolate work inside your fork.","targetId":"fork-button","rules":[{"key":"fork","description":"Fork created","rule":{"type":"equals","path":"fork.fullName","value":"alex-contoso/awesome-lab-tools"}},{"key":"commit","description":"Branch and commit exist","rule":{"type":"allOf","rules":[{"type":"includes","path":"fork.branches","value":"docs/add-cli-tools"},{"type":"truthy","path":"fork.committed"}]}}]},{"key":"pr","title":"Open upstream pull request","instruction":"Select **Contribute** > **Open pull request**. Confirm **base repository** is **contoso-oss/awesome-lab-tools**, **base** is **main**, **head repository** is **alex-contoso/awesome-lab-tools**, **compare** is **docs/add-cli-tools**, and select **Create Pull Request**.","explanation":"A fork pull request compares your fork branch with the upstream base branch.","targetId":"contribute-button","rules":[{"key":"pr-open","description":"Fork PR open","rule":{"type":"arrayContains","path":"upstream.pullRequests","match":{"baseRepository":"contoso-oss/awesome-lab-tools","base":"main","headRepository":"alex-contoso/awesome-lab-tools","head":"docs/add-cli-tools","state":"open"}}}]},{"key":"discussion","title":"Ask in Discussions Q&A","instruction":"Open **Discussions**, select **New discussion**, choose **Q&A** with **Get started**, enter **Discussion title** and **Write**, then select **Start discussion**.","explanation":"Discussions are for open-ended questions; issues track bugs and scoped work.","targetId":"new-discussion-button","rules":[{"key":"discussion-posted","description":"Q&A posted","rule":{"type":"allOf","rules":[{"type":"equals","path":"community.discussionPosted","value":true},{"type":"arrayContains","path":"upstream.discussions","match":{"category":"Q&A"}}]}}]}],"finalRules":[{"key":"final-pr","description":"PR from fork to upstream exists","rule":{"type":"arrayContains","path":"upstream.pullRequests","match":{"baseRepository":"contoso-oss/awesome-lab-tools","base":"main","headRepository":"alex-contoso/awesome-lab-tools","head":"docs/add-cli-tools"}}},{"key":"final-discussion","description":"Question posted in Q&A","rule":{"type":"equals","path":"community.discussionPosted","value":true}}],"solution":"1. Open **CONTRIBUTING.md** and **CODE_OF_CONDUCT.md**.\n2. Open **Issues** and review existing issues.\n3. Select **Star**. Select **Watch**, choose **Custom**, select **Releases**, and select **Apply**.\n4. Select **Fork**, select **Copy the main branch only**, and select **Create fork**.\n5. In the fork, create **docs/add-cli-tools**, open **README.md**, select **Edit file**, add the CLI helper line, and select **Commit changes...**.\n6. Select **Contribute** > **Open pull request**, confirm upstream base and fork head, then select **Create Pull Request**.\n7. Open **Discussions**, select **New discussion**, choose **Q&A**, fill **Discussion title** and **Write**, then select **Start discussion**."}]}

