{
  "labs": [
    {
      "slug": "manage-org-teams-permissions",
      "type": "UI_SIMULATION",
      "title": "Manage organization teams and repository permissions",
      "summary": "Set organization base permissions to least privilege, create teams, add members, assign repository roles, require two-factor authentication, and review repository access.",
      "scenario": "Contoso Labs is moving **inventory-api** into a GitHub organization. The security lead wants default access minimized, developers and release managers grouped into teams, repository roles assigned by job need, and two-factor authentication required for everyone. Done means **Collaborators and teams** shows the right teams with no Admin grants.",
      "domainKey": "privacy-security-administration",
      "objectiveCode": "6.1",
      "complexity": "INTERMEDIATE",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Set organization base permissions using least privilege",
        "Create teams and add organization members",
        "Choose repository roles from Read, Triage, Write, Maintain, and Admin based on responsibilities",
        "Require two-factor authentication for organization access"
      ],
      "prerequisites": [
        "Know the difference between organization, repository, team, and member"
      ],
      "sources": [
        {
          "title": "Setting base permissions for an organization",
          "url": "https://docs.github.com/en/organizations/managing-user-access-to-your-organizations-repositories/managing-repository-roles/setting-base-permissions-for-an-organization"
        },
        {
          "title": "Repository roles for an organization",
          "url": "https://docs.github.com/en/organizations/managing-user-access-to-your-organizations-repositories/managing-repository-roles/repository-roles-for-an-organization"
        },
        {
          "title": "Creating an organization team",
          "url": "https://docs.github.com/en/organizations/organizing-members-into-teams/creating-a-team"
        },
        {
          "title": "Requiring two-factor authentication in your organization",
          "url": "https://docs.github.com/en/organizations/keeping-your-organization-secure/managing-two-factor-authentication-for-your-organization/requiring-two-factor-authentication-in-your-organization"
        }
      ],
