              "role": "Member",
              "twoFactor": "Enabled"
            }
          ],
          "teams": [],
          "repositoryAccess": []
        }
      },
      "steps": [
        {
          "key": "base",
          "title": "Set base permissions to least privilege",
          "instruction": "Open **Settings** > **Member privileges**. Set **Base permissions** to **No permission** and select **Save**.",
          "hint": "Base permissions apply broadly, so start with no default repository access and grant access through teams.",
          "explanation": "Least privilege means users get only the access they need; base permissions should not silently grant Write or Admin across repositories.",
          "targetId": "settings-sections",
          "rules": [
            {
              "key": "base-none",
              "description": "Base permissions are No permission",
              "rule": {
                "type": "equals",
                "path": "organization.basePermission",
                "value": "No permission"
              },
              "failureFeedback": "Set Base permissions to No permission."
            }
          ]
        },
        {
          "key": "teams",
          "title": "Create the organization teams",
          "instruction": "Open **Teams**. Use **Create new team** to create **web-developers** and **release-managers** with **Visible** team visibility.",
          "hint": "Create both teams before adding members or repositories.",
          "explanation": "Teams make permission reviews easier because access follows the group instead of individual users.",
          "targetId": "new-team-form",
          "rules": [
            {
              "key": "teams-exist",
              "description": "Both teams exist",
              "rule": {
                "type": "allOf",
                "rules": [
                  {
                    "type": "arrayContains",
                    "path": "teams",
                    "match": {
                      "slug": "web-developers"
                    }
                  },
                  {
                    "type": "arrayContains",
                    "path": "teams",
                    "match": {
                      "slug": "release-managers"
                    }
                  }
                ]
              },
              "failureFeedback": "Create both required teams."
            }
          ]
        },
        {
          "key": "members",
          "title": "Add the right members",
          "instruction": "In **Add members to teams**, add **priya-contoso** and **riley-contoso** to **web-developers**, and **maya-contoso** to **release-managers**.",
          "hint": "Keep Sam unassigned for this scenario.",
          "explanation": "Membership answers who belongs to a responsibility group; repository roles answer what that group can do in a specific repository.",
          "targetId": "team-members-form",
          "rules": [
            {
              "key": "members-added",
              "description": "Team memberships are correct",
              "rule": {
                "type": "allOf",
                "rules": [
                  {
                    "type": "arrayContains",
                    "path": "teams",
                    "match": {
                      "slug": "web-developers",
                      "members": [
                        "priya-contoso",
                        "riley-contoso"
                      ]
                    }
                  },
                  {
                    "type": "arrayContains",
                    "path": "teams",
                    "match": {
                      "slug": "release-managers",
                      "members": [
                        "maya-contoso"
                      ]
                    }
                  }
                ]
              },
              "failureFeedback": "Add Priya and Riley to web-developers, and Maya to release-managers."
            }
          ]
        },
        {
          "key": "repo-roles",
          "title": "Grant repository roles by responsibility",
          "instruction": "In **Add repository access**, grant **web-developers** **Write** on **contoso-labs/inventory-api** and **release-managers** **Maintain**. Do not use **Admin**.",
          "hint": "Write is enough to push code. Maintain can manage many non-destructive repository settings. Admin is too broad for this scenario.",
          "explanation": "GitHub repository roles move from Read to Admin. Choose the smallest role that supports the required task.",
          "targetId": "repo-role-form",
          "rules": [
            {
              "key": "roles",
              "description": "Repository access uses least privilege",
              "rule": {
                "type": "allOf",
                "rules": [
                  {
                    "type": "arrayContains",
                    "path": "repositoryAccess",
                    "match": {
                      "team": "web-developers",
                      "role": "Write"
                    }
                  },
                  {
                    "type": "arrayContains",
                    "path": "repositoryAccess",
                    "match": {
                      "team": "release-managers",
                      "role": "Maintain"
                    }
                  },
                  {
                    "type": "not",
                    "rule": {
                      "type": "arrayContains",
                      "path": "repositoryAccess",
                      "match": {
                        "role": "Admin"
                      }
                    }
                  }
                ]
              },
              "failureFeedback": "Grant Write to web-developers and Maintain to release-managers; do not grant Admin."
            }
          ]
        },
        {
          "key": "two-factor",
          "title": "Require two-factor authentication",
          "instruction": "Open **Settings** > **Security**, turn on **Require two-factor authentication for everyone in your organization**, confirm the impact, and select **Save**.",
          "hint": "The setting protects organization resources even if a member password is compromised.",
          "explanation": "Requiring 2FA strengthens account security for members and outside collaborators who can access organization resources.",
          "targetId": "two-factor-form",
          "rules": [
            {
              "key": "2fa",
              "description": "Organization 2FA is required",
              "rule": {
                "type": "equals",
                "path": "organization.twoFactorRequired",
                "value": true
              },
              "failureFeedback": "Enable and save the organization 2FA requirement."
            }
          ]
        },
        {
          "key": "review",
          "title": "Review Collaborators and teams",
          "instruction": "Open **Repository access** and verify **Collaborators and teams** shows **web-developers** with **Write**, **release-managers** with **Maintain**, base permissions **No permission**, and 2FA required.",
          "hint": "The review table is the final check for over-privileged access.",
          "explanation": "Regular access reviews catch accidental Admin grants and confirm permissions still match responsibilities.",
          "targetId": "repo-access-table",
          "rules": [
            {
