      "difficulty": "MEDIUM",
      "stem": "Order the broad lifecycle of a workflow run.",
      "explanation": "A configured event creates the workflow run, GitHub schedules the job on a runner, and the runner executes each step in order.",
      "ordering": {
        "items": [
          {
            "id": "s1",
            "text": "Event occurs"
          },
          {
            "id": "s2",
            "text": "Workflow starts"
          },
          {
            "id": "s3",
            "text": "Job runs on a runner"
          },
          {
            "id": "s4",
            "text": "Steps execute"
          }
        ],
        "correctOrder": [
          "s1",
          "s2",
          "s3",
          "s4"
        ],
        "explanations": {
          "s1": "The run begins only after an event such as a push, pull request, or manual dispatch matches the workflow trigger.",
          "s2": "GitHub then creates a workflow run from the YAML definition.",
          "s3": "Each job is assigned to a runner that provides the execution environment.",
          "s4": "The job completes its commands or reusable actions as ordered steps."
        }
      },
      "sources": [
