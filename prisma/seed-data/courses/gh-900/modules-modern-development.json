                "title": "Read the YAML",
                "instructions": "Decide before checking the answer.",
                "items": [
                  {
                    "prompt": "`on: pull_request`",
                    "answer": "Event trigger."
                  },
                  {
                    "prompt": "`runs-on: ubuntu-latest`",
                    "answer": "Runner selection."
                  }
                ]
              }
            }
          ],
