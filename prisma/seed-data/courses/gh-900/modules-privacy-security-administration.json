      "lessons": [
        {
          "slug": "secure-accounts-and-access",
          "title": "Secure accounts, organizations, and access",
          "objectiveCode": "6.1",
          "estimatedMinutes": 12,
          "summary": "Understand 2FA, repository roles, organizations, teams, enterprise accounts, and high-level access administration.",
          "learningObjectives": [
            "Explain 2FA and passkeys",
            "Identify roles and permissions",
            "Describe organizations and teams",
            "Recognize enterprise managed identity scenarios"
          ],
          "explanation": "Security starts before code is opened. If an attacker can sign in as a trusted user, other controls are weaker. GitHub account protection includes **two-factor authentication (2FA)** and passkeys. After sign-in, authorization is controlled by **roles** and **permissions**. Repository roles determine what a person or team can do in a repository; organization roles control broader administration.\n\nAn **organization** groups repositories, people, teams, and settings. **Teams** reflect working groups and can receive repository access or review requests, which is easier to manage than one-person-at-a-time grants. At the enterprise level, GitHub supports broader administration. **Enterprise Managed Users** are a high-level option where account lifecycle and authentication are managed through an identity provider.\n\nFor GH-900, stay practical: protect accounts, grant least privilege, use teams for group access, and know that enterprise accounts centralize higher-level management.",
          "terminology": [
            {
              "term": "Two-factor authentication",
              "definition": "Sign-in method requiring another factor besides a password."
            },
            {
              "term": "Role",
              "definition": "Set of permissions assigned to a user or team."
            },
            {
              "term": "Organization",
              "definition": "Shared GitHub account for repositories, members, teams, and settings."
            },
            {
              "term": "Team",
              "definition": "Group of organization members used for access and notifications."
            },
            {
              "term": "Enterprise Managed Users",
              "definition": "Enterprise model where accounts are managed through an identity provider."
            }
          ],
          "businessScenario": "Woodgrove Bank creates a GitHub organization, requires strong sign-in, and grants access through teams.",
          "technicalExample": "Priya creates a `docs-maintainers` team with Write access. A contractor who only needs to view source gets Read access. Owners keep Admin access limited.",
          "misconception": {
            "myth": "Private repositories are secure automatically.",
            "reality": "Private visibility helps, but account security, roles, teams, rules, and reviews still matter."
          },
          "examTakeaway": "2FA/passkey = account security; role = permission level; team = group access; EMU = IdP-managed enterprise accounts.",
          "recap": "Understand 2FA, repository roles, organizations, teams, enterprise accounts, and high-level access administration.",
          "simplerExplanation": "Account and access security is like a museum: 2FA checks visitors at the entrance, repository roles decide which rooms they can enter, teams issue group badges, and enterprise identity manages the master guest list.",
          "anotherExample": "A nonprofit can place volunteers in a `website-reviewers` team with Write access, keep finance staff out of code repositories, and reserve organization owner permissions for two trusted administrators.",
          "extraBlocks": [
