      "difficulty": "MEDIUM",
      "scenario": "A final notification has a blank requester email.",
      "stem": "For each statement about troubleshooting a blank requester email in a cloud-flow notification, select **Yes** if the statement is appropriate. Otherwise, select **No**.",
      "explanation": "Run history and dynamic content checks are appropriate first steps for a single failed cloud-flow run; process mining is not.",
      "caseStudy": {
        "statements": [
          {
            "id": "s1",
            "text": "Inspect run history for the email action input.",
            "answer": true,
            "explanation": "Run history shows inputs and outputs."
          },
          {
            "id": "s2",
            "text": "Check that requester email dynamic content came from the correct step.",
            "answer": true,
            "explanation": "Wrong dynamic content can be blank."
          },
          {
            "id": "s3",
            "text": "Use process mining before checking the failed run.",
            "answer": false,
            "explanation": "Process mining is not a single-run debugger."
          }
        ]
      },
      "sources": [
