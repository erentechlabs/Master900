          "key": "list-rows",
          "title": "List overdue Dataverse rows",
          "instruction": "Select **+ Add an action**, choose **Microsoft Dataverse** action **List rows**, table **Task Follow-ups**, and set **Filter rows** to **status eq 'Overdue'**.",
          "hint": "The Filter rows field expects the OData expression only; do not type `$filter=`.",
          "explanation": "List rows retrieves a set of Dataverse records, and an OData filter narrows the data before later flow actions run.",
          "targetId": "add-dataverse",
          "rules": [
            {
              "key": "dataverse-configured",
              "description": "Dataverse List rows uses the overdue filter",
              "rule": {
                "type": "arrayContains",
                "path": "flows",
                "match": {
                  "name": "Daily overdue follow-up summary",
                  "dataverseAction": true,
                  "dataverseTable": "Task Follow-ups",
                  "filterRows": "status eq 'Overdue'"
                }
              },
              "failureFeedback": "Configure Dataverse List rows with Task Follow-ups and status eq 'Overdue'."
            }
          ]
        },
        {
          "key": "condition",
          "title": "Add a condition for returned rows",
          "instruction": "Select **Add condition** and use a **length(...) is greater than 0** expression. Set **If yes** to **Send summary** and **If no** to **Do nothing**.",
          "hint": "The summary belongs in the If yes branch so users receive a message only when rows exist.",
          "explanation": "A condition prevents unnecessary notifications and is a common flow pattern after querying a data source.",
          "targetId": "add-condition",
          "rules": [
            {
              "key": "condition-configured",
              "description": "The condition sends only when rows exist",
              "rule": {
                "type": "arrayContains",
                "path": "flows",
                "match": {
                  "name": "Daily overdue follow-up summary",
                  "conditionConfigured": true,
                  "notifyOnlyWhenOverdue": true
                }
              },
              "failureFeedback": "Configure the condition so the no-overdue branch does nothing."
            }
          ]
        },
        {
          "key": "summary-action",
          "title": "Send the summary from the If yes branch",
          "instruction": "Select **Add summary action**, choose **Microsoft Teams** or **Office 365 Outlook**, and add a message that summarizes overdue rows for the operations team.",
          "hint": "Teams and Outlook are common notification actions; place this action only after the condition's yes result.",
          "explanation": "Flow actions can use outputs from previous steps, such as the number of Dataverse rows returned by List rows.",
          "targetId": "add-summary",
          "rules": [
            {
              "key": "summary-configured",
              "description": "A summary action is configured",
              "rule": {
                "type": "arrayContains",
                "path": "flows",
                "match": {
                  "name": "Daily overdue follow-up summary",
                  "summaryAction": true
                }
              },
              "failureFeedback": "Add a Teams or Outlook summary action."
            }
          ]
        },
