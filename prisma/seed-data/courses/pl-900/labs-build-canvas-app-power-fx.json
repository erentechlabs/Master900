          {
            "id": "data-pane",
            "title": "Data",
            "subtitle": "Power Apps Studio",
            "icon": "Database",
            "url": "/environments/contoso-default/apps/service-requests-mobile/studio/data",
            "requires": "app",
            "navItem": "apps",
            "breadcrumb": [
              "Apps",
              "Service Requests Mobile"
            ],
            "components": [
              {
                "kind": "form",
                "id": "connect-data-form",
                "title": "Add data",
                "description": "Add a Dataverse table as a data source.",
                "fields": [
                  {
                    "id": "connector",
                    "label": "Connector",
                    "control": "select",
                    "required": true,
                    "options": [
                      {
                        "value": "Microsoft Dataverse",
                        "label": "Microsoft Dataverse"
                      },
                      {
                        "value": "SharePoint",
                        "label": "SharePoint"
                      },
                      {
                        "value": "Excel Online",
                        "label": "Excel Online"
                      }
                    ]
                  },
                  {
                    "id": "table",
                    "label": "Table",
                    "control": "select",
                    "required": true,
                    "optionsFrom": {
                      "path": "dataverseTables",
                      "value": "displayName",
                      "label": "displayName"
                    }
                  }
                ],
                "submit": {
                  "label": "Connect",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.connector",
                        "value": "Microsoft Dataverse"
                      },
                      "message": "Use Microsoft Dataverse because the request data is stored in Dataverse."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.table",
                        "value": "Service Requests"
                      },
                      "message": "Connect the Service Requests table."
                    }
                  ],
                  "actions": [
                    {
                      "type": "update",
                      "path": "canvasApps",
                      "where": {
                        "name": "Service Requests Mobile"
                      },
                      "set": {
                        "dataSource": "Service Requests",
                        "connected": true
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Data source added",
                      "message": "Service Requests was added."
                    },
                    {
                      "type": "navigate",
                      "page": "studio"
                    }
                  ]
                }
              }
            ]
          },
          {
            "id": "formulas",
            "title": "Tree view",
            "subtitle": "BrowseScreen",
            "icon": "ListTodo",
            "url": "/environments/contoso-default/apps/service-requests-mobile/studio/tree",
            "requires": "app",
            "navItem": "apps",
            "breadcrumb": [
              "Apps",
              "Service Requests Mobile"
            ],
            "components": [
              {
                "kind": "form",
                "id": "gallery-formula-form",
                "title": "Configure galRequests",
                "description": "Set the Items property to return filtered and sorted Dataverse rows.",
                "fields": [
                  {
                    "id": "items",
                    "label": "galRequests.Items",
                    "control": "code",
                    "required": true,
                    "language": "powerfx",
                    "defaultValue": "SortByColumns(Filter('Service Requests', IsBlank(txtSearch.Text) || StartsWith(Title, txtSearch.Text) || StartsWith(Status, txtSearch.Text)), \"DueDate\", Ascending)",
                    "pattern": "^(?!\\s*=)(?=.*(Filter|Search)\\s*\\()(?=.*SortByColumns\\s*\\()(?=.*'Service Requests')(?=.*txtSearch\\.Text).{40,260}$",
                    "patternMessage": "Use Filter or Search over 'Service Requests', reference txtSearch.Text, wrap it in SortByColumns, and do not start with =."
                  }
                ],
                "submit": {
                  "label": "Apply Items formula",
                  "checks": [
                    {
                      "rule": {
                        "type": "arrayContains",
                        "path": "canvasApps",
                        "match": {
                          "name": "Service Requests Mobile",
                          "connected": true
                        }
                      },
                      "message": "Connect the Service Requests Dataverse table first."
                    }
                  ],
                  "actions": [
                    {
                      "type": "update",
                      "path": "canvasApps",
                      "where": {
                        "name": "Service Requests Mobile"
                      },
                      "set": {
                        "galleryItems": "{{$form.items}}",
                        "galleryConfigured": true
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Formula updated",
                      "message": "galRequests.Items now filters and sorts rows."
                    }
                  ]
                }
              },
              {
                "kind": "form",
                "id": "count-formula-form",
                "title": "Configure lblCount",
                "description": "Set Text to count visible gallery rows.",
                "fields": [
                  {
                    "id": "text",
                    "label": "lblCount.Text",
                    "control": "code",
                    "required": true,
                    "language": "powerfx",
                    "defaultValue": "CountRows(galRequests.AllItems) & \" requests\"",
                    "pattern": "^(?!\\s*=)\\s*(\\\".*\\\"\\s*&\\s*)?CountRows\\s*\\(\\s*galRequests\\.AllItems\\s*\\)(\\s*&\\s*\\\".*\\\")?\\s*$",
                    "patternMessage": "Use CountRows(galRequests.AllItems), optionally joined to text with &. Do not count the whole table or start with =."
                  }
                ],
                "submit": {
                  "label": "Apply Text formula",
                  "actions": [
                    {
                      "type": "update",
                      "path": "canvasApps",
                      "where": {
                        "name": "Service Requests Mobile"
                      },
                      "set": {
                        "countText": "{{$form.text}}",
                        "countConfigured": true
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Count label updated",
                      "message": "lblCount.Text shows the number of gallery items."
                    }
                  ]
                }
              },
              {
                "kind": "form",
                "id": "edit-form-formula-form",
                "title": "Configure frmRequest and btnSave",
                "description": "Bind the edit form to the selected gallery row and save with a notification.",
                "fields": [
                  {
                    "id": "dataSource",
                    "label": "frmRequest.DataSource",
                    "control": "code",
                    "required": true,
                    "language": "powerfx",
                    "defaultValue": "'Service Requests'",
                    "pattern": "^\\s*'Service Requests'\\s*$",
                    "patternMessage": "Set DataSource to 'Service Requests'."
                  },
                  {
                    "id": "item",
                    "label": "frmRequest.Item",
                    "control": "code",
                    "required": true,
                    "language": "powerfx",
                    "defaultValue": "galRequests.Selected",
                    "pattern": "^\\s*galRequests\\.Selected\\s*$",
                    "patternMessage": "Set Item to galRequests.Selected."
                  },
                  {
                    "id": "onSelect",
                    "label": "btnSave.OnSelect",
                    "control": "code",
                    "required": true,
                    "language": "powerfx",
                    "defaultValue": "SubmitForm(frmRequest); Notify(\"Request saved\", NotificationType.Success)",
                    "pattern": "^(?!\\s*=)(?=.*SubmitForm\\s*\\(\\s*frmRequest\\s*\\))(?=.*Notify\\s*\\().{20,220}$",
                    "patternMessage": "Use SubmitForm(frmRequest) and a success Notify. Do not start with =."
                  }
                ],
                "submit": {
                  "label": "Apply form formulas",
                  "actions": [
                    {
                      "type": "update",
                      "path": "canvasApps",
                      "where": {
                        "name": "Service Requests Mobile"
                      },
                      "set": {
                        "formDataSource": "{{$form.dataSource}}",
                        "formItem": "{{$form.item}}",
                        "saveOnSelect": "{{$form.onSelect}}",
                        "formConfigured": true
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Form configured",
                      "message": "frmRequest and btnSave are ready for Preview."
                    },
                    {
                      "type": "navigate",
                      "page": "studio"
                    }
                  ]
                }
              }
            ]
          },
