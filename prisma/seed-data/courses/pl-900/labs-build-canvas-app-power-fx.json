              {
                "id": "studio-save",
                "label": "Save",
                "icon": "Save",
                "action": {
                  "type": "if",
                  "when": {
                    "type": "arrayContains",
                    "path": "canvasApps",
                    "match": {
                      "name": "Service Requests Mobile",
                      "galleryConfigured": true,
                      "countConfigured": true,
                      "formConfigured": true,
                      "previewTested": true
                    }
                  },
                  "then": [
                    {
                      "type": "update",
                      "path": "canvasApps",
                      "where": {
                        "name": "Service Requests Mobile"
                      },
                      "set": {
                        "saved": true
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Saved",
                      "message": "Service Requests Mobile was saved."
                    }
                  ],
                  "else": [
                    {
                      "type": "fail",
                      "message": "Connect data, configure formulas, and test in Preview before saving."
                    }
                  ]
                }
              },
              {
                "id": "studio-publish",
                "label": "Publish",
                "icon": "Upload",
                "action": {
                  "type": "if",
                  "when": {
                    "type": "arrayContains",
                    "path": "canvasApps",
                    "match": {
                      "name": "Service Requests Mobile",
                      "saved": true
                    }
                  },
                  "then": [
                    {
                      "type": "update",
                      "path": "canvasApps",
                      "where": {
                        "name": "Service Requests Mobile"
                      },
                      "set": {
                        "published": true
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Published",
                      "message": "The canvas app is published."
                    }
