        },
        {
          "key": "gallery-powerfx",
          "title": "Configure gallery search and sorting",
          "instruction": "Select **Tree view** and set **galRequests.Items** to a formula that uses **Filter** or **Search** with **txtSearch.Text** and wraps the result in **SortByColumns** for **DueDate**.",
          "hint": "A valid example starts with `SortByColumns(Filter('Service Requests', ... txtSearch.Text ...), \"DueDate\", Ascending)`.",
          "explanation": "Filter and Search return a table for the gallery; SortByColumns controls order without changing Dataverse rows.",
          "targetId": "gallery-formula-form",
          "rules": [
            {
              "key": "gallery-configured",
              "description": "Gallery Items uses a validated formula",
              "rule": {
                "type": "arrayContains",
                "path": "canvasApps",
                "match": {
                  "name": "Service Requests Mobile",
                  "galleryConfigured": true
                }
              },
              "failureFeedback": "Set galRequests.Items with a real Filter/Search + SortByColumns formula."
            }
          ]
        },
        {
          "key": "count-and-form",
          "title": "Add count and edit-form behavior",
          "instruction": "Set **lblCount.Text** to **CountRows(galRequests.AllItems) & \" requests\"**. Configure **frmRequest.DataSource** as **'Service Requests'**, **frmRequest.Item** as **galRequests.Selected**, and **btnSave.OnSelect** with **SubmitForm(frmRequest)** plus **Notify**.",
          "hint": "The count should use the gallery rows, not the whole table.",
          "explanation": "CountRows summarizes visible records, while SubmitForm writes form changes and Notify gives user feedback.",
