{
  "labs": [
    {
      "slug": "build-canvas-app-power-fx",
      "type": "UI_SIMULATION",
      "title": "Improve a canvas app with Power Fx",
      "summary": "Use Power Apps Studio to connect a canvas app to Dataverse, configure Power Fx formulas for search, counts, and save behavior, test in Preview, then save and publish.",
      "scenario": "Contoso service coordinators use a draft canvas app to triage service requests, but it still contains placeholder formulas. In the simulated Power Apps Studio, connect it to the Dataverse Service Requests table, configure a searchable sorted gallery, show a count, add edit-form save behavior, and publish after testing. Done means the app uses realistic Power Fx and a Preview save succeeds.",
      "domainKey": "power-apps",
      "objectiveCode": "3.2",
      "complexity": "INTERMEDIATE",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Connect a canvas app to a Dataverse table",
        "Use Filter or Search, SortByColumns, and CountRows in Power Fx",
        "Configure an edit form with SubmitForm and Notify",
        "Test in Preview before saving and publishing"
      ],
      "prerequisites": [
        "Know that canvas apps use controls and Power Fx formulas"
      ],
      "sources": [
        {
          "title": "Get started with formulas in canvas apps",
          "url": "https://learn.microsoft.com/en-us/power-apps/maker/canvas-apps/working-with-formulas"
        },
        {
          "title": "Filter, Search, and LookUp functions",
          "url": "https://learn.microsoft.com/en-us/power-platform/power-fx/reference/function-filter-lookup"
        },
        {
          "title": "Show, edit, or add a record in a canvas app",
          "url": "https://learn.microsoft.com/en-us/power-apps/maker/canvas-apps/add-form"
        }
      ],
      "config": {
