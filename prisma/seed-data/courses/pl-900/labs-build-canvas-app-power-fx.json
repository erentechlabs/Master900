            {
              "key": "form-configured",
              "description": "Edit form and save button are configured",
              "rule": {
                "type": "arrayContains",
                "path": "canvasApps",
                "match": {
                  "name": "Service Requests Mobile",
                  "formConfigured": true
                }
              },
              "failureFeedback": "Configure frmRequest and btnSave.OnSelect."
