                      }
                    ]
                  },
                  {
                    "id": "notes",
                    "label": "Coordinator notes",
                    "control": "textarea",
                    "defaultValue": "{{$sel.request.notes}}",
                    "minLength": 8
                  }
                ],
                "submit": {
                  "label": "Save",
                  "checks": [
                    {
                      "rule": {
                        "type": "arrayContains",
                        "path": "canvasApps",
                        "match": {
                          "name": "Service Requests Mobile",
                          "galleryConfigured": true,
                          "countConfigured": true,
                          "formConfigured": true
                        }
                      },
                      "message": "Configure the gallery, count label, and edit form before Preview."
                    }
                  ],
                  "actions": [
                    {
                      "type": "update",
                      "path": "serviceRequests",
                      "where": {
                        "title": "{{$sel.request.title}}"
                      },
                      "set": {
                        "status": "{{$form.status}}",
                        "notes": "{{$form.notes}}"
                      }
                    },
                    {
                      "type": "update",
                      "path": "canvasApps",
                      "where": {
                        "name": "Service Requests Mobile"
                      },
                      "set": {
                        "previewTested": true
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Request saved",
                      "message": "SubmitForm saved the selected Dataverse row."
                    },
                    {
                      "type": "navigate",
                      "page": "studio"
                    }
                  ]
                }
              }
            ]
          }
