            "components": [
              {
                "kind": "form",
                "id": "preview-edit-form",
                "title": "Edit request",
                "fields": [
                  {
                    "id": "status",
                    "label": "Status",
                    "control": "select",
                    "required": true,
                    "defaultValue": "{{$sel.request.status}}",
                    "options": [
                      {
                        "value": "New",
