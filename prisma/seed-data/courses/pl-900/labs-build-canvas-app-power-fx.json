          "searchPlaceholder": "Search"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser"
          ]
        },
        "clock": {
          "start": "2026-10-02T08:00:00Z"
        },
