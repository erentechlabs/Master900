              "Discover",
              "Models",
              "Deploy"
            ],
            "components": [
              {
                "kind": "wizard",
                "id": "deploy-wizard",
                "description": "Create a deployment in the Foundry resource attached to proj-support-assistant. The deployment name is used by apps and playgrounds to route requests to this model.",
                "reviewLabel": "Review",
                "tabs": [
                  {
                    "id": "basics",
                    "label": "Basics",
                    "fields": [
                      {
                        "id": "project",
                        "label": "Project",
                        "control": "select",
                        "required": true,
                        "options": [
                          {
                            "value": "proj-support-assistant",
                            "label": "proj-support-assistant"
                          }
                        ],
                        "defaultValue": "proj-support-assistant"
                      },
                      {
                        "id": "model",
                        "label": "Model",
                        "control": "select",
                        "required": true,
                        "optionsFrom": {
                          "path": "models",
                          "value": "name",
                          "label": "name"
                        },
                        "defaultValue": "{{$sel.model.name}}"
                      },
                      {
                        "id": "deploymentName",
                        "label": "Deployment name",
                        "control": "text",
                        "required": true,
                        "pattern": "^[a-z][a-z0-9-]{2,50}$",
                        "patternMessage": "Use lowercase letters, digits, and hyphens; start with a letter.",
                        "unique": {
                          "path": "deployments",
                          "key": "name",
                          "message": "A deployment with this name already exists."
                        }
                      },
                      {
                        "id": "deploymentType",
                        "label": "Deployment type",
                        "control": "select",
                        "required": true,
                        "defaultValue": "Global Standard",
                        "options": [
                          {
                            "value": "Global Standard",
                            "label": "Global Standard"
                          },
                          {
                            "value": "Data Zone Standard",
                            "label": "Data Zone Standard"
                          },
                          {
                            "value": "Provisioned",
                            "label": "Provisioned"
                          }
                        ],
                        "help": "Deployment type determines how requests are served. This simulation uses fictional capacity and does not show prices, quotas, or service limits."
                      }
                    ]
                  },
                  {
                    "id": "capacity",
                    "label": "Capacity",
                    "fields": [
                      {
                        "id": "capacityUnits",
                        "label": "Simulated capacity units",
                        "control": "number",
                        "defaultValue": 20,
                        "min": 1,
                        "max": 100,
                        "help": "Fictional capacity used only by this lab so the form feels realistic."
                      },
                      {
                        "id": "contentFilter",
                        "label": "Content filter",
                        "control": "select",
                        "required": true,
                        "defaultValue": "DefaultV2",
                        "options": [
                          {
                            "value": "DefaultV2",
                            "label": "DefaultV2"
                          },
                          {
                            "value": "None",
                            "label": "None"
                          }
                        ]
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Deploy",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.model",
                        "value": "gpt-4o-mini"
                      },
                      "message": "Choose **gpt-4o-mini** for this chat assistant. Embedding and image models do not support the chat playground task."
                    },
                    {
                      "rule": {
                        "type": "notEquals",
                        "path": "$form.contentFilter",
                        "value": "None"
                      },
                      "message": "Keep a content filter attached to the deployment for safer testing."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.deploymentType",
                        "value": "Global Standard"
                      },
                      "message": "Use **Global Standard** in this lab; it is the supported simulated deployment type for this model."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "deployments",
                      "unique": "name",
                      "value": {
                        "name": "{{$form.deploymentName}}",
                        "project": "{{$form.project}}",
                        "model": "{{$form.model}}",
                        "task": "Chat completion",
                        "deploymentType": "{{$form.deploymentType}}",
                        "capacity": "{{$form.capacityUnits}}",
                        "contentFilter": "{{$form.contentFilter}}",
                        "status": "Succeeded",
                        "createdAt": "{{$now}}"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Deployment succeeded",
                      "message": "Deployment {{$form.deploymentName}} is ready in proj-support-assistant."
                    },
                    {
                      "type": "navigate",
                      "page": "deployment-complete",
                      "select": {
                        "as": "deployment",
                        "path": "deployments",
                        "key": "name",
                        "value": "{{$form.deploymentName}}"
                      }
                    }
                  ]
                }
              }
            ]
