            ],
            "components": [
              {
                "kind": "tiles",
                "id": "playground-tiles",
                "title": "Choose a playground",
                "size": "md",
                "items": [
                  {
                    "id": "model-playground",
                    "label": "Model playground",
                    "icon": "MessageSquare",
                    "description": "Prompt engineering, parameters, tools and code export for a model deployment.",
                    "action": {
                      "type": "navigate",
