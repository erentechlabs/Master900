{
  "labs": [
    {
      "slug": "deploy-model-chat-playground",
      "type": "UI_SIMULATION",
      "title": "Deploy a chat model and test it in the Foundry playground",
      "summary": "Use Microsoft Foundry to choose a chat-capable model, create a deployment, tune the model playground, and test a scoped support assistant prompt.",
      "scenario": "**Contoso Retail** is prototyping a support assistant for order questions in a Microsoft Foundry project named **proj-support-assistant**. In the simulated lab VM, use **Microsoft Foundry** to find a chat model, deploy it as **contoso-support-chat**, then use the **Model playground** to set instructions that keep the assistant polite and limited to Contoso order support. The assistant must refuse other topics and use a lower temperature for consistent support replies. Everything is simulated; no real Foundry resource, subscription, endpoint, quota, or model call is used.",
      "domainKey": "foundry-solutions",
      "moduleSlug": "foundry-generative-apps-agents",
      "objectiveCode": "2.1",
      "complexity": "BASIC",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Use Discover > Models and model filters to choose a model that supports chat or text generation",
        "Explain why embeddings or image-generation models are the wrong deployment choice for a chat assistant",
        "Create a model deployment, configure system instructions and temperature, and test behavior in the Model playground"
      ],
      "prerequisites": [
        "Know what a model deployment and a system message are"
      ],
      "sources": [
        {
          "title": "Study guide for Exam AI-901",
          "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/ai-901",
          "kind": "STUDY_GUIDE"
        },
        {
          "title": "What is Microsoft Foundry?",
          "url": "https://learn.microsoft.com/en-us/azure/foundry/what-is-foundry",
          "kind": "DOCUMENTATION"
        },
        {
          "title": "Deploy Microsoft Foundry Models in the Foundry portal",
          "url": "https://learn.microsoft.com/en-us/azure/foundry/foundry-models/how-to/deploy-foundry-models",
          "kind": "DOCUMENTATION"
        },
        {
          "title": "Microsoft Foundry Playgrounds",
          "url": "https://learn.microsoft.com/en-us/azure/foundry/concepts/concept-playgrounds",
          "kind": "DOCUMENTATION"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Foundry",
          "theme": "foundry",
          "user": "alex@contoso.example",
          "tenant": "Contoso (contoso.example)",
