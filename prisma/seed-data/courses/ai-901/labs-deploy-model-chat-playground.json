                    "label": "Agents playground",
                    "icon": "Bot",
                    "description": "Test agents with tools and knowledge.",
                    "action": {
                      "type": "message",
                      "tone": "info",
                      "text": "Use the Model playground for this lab."
                    }
                  },
                  {
                    "id": "images-playground",
                    "label": "Images playground",
                    "icon": "Image",
                    "description": "Image generation workflows are not part of this lab.",
                    "action": {
                      "type": "message",
                      "tone": "info",
                      "text": "This support assistant needs a chat model, not an image model."
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "model-playground",
            "title": "Model playground",
            "subtitle": "proj-support-assistant",
            "icon": "MessagesSquare",
            "url": "/build/playgrounds/model",
            "navItem": "playgrounds",
            "breadcrumb": [
              "Home",
              "Build",
              "Playgrounds"
            ],
            "components": [
              {
                "kind": "callout",
                "variant": "warning",
                "visibleWhen": {
                  "type": "arrayLength",
                  "path": "deployments",
                  "max": 0
                },
                "text": "Deploy a chat model before testing the playground."
              },
              {
                "kind": "settings",
                "id": "playground-settings",
                "title": "Setup",
                "description": "Configure the selected deployment and assistant behavior. Select **Apply changes** by updating fields here; changes are saved immediately in the simulation.",
                "fields": [
                  {
                    "id": "deployment",
                    "label": "Deployment",
                    "control": "select",
                    "bindTo": "playground.deployment",
                    "optionsFrom": {
                      "path": "deployments",
                      "value": "name",
                      "label": "name"
                    },
                    "help": "Choose the deployment that the playground will call."
                  },
                  {
                    "id": "systemMessage",
                    "label": "System message",
                    "control": "textarea",
                    "bindTo": "playground.systemMessage",
                    "placeholder": "You are a helpful assistant...",
                    "minLength": 20,
                    "help": "Tell the model its role, scope, tone, and refusal behavior."
                  },
                  {
                    "id": "temperature",
                    "label": "Temperature",
                    "control": "select",
                    "bindTo": "playground.temperature",
                    "options": [
                      {
                        "value": "0.2",
                        "label": "0.2 - more consistent"
                      },
                      {
                        "value": "0.7",
                        "label": "0.7 - balanced"
                      },
                      {
                        "value": "1.0",
                        "label": "1.0 - more varied"
                      }
                    ]
                  }
                ]
              },
              {
                "kind": "chat",
                "id": "support-chat",
                "title": "Chat session",
                "placeholder": "Ask a Contoso order question",
                "transcriptPath": "chats.support",
                "responses": [
                  {
                    "id": "order-grounded",
                    "match": "(order|shipping|return|refund|delivery|contoso)",
                    "when": {
                      "type": "allOf",
                      "rules": [
                        {
                          "type": "equals",
                          "path": "playground.deployment",
                          "value": "contoso-support-chat"
                        },
                        {
                          "type": "matches",
                          "path": "playground.systemMessage",
                          "pattern": "Contoso orders"
                        },
                        {
                          "type": "matches",
                          "path": "playground.systemMessage",
                          "pattern": "refuse"
                        },
                        {
                          "type": "equals",
                          "path": "playground.temperature",
                          "value": "0.2"
                        }
                      ]
                    },
                    "reply": "I can help with Contoso order support. For order C-1042, use the Orders workspace and confirm the customer identity before sharing status. I will stay polite and only answer Contoso order questions.",
                    "actions": [
                      {
                        "type": "set",
                        "path": "playground.tested",
                        "value": true
                      }
                    ]
                  },
                  {
                    "id": "refusal",
                    "match": "(weather|poem|joke|recipe|sports)",
                    "when": {
                      "type": "matches",
                      "path": "playground.systemMessage",
                      "pattern": "refuse"
                    },
                    "reply": "I can only help with Contoso order-support questions. Please ask about an order, shipping status, returns, or refunds.",
                    "actions": [
                      {
                        "type": "set",
                        "path": "playground.refusalTested",
                        "value": true
                      }
                    ]
                  },
                  {
                    "id": "unscoped",
                    "match": "(order|shipping|return|refund|delivery|contoso)",
                    "reply": "I can discuss many general topics and may not have Contoso-specific order policy unless you add clearer instructions.",
                    "actions": [
                      {
                        "type": "set",
                        "path": "playground.offTopicSeen",
                        "value": true
                      }
                    ]
                  }
                ],
                "fallback": "I am a general model response in this simulation. Add a precise system message and choose the support deployment to focus my answers."
              },
              {
                "kind": "code",
                "id": "sample-code",
                "title": "Code",
                "language": "json",
