      "steps": [
        {
          "key": "open-vision",
          "title": "Open Azure Vision",
          "instruction": "Open **Tools**, select **Azure Vision**, and then select **Open image analysis playground**.",
          "hint": "The Foundry left navigation has **Tools** under **Build**. Azure Vision is one of the Foundry Tools.",
          "explanation": "Foundry Tools provide ready-to-use AI capabilities. Azure Vision is the tool family for image analysis and OCR scenarios.",
          "targetId": "tools-table",
          "rules": [
            {
              "key": "playground-opened",
              "description": "The Image analysis playground was opened",
              "rule": {
                "type": "visited",
                "page": "image-playground"
              }
            }
          ]
        },
        {
          "key": "analyze-store-image",
          "title": "Analyze a product image",
          "instruction": "In **Analyze image**, choose **tailwind-store-aisle.jpg**, select **Caption**, **Dense captions**, **Tags**, and **Objects**, add a reviewer note, and select **Run analysis**.",
          "hint": "Use captions and tags for searchable descriptions; use objects when the business cares about item locations or counts.",
          "explanation": "Image Analysis can return both broad descriptions and object-level signals. Combining captions, tags, and objects supports search and inventory review without needing OCR.",
          "targetId": "analysis-form",
          "rules": [
            {
              "key": "store-analysis",
              "description": "The store image was analyzed with captions, tags, and objects",
              "rule": {
                "type": "equals",
                "path": "outcomes.storeAnalysis",
                "value": true
              },
              "failureFeedback": "Run analysis on the store aisle image with Caption, Dense captions, Tags, and Objects."
            }
          ]
        },
        {
          "key": "read-label-text",
          "title": "Read text from a label",
          "instruction": "Run **Analyze image** again for **fabrikam-shipping-label.png** with **Read (OCR)**, then review the **Read OCR text result** table.",
          "hint": "Read OCR is the feature that extracts text lines from labels, receipts, screenshots, and similar images.",
          "explanation": "OCR turns text inside an image into machine-readable text. For a shipping label, the useful output is a line-by-line text table, not a scene caption.",
          "targetId": "ocr-results",
          "rules": [
            {
              "key": "ocr-analysis",
              "description": "The shipping label was analyzed with Read OCR",
              "rule": {
                "type": "equals",
                "path": "outcomes.ocrAnalysis",
                "value": true
              }
            }
          ]
        },
        {
          "key": "choose-features",
