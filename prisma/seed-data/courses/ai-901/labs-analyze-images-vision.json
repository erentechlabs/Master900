{
  "labs": [
    {
      "slug": "analyze-images-vision",
      "type": "UI_SIMULATION",
      "title": "Analyze images with Azure Vision in Foundry Tools",
      "summary": "Use Microsoft Foundry to run Image Analysis features, review OCR text from a label, choose the right feature for business requests, and avoid face identification.",
      "scenario": "**Tailwind Traders** is preparing a catalog and operations proof of concept. In the simulated Microsoft Foundry portal, open **Azure Vision** in **Foundry Tools**, use the **Image analysis playground** on sample images, read captions, tags, objects, and OCR text from a shipping label, then choose the correct visual feature for three business requests. Done means the team has two analysis runs, a business-request feature map, and a responsible setting that avoids face identification.",
      "domainKey": "foundry-solutions",
      "moduleSlug": "foundry-vision-and-extraction",
      "objectiveCode": "2.3",
      "complexity": "BASIC",
      "estimatedMinutes": 30,
      "learningObjectives": [
        "Open Azure Vision in Foundry Tools and use the Image analysis playground",
        "Select caption, dense caption, tag, object, and Read OCR features for realistic image scenarios",
        "Interpret OCR text from a receipt or shipping label as structured text results",
        "Choose responsible settings that avoid face identification when it is not required"
      ],
      "prerequisites": [
        "Know that computer vision extracts information from images"
      ],
      "sources": [
        {
          "title": "What is Image Analysis? - Foundry Tools",
          "url": "https://learn.microsoft.com/en-us/azure/ai-services/computer-vision/overview-image-analysis",
          "kind": "DOCUMENTATION"
        },
        {
          "title": "OCR for images - Azure Vision in Foundry Tools",
          "url": "https://learn.microsoft.com/en-us/azure/ai-services/computer-vision/concept-ocr",
          "kind": "DOCUMENTATION"
        },
        {
          "title": "Microsoft Foundry Playgrounds",
          "url": "https://learn.microsoft.com/en-us/azure/foundry/concepts/concept-playgrounds",
          "kind": "DOCUMENTATION"
        },
        {
          "title": "Study guide for Exam AI-901",
          "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/ai-901",
          "kind": "STUDY_GUIDE"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Foundry",
          "theme": "foundry",
          "user": "alex@contoso.example",
          "tenant": "Contoso (contoso.example)",
          "url": "https://ai.azure.com",
          "searchPlaceholder": "Search Foundry"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser"
          ]
        },
        "clock": {
          "start": "2026-10-02T09:00:00Z"
        },
        "startPage": "home",
        "navigation": [
          {
            "page": "home",
            "label": "Home",
            "icon": "Home"
          },
          {
            "page": "tools",
            "label": "Tools",
            "icon": "Wrench",
            "section": "Build"
          },
          {
            "page": "azure-vision",
            "label": "Azure Vision",
            "icon": "Eye",
            "section": "Foundry Tools"
          },
          {
            "page": "image-playground",
            "label": "Image analysis playground",
            "icon": "Image",
            "section": "Foundry Tools"
          },
          {
            "page": "responsible-settings",
            "label": "Responsible AI settings",
            "icon": "ShieldCheck",
            "section": "Manage"
          }
        ],
        "pages": [
          {
            "id": "home",
            "title": "Microsoft Foundry",
            "subtitle": "proj-retail-vision",
            "url": "/build/projects/proj-retail-vision",
            "components": [
              {
                "kind": "tiles",
                "id": "home-tiles",
                "title": "Foundry Tools",
                "size": "md",
                "items": [
                  {
                    "id": "open-tools",
                    "label": "Tools",
                    "description": "Browse ready-to-use AI services.",
                    "icon": "Wrench",
                    "action": {
                      "type": "navigate",
                      "page": "tools"
                    }
                  },
                  {
                    "id": "open-vision",
                    "label": "Azure Vision",
                    "description": "Analyze images with prebuilt vision capabilities.",
                    "icon": "Eye",
                    "action": {
                      "type": "navigate",
                      "page": "azure-vision"
                    }
                  },
                  {
                    "id": "open-settings",
                    "label": "Responsible AI settings",
                    "description": "Confirm allowed visual features.",
                    "icon": "ShieldCheck",
                    "action": {
                      "type": "navigate",
                      "page": "responsible-settings"
                    }
                  }
                ]
              },
              {
                "kind": "callout",
                "variant": "info",
                "title": "Simulation",
                "text": "This lab imitates Microsoft Foundry structure with fictional data. It does not upload images or call an AI service."
              }
            ]
          },
          {
            "id": "tools",
            "title": "Tools",
            "subtitle": "Build",
            "icon": "Wrench",
            "url": "/build/tools",
            "breadcrumb": [
              "Home"
            ],
            "components": [
              {
                "kind": "table",
                "id": "tools-table",
                "title": "Foundry Tools",
                "source": "tools",
                "rowKey": "name",
                "columns": [
                  {
                    "key": "name",
                    "label": "Tool",
                    "format": "link"
                  },
                  {
                    "key": "workload",
                    "label": "Workload"
                  },
                  {
                    "key": "bestFor",
                    "label": "Best for"
                  }
                ],
                "rowAction": {
                  "type": "navigate",
                  "page": "azure-vision",
                  "select": {
                    "as": "tool",
                    "path": "tools",
                    "key": "name",
                    "value": "{{$row.name}}"
                  }
                }
              }
            ]
          },
          {
            "id": "azure-vision",
            "title": "Azure Vision",
            "subtitle": "Foundry Tools",
            "icon": "Eye",
            "url": "/explore/vision",
            "breadcrumb": [
              "Home",
              "Tools"
            ],
            "commands": [
              {
                "id": "open-image-playground",
                "label": "Open image analysis playground",
                "icon": "Play",
                "variant": "primary",
                "action": {
                  "type": "navigate",
                  "page": "image-playground"
                }
              }
            ],
            "components": [
              {
                "kind": "callout",
                "id": "vision-guidance",
                "variant": "info",
                "title": "Use the right visual feature",
                "text": "Image Analysis extracts captions, dense captions, tags, objects, and Read OCR text from images. Document Intelligence is better for full document workflows; this lab uses lightweight image OCR for a label."
              },
              {
                "kind": "table",
                "id": "feature-table",
                "title": "Available Image Analysis features",
                "source": "features",
                "rowKey": "id",
                "columns": [
                  {
                    "key": "name",
                    "label": "Feature"
                  },
                  {
                    "key": "result",
                    "label": "Result"
                  },
                  {
                    "key": "useCase",
                    "label": "Use when"
                  }
                ]
              }
            ]
          },
          {
            "id": "image-playground",
            "title": "Image analysis playground",
            "subtitle": "Azure Vision",
            "icon": "Image",
            "url": "/explore/vision/image-analysis",
            "breadcrumb": [
              "Home",
              "Tools",
              "Azure Vision"
            ],
            "components": [
              {
                "kind": "table",
                "id": "sample-images",
                "title": "Sample images",
                "source": "sampleImages",
                "rowKey": "id",
                "variant": "cards",
                "columns": [
                  {
                    "key": "file",
                    "label": "File",
                    "format": "link"
                  },
                  {
                    "key": "description",
                    "label": "Description"
                  },
                  {
                    "key": "recommended",
                    "label": "Try features"
                  }
                ],
                "rowAction": {
                  "type": "select",
                  "as": "image",
                  "path": "sampleImages",
                  "key": "id",
                  "value": "{{$row.id}}"
                }
              },
              {
                "kind": "form",
                "id": "analysis-form",
                "title": "Analyze image",
                "description": "Choose a sample image and the visual features to run.",
                "fields": [
                  {
                    "id": "image",
                    "label": "Image",
                    "control": "select",
                    "required": true,
                    "optionsFrom": {
                      "path": "sampleImages",
                      "value": "id",
                      "label": "file"
                    }
                  },
                  {
                    "id": "features",
                    "label": "Visual features",
                    "control": "checkboxes",
                    "required": true,
                    "options": [
                      {
                        "value": "caption",
                        "label": "Caption"
                      },
                      {
                        "value": "denseCaptions",
                        "label": "Dense captions"
                      },
                      {
                        "value": "tags",
                        "label": "Tags"
                      },
                      {
                        "value": "objects",
                        "label": "Objects"
                      },
                      {
                        "value": "read",
                        "label": "Read (OCR)"
                      },
                      {
                        "value": "faces",
                        "label": "Face detection"
                      }
                    ],
                    "help": "Choose only features that match the business request. Face detection is intentionally out of scope."
                  },
                  {
                    "id": "notes",
                    "label": "Reviewer note",
                    "control": "textarea",
                    "placeholder": "Why did you select these features?"
                  }
                ],
                "submit": {
                  "label": "Run analysis",
                  "checks": [
                    {
                      "rule": {
                        "type": "not",
                        "rule": {
                          "type": "includes",
                          "path": "$form.features",
                          "value": "faces"
                        }
                      },
                      "message": "Do not use face detection for this proof of concept. The business requests can be completed with captions, tags, objects, and OCR."
                    },
                    {
                      "rule": {
                        "type": "anyOf",
                        "rules": [
                          {
                            "type": "textMinLength",
                            "path": "$form.notes",
                            "min": 12
                          },
                          {
                            "type": "includes",
                            "path": "$form.features",
                            "value": "read"
                          }
                        ]
                      },
                      "message": "Add a short reviewer note unless you are running OCR only."
                    }
                  ],
                  "actions": [
                    {
                      "type": "append",
                      "path": "analysisRuns",
                      "value": {
                        "image": "{{$form.image}}",
                        "features": "{{$form.features}}",
                        "notes": "{{$form.notes}}"
                      }
                    },
                    {
                      "type": "set",
                      "path": "analysis.lastImage",
                      "value": "{{$form.image}}"
                    },
                    {
                      "type": "set",
                      "path": "analysis.lastFeatures",
                      "value": "{{$form.features}}"
                    },
                    {
                      "type": "if",
                      "when": {
                        "type": "allOf",
                        "rules": [
                          {
                            "type": "equals",
                            "path": "$form.image",
                            "value": "store-aisle"
                          },
                          {
                            "type": "includes",
                            "path": "$form.features",
                            "value": "caption"
                          },
                          {
                            "type": "includes",
                            "path": "$form.features",
                            "value": "denseCaptions"
                          },
                          {
                            "type": "includes",
                            "path": "$form.features",
                            "value": "tags"
                          },
                          {
                            "type": "includes",
                            "path": "$form.features",
                            "value": "objects"
                          }
                        ]
                      },
                      "then": [
                        {
                          "type": "set",
                          "path": "outcomes.storeAnalysis",
                          "value": true
                        }
                      ]
                    },
                    {
                      "type": "if",
                      "when": {
                        "type": "allOf",
                        "rules": [
                          {
                            "type": "equals",
                            "path": "$form.image",
                            "value": "shipping-label"
                          },
                          {
                            "type": "includes",
                            "path": "$form.features",
                            "value": "read"
                          }
                        ]
                      },
                      "then": [
                        {
                          "type": "set",
                          "path": "outcomes.ocrAnalysis",
                          "value": true
                        }
                      ]
                    },
                    {
                      "type": "notify",
                      "title": "Analysis complete",
                      "message": "The image analysis playground returned simulated results.",
                      "tone": "success"
                    }
                  ],
                  "successMessage": "Image analysis results are ready."
                }
              },
              {
                "kind": "properties",
                "id": "caption-result",
                "title": "Latest caption and dense captions",
                "items": [
                  {
                    "label": "Caption",
                    "value": "A retail store aisle with bikes, helmets, and boxed accessories."
                  },
                  {
                    "label": "Dense caption 1",
                    "value": "A row of bicycles near a product display."
                  },
                  {
                    "label": "Dense caption 2",
                    "value": "A shelf with helmets and repair kits."
                  },
                  {
                    "label": "Tags",
                    "value": "bicycle, helmet, retail, shelf, product, indoor"
                  },
                  {
                    "label": "Objects",
                    "value": "bicycle (3), helmet (5), shelf (2), box (8)"
                  }
                ],
                "visibleWhen": {
                  "type": "equals",
                  "path": "analysis.lastImage",
                  "value": "store-aisle"
                }
              },
              {
                "kind": "table",
                "id": "ocr-results",
                "title": "Read OCR text result",
                "source": "ocrRows",
                "rowKey": "line",
                "columns": [
                  {
                    "key": "line",
                    "label": "Line"
                  },
                  {
                    "key": "text",
                    "label": "Detected text"
                  },
                  {
                    "key": "confidence",
                    "label": "Confidence",
                    "format": "badge"
                  }
                ],
                "visibleWhen": {
                  "type": "equals",
                  "path": "analysis.lastImage",
                  "value": "shipping-label"
                }
              },
              {
                "kind": "form",
                "id": "request-map",
                "title": "Choose the right feature for each request",
                "fields": [
                  {
                    "id": "catalogSearch",
                    "label": "Request A: Make product photos searchable by scene and concepts",
                    "control": "select",
                    "required": true,
                    "options": [
                      {
                        "value": "tags-and-captions",
                        "label": "Captions and tags"
                      },
                      {
                        "value": "read-ocr",
                        "label": "Read OCR"
                      },
                      {
                        "value": "objects",
                        "label": "Objects"
                      },
                      {
                        "value": "face-identification",
                        "label": "Face identification"
                      },
                      {
                        "value": "speech-to-text",
                        "label": "Speech to text"
                      }
                    ]
                  },
                  {
                    "id": "labelNumber",
                    "label": "Request B: Capture the tracking number printed on a shipping label",
                    "control": "select",
                    "required": true,
                    "options": [
                      {
                        "value": "tags-and-captions",
                        "label": "Captions and tags"
                      },
                      {
                        "value": "read-ocr",
                        "label": "Read OCR"
                      },
                      {
                        "value": "objects",
                        "label": "Objects"
                      },
                      {
                        "value": "face-identification",
                        "label": "Face identification"
                      },
                      {
                        "value": "speech-to-text",
                        "label": "Speech to text"
                      }
                    ]
                  },
                  {
                    "id": "shelfAudit",
                    "label": "Request C: Count visible products in shelf photos",
                    "control": "select",
                    "required": true,
                    "options": [
                      {
                        "value": "tags-and-captions",
                        "label": "Captions and tags"
                      },
                      {
                        "value": "read-ocr",
                        "label": "Read OCR"
                      },
                      {
                        "value": "objects",
                        "label": "Objects"
                      },
                      {
                        "value": "face-identification",
                        "label": "Face identification"
                      },
                      {
                        "value": "speech-to-text",
                        "label": "Speech to text"
                      }
                    ]
                  }
                ],
                "submit": {
                  "label": "Save choices",
                  "checks": [
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.catalogSearch",
                        "value": "tags-and-captions"
                      },
                      "message": "For searchable photo concepts, use captions, dense captions, and tags rather than OCR."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.labelNumber",
                        "value": "read-ocr"
                      },
                      "message": "Printed tracking numbers require Read OCR, not object detection."
                    },
                    {
                      "rule": {
                        "type": "equals",
                        "path": "$form.shelfAudit",
                        "value": "objects"
                      },
                      "message": "Counting visible products requires object detection results."
                    }
                  ],
                  "actions": [
                    {
                      "type": "set",
                      "path": "requestChoices",
                      "value": {
                        "catalogSearch": "{{$form.catalogSearch}}",
                        "labelNumber": "{{$form.labelNumber}}",
                        "shelfAudit": "{{$form.shelfAudit}}"
                      }
                    },
                    {
                      "type": "notify",
                      "title": "Feature choices saved",
                      "tone": "success"
                    }
                  ],
                  "successMessage": "Business request choices saved."
                }
              }
            ]
          },
          {
            "id": "responsible-settings",
            "title": "Responsible AI settings",
            "subtitle": "Project controls",
            "icon": "ShieldCheck",
            "url": "/build/projects/proj-retail-vision/settings/responsible-ai",
            "breadcrumb": [
              "Home",
              "Project settings"
            ],
            "components": [
              {
                "kind": "callout",
                "variant": "warning",
                "title": "Allowed use",
                "text": "The proof of concept is for products and labels. Do not identify people or infer sensitive traits from images."
              },
              {
                "kind": "settings",
                "id": "responsible-vision-settings",
                "title": "Allowed visual features",
                "fields": [
                  {
                    "id": "allow-image-analysis",
                    "label": "Allow Image Analysis features",
                    "control": "toggle",
                    "bindTo": "responsible.allowImageAnalysis"
                  },
                  {
                    "id": "allow-read",
                    "label": "Allow Read OCR for labels and receipts",
                    "control": "toggle",
                    "bindTo": "responsible.allowRead"
                  },
                  {
                    "id": "face-identification",
                    "label": "Allow face identification",
                    "control": "toggle",
                    "bindTo": "responsible.faceIdentification"
                  },
                  {
                    "id": "review-note",
                    "label": "Review note",
                    "control": "text",
                    "bindTo": "responsible.reviewNote",
                    "placeholder": "Explain why face identification is not used"
                  }
                ]
              }
            ]
          }
        ],
