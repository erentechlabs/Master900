{
  "labs": [
    {
      "slug": "extract-document-fields",
      "type": "UI_SIMULATION",
      "title": "Extract invoice fields with Content Understanding",
      "summary": "Use Microsoft Foundry Tools to analyze sample invoices, review confidence scores, correct a low-confidence field, and inspect exported JSON.",
      "scenario": "**Northwind Traders** receives supplier invoices by email and wants structured invoice data for review. In the simulated Microsoft Foundry portal, open **Tools**, choose **Content Understanding**, create an invoice extraction analyzer, analyze **northwind-invoice-1042.pdf**, review extracted fields and confidence scores, correct a low-confidence purchase order field, add the custom field **department**, and view the JSON result. The lab uses Azure Content Understanding in Foundry Tools because AI-901 now covers information extraction across documents, images, audio, and video.",
      "domainKey": "foundry-solutions",
      "moduleSlug": "foundry-vision-and-extraction",
      "objectiveCode": "2.4",
      "complexity": "BASIC",
      "estimatedMinutes": 35,
      "learningObjectives": [
        "Use Content Understanding in Foundry Tools for document information extraction",
        "Review extracted fields, confidence scores, and human corrections for a sample invoice",
        "Explain how field extraction differs from OCR, image analysis, speech, and translation"
      ],
      "prerequisites": [
        "Know that information extraction turns unstructured content into structured fields"
      ],
      "sources": [
        {
          "title": "Study guide for Exam AI-901",
          "url": "https://learn.microsoft.com/en-us/credentials/certifications/resources/study-guides/ai-901",
          "kind": "STUDY_GUIDE"
        },
        {
          "title": "What is Microsoft Foundry?",
          "url": "https://learn.microsoft.com/en-us/azure/foundry/what-is-foundry",
          "kind": "DOCUMENTATION"
        },
        {
          "title": "What is Azure Content Understanding in Foundry Tools?",
          "url": "https://learn.microsoft.com/en-us/azure/ai-services/content-understanding/overview",
          "kind": "DOCUMENTATION"
        },
        {
          "title": "Content Understanding Studio and Microsoft Foundry",
          "url": "https://learn.microsoft.com/en-us/azure/ai-services/content-understanding/foundry-vs-content-understanding-studio",
          "kind": "DOCUMENTATION"
        }
      ],
      "config": {
        "portal": {
          "name": "Microsoft Foundry",
          "theme": "foundry",
          "user": "alex@contoso.example",
          "tenant": "Contoso (contoso.example)",
          "url": "https://ai.azure.com",
          "searchPlaceholder": "Search Foundry"
        },
        "vm": {
          "name": "LAB-VM-01",
          "os": "windows",
          "apps": [
            "browser"
          ]
        },
