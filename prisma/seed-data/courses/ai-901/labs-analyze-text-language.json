      "steps": [
        {
          "key": "open-language",
          "title": "Open Azure Language",
          "instruction": "Open **Tools**, select **Azure Language**, and then select **Open Language playground**.",
          "hint": "Azure Language is listed under Foundry Tools for text workloads.",
          "explanation": "Azure Language in Foundry Tools provides natural language processing features for understanding and analyzing text.",
          "targetId": "tools-table",
          "rules": [
            {
              "key": "language-playground-opened",
              "description": "The Language playground was opened",
              "rule": {
                "type": "visited",
                "page": "language-playground"
              }
            }
          ]
        },
        {
          "key": "run-sentiment",
          "title": "Analyze sentiment and opinions",
          "instruction": "In **Analyze text**, choose **Customer reviews**, select **Sentiment analysis and opinion mining**, and select **Run**. Review **Sentiment and opinions**.",
          "hint": "Use sentiment analysis when the business asks whether text is positive, neutral, or negative.",
          "explanation": "Sentiment analysis classifies tone, while opinion mining connects a sentiment to a target such as a product part or support experience.",
          "targetId": "language-analysis-form",
          "rules": [
            {
              "key": "sentiment-complete",
              "description": "Customer reviews were analyzed with sentiment and opinion mining",
              "rule": {
                "type": "equals",
                "path": "outcomes.sentiment",
                "value": true
              }
            }
          ]
        },
        {
          "key": "extract-phrases-entities",
          "title": "Extract phrases and entities",
